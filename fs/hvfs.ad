# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 David Hamner
# HackOS -- the file layer: descriptors, paths, mounts, device files.
#
# This is new HackOS code, not a port of Hamnix's fs/vfs.ad.  That file cannot
# be lifted: its descriptors live in Hamnix's task structure, every open goes
# through the Plan 9 channel layer (namec.ad/chan.ad), and its read and write
# paths never call tmpfs directly (see the milestone-2 report for the
# analysis).  What IS Hamnix's, unmodified, sits underneath:
#     fs/tmpfs.ad      the RAM file system
#     fs/vfs_mount.ad  the mount table (longest-prefix routing)
# and the behaviour seen by programs follows Hamnix's native interface:
# open(path) is read-only, open_write(path) creates or truncates, a directory
# opened for reading yields "NAME\n" lines, stat returns a 9P stat record,
# errors are negative errno values plus a per-thread error string.
#
# Mounts:  "/"     tmpfs.  Hamnix's tmpfs only serves a fixed set of top-level
#                  names, so HackOS keeps its whole tree under the tmpfs root
#                  named "root": the HackOS path /a/b is the tmpfs path
#                  /root/a/b.  The tmpfs file stays unmodified this way.
#          "/dev"  device files: console (the UART), null, zero.
#          "/bin"  the programs built into the kernel image, read-only and
#                  read in place (arch/armv7m/romfs.S is generated by the
#                  build): no RAM is spent on keeping them.
#          "/fd"   the /fd names of the calling process (see below).
#          "/sd"   a FAT32 volume on block device "ram0", if one is there
#                  (Hamnix's fs/fat.ad, unmodified, over kernel/block/blk.ad).
#                  Files can be read, created, overwritten, appended to and
#                  removed; long names can be read, new names must be 8.3
#                  (what Hamnix's write path supports); no mkdir, no rename,
#                  and a redirection cannot target it yet.
#
# /fd names.  This is the one piece of Hamnix's namespace model HackOS has,
# because Hamnix's shell wires every pipe and redirection with it: each
# process has sixteen names /fd/0../fd/15, and each name is bound to a
# console, one end of a pipe, a file, or nothing (vfs_fdbind).  A descriptor
# opened on "/fd/N" does not point at a file: every read and write looks up
# what N is bound to in the CALLING process at that moment, so a parent can
# rebind a child's standard streams after the child exists.  The bindings
# are copied to a child with the pipe references counted, and dropped when
# the process ends, which is what delivers end-of-file and EPIPE.  There is
# no bind/mount, no per-process mount table and no union directory.
#
# Locking: one mutex (fs_lock) serialises everything that touches tmpfs or the
# tables here; tmpfs itself assumes Hamnix's cooperative scheduling.  Device
# reads and writes run outside the lock because the console may block.
#
# Descriptors and /fd names are per thread, which means per process (a
# process is one thread); a new thread gets copies of its creator's.

from board.board import board_storage_init
from kernel.sched.core import Thread, thr, threads, current_thread, thread_by_tid, sched_current, set_current_errstr, sched_exit_hook, sched_exit_hook_set, sched_spawn_hook, sched_spawn_hook_set, T_UNUSED, THREAD_MAX, TF_PROC, PF_VFORK
from kernel.sync import Mutex, mutex_init, mutex_register, mutex_lock, mutex_unlock, memcpy, memset, spinlock_lock, spinlock_unlock
from kernel.rt import rt_memcpy, rt_memset
from mm.slab import kmalloc, kfree
from drivers.tty.console import console_read, console_write
from fs.vfs_mount import vfs_mount, vfs_umount, vfs_fs_kind, vfs_fs_rel, FS_KIND_TMPFS, FS_KIND_DEVFS, FS_KIND_CPIO, FS_KIND_PROCFS, FS_KIND_FAT
from fs.fat import fat_init, fat_lookup, fat_read, fat_listdir, fat_create, fat_write, fat_delete
from kernel.block.blk import blk_init
from kernel.pipe import pipe_init, pipe_alloc_chan, pipe_valid, pipe_inc_reader, pipe_inc_writer, pipe_close_reader, pipe_close_writer, pipe_read, pipe_write, pipe_release_unbound
from fs.tmpfs import tmpfs_lookup, tmpfs_open_for_write_t, tmpfs_read, tmpfs_write, tmpfs_size, tmpfs_ftruncate, tmpfs_unlink, tmpfs_rename, tmpfs_mkdir, tmpfs_listdir, tmpfs_path_is_dir, tmpfs_path_exists, tmpfs_mtime, tmpfs_is_dir, tmpfs_table, TmpfsEntry, TMPFS_MAX_FILES

# errno values (Linux numbering, as Hamnix returns them)
ENOENT: int32 = -2
EBADF: int32 = -9
ENOMEM: int32 = -12
EFAULT: int32 = -14
EBUSY: int32 = -16
EEXIST: int32 = -17
ENOTDIR: int32 = -20
EISDIR: int32 = -21
EINVAL: int32 = -22
EMFILE: int32 = -24
ENOSPC: int32 = -28
ESPIPE: int32 = -29
ESRCH: int32 = -3
EROFS: int32 = -30
ERANGE: int32 = -34
ENAMETOOLONG: int32 = -36
ENOSYS: int32 = -38
ENOTEMPTY: int32 = -39
EPERM: int32 = -1

# open modes (Plan 9 values, as documented for Hamnix)
OREAD: uint32 = 0
OWRITE: uint32 = 1
ORDWR: uint32 = 2
OTRUNC: uint32 = 16
OAPPEND: uint32 = 128
OCREATE: uint32 = 0x1000            # HackOS-internal: create if missing

SEEK_SET: uint32 = 0
SEEK_CUR: uint32 = 1
SEEK_END: uint32 = 2

OF_FILE: uint32 = 1
OF_DIR: uint32 = 2
OF_DEV: uint32 = 3
OF_ROM: uint32 = 4                  # a file of /bin; slot = index into the ROM table
OF_FDNAME: uint32 = 5               # "/fd/N"; slot = N, resolved at every read and write
OF_FAT: uint32 = 6                  # a file on /sd open for reading: aux0 = first cluster, aux1 = size
OF_FATW: uint32 = 7                 # ... open for writing: dirbuf = its path on the volume, aux1 = size

FS_KIND_ROM: uint32 = 1             # = FS_KIND_CPIO, "read-only baked root" in Hamnix's table
FS_KIND_FD: uint32 = 2              # = FS_KIND_PROCFS, names served by the kernel

# What an /fd name is bound to (Hamnix's DEVFD_* values).
DEVFD_NONE: int32 = 0
DEVFD_CONS: int32 = 1               # the console
DEVFD_PIPE_R: int32 = 2             # read end of pipe slot `arg`
DEVFD_PIPE_W: int32 = 3             # write end of pipe slot `arg`
DEVFD_FILE: int32 = 4               # tmpfs slot `arg`, own position
DEVFD_DUP: int32 = 5                # bind request only: copy the binding of /fd/<arg>
DEVFD_FILE_APPEND: int32 = 6        # tmpfs slot `arg`, every write at the end
DEVFD_CHAN: int32 = 7               # a device or ROM file, `arg` from vfs_openchan
DEVFD_SLOTS: uint32 = 16
# vfs_openchan results at or above this value are not tmpfs slots:
# CHAN_INLINE_TAG | CHAN_DEV | device, or CHAN_INLINE_TAG | CHAN_ROM | index.
CHAN_INLINE_TAG: int32 = 0x40000000
CHAN_DEV: int32 = 0x10000
CHAN_ROM: int32 = 0x20000

# The ROM table (generated: build/romfs.S): `romfs_count` entries of
# {name address, data address, size, 0}, 32-bit words.
extern def romfs_table()
extern def romfs_count()

DEV_CONSOLE: int32 = 1
DEV_NULL: int32 = 2
DEV_ZERO: int32 = 3

VFS_NR_FDS: uint32 = 16             # per thread (Hamnix: 64 per task)
VFS_NR_OPEN: uint32 = 64            # system-wide open files
VFS_PATH_MAX: uint32 = 256
VFS_DIRBUF: uint64 = 8192

QTDIR: uint32 = 0x80
DMDIR: uint32 = 0x80000000
DMDEVICE: uint32 = 0x00800000


class OpenFile:
    refs: uint32                    # descriptors referring to this entry
    kind: uint32
    slot: int32                     # tmpfs slot, or device number
    mode: uint32
    pos: uint64
    dirbuf: uint64                  # OF_DIR: snapshot of the listing (freed at close)
    dirlen: uint64
    aux0: uint64
    aux1: uint64


ofiles: Array[64, OpenFile]
fs_lock: Mutex
vfs_ready: uint32 = 0
fat_mounted: uint32 = 0


def _pc(p: Ptr[uint8]) -> Ptr[char]:
    return cast[Ptr[char]](p)


def _err(code: int32, msg: Ptr[uint8]) -> int32:
    set_current_errstr(msg)
    return code


def _slen(s: Ptr[uint8]) -> uint32:
    n: uint32 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _seq(a: Ptr[uint8], b: Ptr[uint8]) -> uint32:
    i: uint32 = 0
    while a[i] != 0 and a[i] == b[i]:
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


# Make `path` absolute (against the thread's working directory) and canonical:
# no ".", "..", doubled or trailing slashes.  out holds VFS_PATH_MAX bytes.
def vfs_canon(path: Ptr[uint8], out: Ptr[uint8]) -> int32:
    tmp: Array[400, uint8]
    n: uint32 = 0
    if path[0] != 47:
        cwd: Ptr[uint8] = &current_thread()[0].cwd[0]
        while cwd[n] != 0:
            tmp[n] = cwd[n]
            n = n + 1
        tmp[n] = 47
        n = n + 1
    i: uint32 = 0
    while path[i] != 0:
        if n >= 398:
            return ENAMETOOLONG
        tmp[n] = path[i]
        n = n + 1
        i = i + 1
    tmp[n] = 0
    o: uint32 = 0
    i = 0
    while tmp[i] != 0:
        while tmp[i] == 47:
            i = i + 1
        if tmp[i] == 0:
            break
        st: uint32 = i
        while tmp[i] != 0 and tmp[i] != 47:
            i = i + 1
        ln: uint32 = i - st
        if ln == 1 and tmp[st] == 46:
            continue
        if ln == 2 and tmp[st] == 46 and tmp[st + 1] == 46:
            while o > 0 and out[o - 1] != 47:
                o = o - 1
            if o > 0:
                o = o - 1
            continue
        if o + ln + 2 > VFS_PATH_MAX:
            return ENAMETOOLONG
        out[o] = 47
        o = o + 1
        k: uint32 = 0
        while k < ln:
            out[o] = tmp[st + k]
            o = o + 1
            k = k + 1
    if o == 0:
        out[0] = 47
        o = 1
    out[o] = 0
    return 0


# HackOS canonical path -> tmpfs key ("/root" + path).  out: VFS_PATH_MAX + 8.
def _tkey(canon: Ptr[uint8], out: Ptr[uint8]):
    out[0] = 47
    out[1] = 114
    out[2] = 111
    out[3] = 111
    out[4] = 116
    n: uint32 = 5
    if canon[1] != 0:
        i: uint32 = 0
        while canon[i] != 0:
            out[n] = canon[i]
            n = n + 1
            i = i + 1
    out[n] = 0


# Does the directory that would hold tmpfs key `tk` exist?
def _parent_is_dir(tk: Ptr[uint8]) -> uint32:
    par: Array[272, uint8]
    n: uint32 = _slen(tk)
    while n > 0 and tk[n - 1] != 47:
        n = n - 1
    if n <= 1:
        return 0
    i: uint32 = 0
    while i + 1 < n:
        par[i] = tk[i]
        i = i + 1
    par[i] = 0
    if tmpfs_path_is_dir(_pc(&par[0])) != 0:
        return 1
    return 0


def _dev_lookup(rel: Ptr[uint8]) -> int32:
    if _seq(rel, "/console") != 0 or _seq(rel, "/cons") != 0:
        return DEV_CONSOLE
    if _seq(rel, "/null") != 0:
        return DEV_NULL
    if _seq(rel, "/zero") != 0:
        return DEV_ZERO
    return 0


# ---------------------------------------------------------------- /bin (ROM)
def rom_count() -> uint32:
    return cast[Ptr[uint32]](cast[uint64](&romfs_count))[0]


def _rom_word(i: uint32, w: uint32) -> uint32:
    return cast[Ptr[uint32]](cast[uint64](&romfs_table))[i * 4 + w]


def rom_name(i: uint32) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](_rom_word(i, 0)))


def rom_data(i: uint32) -> uint64:
    return cast[uint64](_rom_word(i, 1))


def rom_size(i: uint32) -> uint64:
    return cast[uint64](_rom_word(i, 2))


# rel is "/name"; returns the index or -1.
def _rom_lookup(rel: Ptr[uint8]) -> int32:
    if rel[0] != 47:
        return -1
    name: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](rel) + 1)
    i: uint32 = 0
    while i < rom_count():
        if _seq(name, rom_name(i)) != 0:
            return cast[int32](i)
        i = i + 1
    return -1


def _rom_read(idx: int32, buf: Ptr[uint8], pos: uint64, n: uint64) -> uint64:
    size: uint64 = rom_size(cast[uint32](idx))
    if pos >= size:
        return 0
    if n > size - pos:
        n = size - pos
    rt_memcpy(cast[uint64](buf), rom_data(cast[uint32](idx)) + pos, n)
    return n


def _fd_file(fd: int32) -> Ptr[OpenFile]:
    if fd < 0 or fd >= cast[int32](VFS_NR_FDS):
        return cast[Ptr[OpenFile]](0)
    idx: int32 = current_thread()[0].fd[fd]
    if idx < 0:
        return cast[Ptr[OpenFile]](0)
    return &ofiles[idx]


# Bind a new OpenFile to the lowest free descriptor of the current thread.
# fs_lock held.  Returns the descriptor or EMFILE.
def _install(kind: uint32, slot: int32, mode: uint32, dirbuf: uint64, dirlen: uint64) -> int32:
    t: Ptr[Thread] = current_thread()
    fd: int32 = 0
    while fd < cast[int32](VFS_NR_FDS) and t[0].fd[fd] >= 0:
        fd = fd + 1
    i: int32 = 0
    while i < cast[int32](VFS_NR_OPEN) and ofiles[i].refs != 0:
        i = i + 1
    if fd == cast[int32](VFS_NR_FDS) or i == cast[int32](VFS_NR_OPEN):
        return _err(EMFILE, "too many open files")
    ofiles[i].refs = 1
    ofiles[i].kind = kind
    ofiles[i].slot = slot
    ofiles[i].mode = mode
    ofiles[i].pos = 0
    ofiles[i].dirbuf = dirbuf
    ofiles[i].dirlen = dirlen
    t[0].fd[fd] = i
    return fd


# Is tmpfs slot `slot` open through a descriptor, or bound at an /fd name of
# any process?
def _slot_is_open(slot: int32) -> uint32:
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        if ofiles[i].refs != 0 and ofiles[i].kind == OF_FILE and ofiles[i].slot == slot:
            return 1
        i = i + 1
    i = 0
    while i < THREAD_MAX:
        if threads[i].state != T_UNUSED:
            k: uint32 = 0
            while k < DEVFD_SLOTS:
                if (threads[i].fdn_kind[k] == DEVFD_FILE or threads[i].fdn_kind[k] == DEVFD_FILE_APPEND) and threads[i].fdn_arg[k] == slot:
                    return 1
                k = k + 1
        i = i + 1
    return 0


def _put_dec(buf: Ptr[uint8], off: uint32, v: uint32) -> uint32:
    if v >= 10:
        buf[off] = cast[uint8](48 + v / 10)
        off = off + 1
    buf[off] = cast[uint8](48 + v % 10)
    return off + 1


# ---------------------------------------------------------------- /sd (FAT)
# rel is the path on the volume without a leading slash ("" = its root).
def _fat_is_dir(rel: Ptr[uint8]) -> uint32:
    probe: Array[8, uint8]
    if fat_listdir(_pc(rel), &probe[0], 8) >= 0:
        return 1
    return 0


def _fat_open(rel: Ptr[uint8], mode: uint32, wants_write: uint32) -> int32:
    if fat_mounted == 0:
        return _err(ENOENT, "no FAT volume")
    if _fat_is_dir(rel) != 0:
        if wants_write != 0:
            return _err(EISDIR, "is a directory")
        buf: uint64 = kmalloc(VFS_DIRBUF)
        if buf == 0:
            return _err(ENOMEM, "out of memory")
        n: int64 = fat_listdir(_pc(rel), cast[Ptr[uint8]](buf), VFS_DIRBUF)
        if n < 0:
            n = 0
        fdd: int32 = _install(OF_DIR, 0, OREAD, buf, cast[uint64](n))
        if fdd < 0:
            kfree(buf)
        return fdd
    cluster: uint64 = 0
    size: uint64 = 0
    found: int32 = fat_lookup(_pc(rel), &cluster, &size)
    if wants_write == 0:
        if found == 0:
            return _err(ENOENT, "file does not exist")
        fd: int32 = _install(OF_FAT, 0, OREAD, 0, 0)
        if fd >= 0:
            f: Ptr[OpenFile] = _fd_file(fd)
            f[0].aux0 = cluster
            f[0].aux1 = size
        return fd
    if (mode & 3) == ORDWR:
        return _err(EINVAL, "FAT: a file is open for reading or for writing, not both")
    if found == 0 and (mode & OCREATE) == 0:
        return _err(ENOENT, "file does not exist")
    if found == 0 or (mode & OTRUNC) != 0:
        if fat_create(_pc(rel)) != 0:
            return _err(EINVAL, "FAT: cannot create the file (new names must be 8.3; is the directory there, is the volume full?)")
        size = 0
    ln: uint32 = _slen(rel)
    pcopy: uint64 = kmalloc(cast[uint64](ln) + 1)
    if pcopy == 0:
        return _err(ENOMEM, "out of memory")
    rt_memcpy(pcopy, cast[uint64](rel), cast[uint64](ln) + 1)
    fdw: int32 = _install(OF_FATW, 0, mode & (3 | OAPPEND), pcopy, 0)
    if fdw < 0:
        kfree(pcopy)
        return fdw
    fw: Ptr[OpenFile] = _fd_file(fdw)
    fw[0].aux1 = size
    if (mode & OAPPEND) != 0:
        fw[0].pos = size
    return fdw


# Mount the FAT32 volume on block device "ram0" at /sd, if there is one.
# Returns 1 when mounted.
def vfs_fat_mount() -> uint32:
    slot: int32 = board_storage_init()
    if slot < 0:
        return 0
    if fat_init(slot) != 0:
        return 0
    # fat_init registers Hamnix's mount point, /mnt; HackOS wants /sd
    hm: int32 = vfs_mount("/mnt", FS_KIND_FAT, 5, 0)
    if hm >= 0:
        vfs_umount(hm)
    vfs_mount("/sd", FS_KIND_FAT, 4, 0)
    tmpfs_mkdir("/root/sd")
    fat_mounted = 1
    return 1


# "/N" with N in 0..15 -> N, else -1.
def _fdname_number(rel: Ptr[uint8]) -> int32:
    if rel[0] != 47 or rel[1] < 48 or rel[1] > 57:
        return -1
    n: int32 = cast[int32](rel[1]) - 48
    if rel[2] != 0:
        if rel[2] < 48 or rel[2] > 57 or rel[3] != 0:
            return -1
        n = n * 10 + cast[int32](rel[2]) - 48
    if n >= cast[int32](DEVFD_SLOTS):
        return -1
    return n


def _open_locked(canon: Ptr[uint8], mode: uint32) -> int32:
    kind: uint32 = vfs_fs_kind(_pc(canon))
    wants_write: uint32 = 0
    if (mode & 3) != OREAD or (mode & (OTRUNC | OCREATE | OAPPEND)) != 0:
        wants_write = 1
    if kind == FS_KIND_DEVFS:
        rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rel[0] == 0:
            if wants_write != 0:
                return _err(EISDIR, "is a directory")
            db: uint64 = kmalloc(32)
            if db == 0:
                return _err(ENOMEM, "out of memory")
            lst: Ptr[uint8] = "console\nnull\nzero\n"
            rt_memcpy(db, cast[uint64](lst), 18)
            fdd: int32 = _install(OF_DIR, 0, OREAD, db, 18)
            if fdd < 0:
                kfree(db)
            return fdd
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return _err(ENOENT, "file does not exist")
        return _install(OF_DEV, dev, mode & 3, 0, 0)
    if kind == FS_KIND_ROM:
        rrel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rrel[0] == 0:
            if wants_write != 0:
                return _err(EISDIR, "is a directory")
            rb: uint64 = kmalloc(VFS_DIRBUF)
            if rb == 0:
                return _err(ENOMEM, "out of memory")
            ro: uint64 = 0
            ri: uint32 = 0
            while ri < rom_count():
                rn: Ptr[uint8] = rom_name(ri)
                rl: uint64 = cast[uint64](_slen(rn))
                if ro + rl + 1 <= VFS_DIRBUF:
                    rt_memcpy(rb + ro, cast[uint64](rn), rl)
                    cast[Ptr[uint8]](rb + ro + rl)[0] = 10
                    ro = ro + rl + 1
                ri = ri + 1
            fdr: int32 = _install(OF_DIR, 0, OREAD, rb, ro)
            if fdr < 0:
                kfree(rb)
            return fdr
        ridx: int32 = _rom_lookup(rrel)
        if ridx < 0:
            return _err(ENOENT, "file does not exist")
        if wants_write != 0:
            return _err(EROFS, "read-only file system")
        return _install(OF_ROM, ridx, OREAD, 0, 0)
    if kind == FS_KIND_FD:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if frel[0] == 0:
            if wants_write != 0:
                return _err(EISDIR, "is a directory")
            fb: uint64 = kmalloc(64)
            if fb == 0:
                return _err(ENOMEM, "out of memory")
            fo: uint32 = 0
            fi: uint32 = 0
            while fi < DEVFD_SLOTS:
                if current_thread()[0].fdn_kind[fi] != DEVFD_NONE:
                    fo = _put_dec(cast[Ptr[uint8]](fb), fo, fi)
                    cast[Ptr[uint8]](fb)[fo] = 10
                    fo = fo + 1
                fi = fi + 1
            fdf: int32 = _install(OF_DIR, 0, OREAD, fb, cast[uint64](fo))
            if fdf < 0:
                kfree(fb)
            return fdf
        fn: int32 = _fdname_number(frel)
        if fn < 0:
            return _err(ENOENT, "file does not exist")
        return _install(OF_FDNAME, fn, mode & 3, 0, 0)
    if kind == FS_KIND_FAT:
        return _fat_open(cast[Ptr[uint8]](vfs_fs_rel(_pc(canon))), mode, wants_write)
    tk: Array[272, uint8]
    _tkey(canon, &tk[0])
    if tmpfs_path_is_dir(_pc(&tk[0])) != 0:
        if wants_write != 0:
            return _err(EISDIR, "is a directory")
        buf: uint64 = kmalloc(VFS_DIRBUF)
        if buf == 0:
            return _err(ENOMEM, "out of memory")
        n: int64 = tmpfs_listdir(_pc(&tk[0]), cast[Ptr[uint8]](buf), VFS_DIRBUF)
        if n < 0:
            kfree(buf)
            return _err(cast[int32](n), "cannot list directory")
        fd2: int32 = _install(OF_DIR, 0, OREAD, buf, cast[uint64](n))
        if fd2 < 0:
            kfree(buf)
        return fd2
    slot: int32 = tmpfs_lookup(_pc(&tk[0]))
    if slot < 0:
        if (mode & OCREATE) == 0:
            return _err(ENOENT, "file does not exist")
        if _parent_is_dir(&tk[0]) == 0:
            return _err(ENOENT, "directory does not exist")
        slot = tmpfs_open_for_write_t(_pc(&tk[0]), 1)
        if slot < 0:
            return _err(slot, "cannot create file")
    elif (mode & OTRUNC) != 0:
        slot = tmpfs_open_for_write_t(_pc(&tk[0]), 1)
        if slot < 0:
            return _err(slot, "cannot truncate file")
    return _install(OF_FILE, slot, mode & (3 | OAPPEND), 0, 0)


def vfs_open(path: Ptr[uint8], mode: uint32) -> int32:
    canon: Array[256, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return _err(rc, "path too long")
    mutex_lock(&fs_lock)
    fd: int32 = _open_locked(&canon[0], mode)
    mutex_unlock(&fs_lock)
    return fd


def _close_index(idx: int32):
    ofiles[idx].refs = ofiles[idx].refs - 1
    if ofiles[idx].refs == 0:
        if ofiles[idx].dirbuf != 0:
            kfree(ofiles[idx].dirbuf)
            ofiles[idx].dirbuf = 0
        ofiles[idx].kind = 0


def vfs_close(fd: int32) -> int32:
    if fd < 0 or fd >= cast[int32](VFS_NR_FDS):
        return _err(EBADF, "close: bad fd")
    t: Ptr[Thread] = current_thread()
    mutex_lock(&fs_lock)
    idx: int32 = t[0].fd[fd]
    if idx < 0:
        mutex_unlock(&fs_lock)
        return _err(EBADF, "close: bad fd")
    t[0].fd[fd] = -1
    _close_index(idx)
    mutex_unlock(&fs_lock)
    return 0


# ---------------------------------------------------------------- /fd names
# Read through /fd/<fdn> of the calling process.  fs_lock not held.
def _fdn_read(fdn: int32, buf: Ptr[uint8], n: uint64, nonblock: uint32) -> int64:
    t: Ptr[Thread] = current_thread()
    kind: int32 = t[0].fdn_kind[fdn]
    arg: int32 = t[0].fdn_arg[fdn]
    if kind == DEVFD_CONS:
        return console_read(buf, n, nonblock)
    if kind == DEVFD_PIPE_R:
        return pipe_read(arg, buf, n, nonblock)
    got: uint64 = 0
    if kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        mutex_lock(&fs_lock)
        got = tmpfs_read(arg, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + got
        mutex_unlock(&fs_lock)
    elif kind == DEVFD_CHAN and (arg & CHAN_ROM) != 0:
        got = _rom_read(arg & 0xFFFF, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + got
    elif kind == DEVFD_CHAN and (arg & 0xFFFF) == DEV_CONSOLE:
        return console_read(buf, n, nonblock)
    elif kind == DEVFD_CHAN and (arg & 0xFFFF) == DEV_ZERO:
        rt_memset(cast[uint64](buf), 0, n)
        return cast[int64](n)
    elif kind != DEVFD_CHAN:
        return cast[int64](_err(EBADF, "read: nothing readable is bound at this /fd name"))
    if got == 0 and nonblock != 0:
        return -1
    return cast[int64](got)


def _fdn_write(fdn: int32, buf: Ptr[uint8], n: uint64) -> int64:
    t: Ptr[Thread] = current_thread()
    kind: int32 = t[0].fdn_kind[fdn]
    arg: int32 = t[0].fdn_arg[fdn]
    if kind == DEVFD_CONS:
        console_write(buf, n)
        return cast[int64](n)
    if kind == DEVFD_PIPE_W:
        # A child of rfork that has not exec'ed runs while its parent is
        # suspended; if the parent is the one who would start the reader, a
        # full pipe would never drain.  Such a writer is not put to sleep.
        nb: uint32 = 0
        if (t[0].pflags & PF_VFORK) != 0:
            nb = 1
        r: int64 = pipe_write(arg, buf, n, nb)
        if r == -11:
            set_current_errstr("pipe full: a stage that runs inside the shell cannot write more than the pipe holds")
        elif r == -32:
            set_current_errstr("write: pipe has no reader")
        return r
    if kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        mutex_lock(&fs_lock)
        if kind == DEVFD_FILE_APPEND:
            t[0].fdn_pos[fdn] = tmpfs_size(arg)
        w: uint64 = tmpfs_write(arg, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + w
        mutex_unlock(&fs_lock)
        if w == 0 and n != 0:
            return cast[int64](_err(ENOSPC, "tmpfs: no space"))
        return cast[int64](w)
    if kind == DEVFD_CHAN and (arg & CHAN_DEV) != 0:
        if (arg & 0xFFFF) == DEV_CONSOLE:
            console_write(buf, n)
        return cast[int64](n)
    return cast[int64](_err(EBADF, "write: nothing writable is bound at this /fd name"))


# Is descriptor `fd` of the caller a pipe end right now?
def vfs_fd_is_pipe(fd: int32) -> uint32:
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0) or f[0].kind != OF_FDNAME:
        return 0
    k: int32 = current_thread()[0].fdn_kind[f[0].slot]
    if k == DEVFD_PIPE_R or k == DEVFD_PIPE_W:
        return 1
    return 0


# Drop what /fd/<n> of `t` is bound to.
def _fdn_release(t: Ptr[Thread], n: uint32):
    kind: int32 = t[0].fdn_kind[n]
    arg: int32 = t[0].fdn_arg[n]
    t[0].fdn_kind[n] = DEVFD_NONE
    t[0].fdn_arg[n] = 0
    t[0].fdn_pos[n] = 0
    if kind == DEVFD_PIPE_R:
        pipe_close_reader(arg)
    elif kind == DEVFD_PIPE_W:
        pipe_close_writer(arg)


# Bind /fd/<fdnum> of process `pid` (0 = the caller).  The caller may bind
# its own names and those of its children.  kind is a DEVFD_* value.
def vfs_fdbind(pid: int32, fdnum: int32, kind: int32, arg: int32) -> int32:
    me: Ptr[Thread] = current_thread()
    t: Ptr[Thread] = me
    if fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return _err(EINVAL, "fdbind: no such /fd name")
    if pid != 0 and cast[uint32](pid) != me[0].tid:
        t = thread_by_tid(cast[uint32](pid))
        if t == cast[Ptr[Thread]](0) or t[0].ppid != me[0].tid:
            return _err(ESRCH, "fdbind: not a child of the caller")
    n: uint32 = cast[uint32](fdnum)
    pos: uint64 = 0
    if kind == DEVFD_DUP:
        if arg < 0 or arg >= cast[int32](DEVFD_SLOTS):
            return _err(EINVAL, "fdbind: no such /fd name to duplicate")
        if arg == fdnum:
            return 0
        kind = t[0].fdn_kind[arg]
        pos = t[0].fdn_pos[arg]
        arg = t[0].fdn_arg[arg]
        if kind == DEVFD_NONE:
            return _err(EBADF, "fdbind: nothing is bound at the name to duplicate")
    if kind == DEVFD_PIPE_R or kind == DEVFD_PIPE_W:
        if pipe_valid(arg) == 0:
            return _err(EBADF, "fdbind: no such pipe")
    elif kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        if arg < 0 or arg >= cast[int32](TMPFS_MAX_FILES) or tmpfs_table[arg].used == 0 or tmpfs_is_dir(arg) != 0:
            return _err(EBADF, "fdbind: not an open file channel")
    elif kind == DEVFD_CHAN:
        # exactly the values vfs_openchan hands out, nothing a caller made up
        cok: uint32 = 0
        if (arg & (CHAN_INLINE_TAG | CHAN_DEV | CHAN_ROM | 0xFFFF)) == arg and (arg & CHAN_INLINE_TAG) != 0:
            idx: int32 = arg & 0xFFFF
            if (arg & CHAN_DEV) != 0 and (arg & CHAN_ROM) == 0 and idx >= DEV_CONSOLE and idx <= DEV_ZERO:
                cok = 1
            if (arg & CHAN_ROM) != 0 and (arg & CHAN_DEV) == 0 and cast[uint32](idx) < rom_count():
                cok = 1
        if cok == 0:
            return _err(EBADF, "fdbind: not a device channel")
    elif kind != DEVFD_CONS and kind != DEVFD_NONE:
        return _err(EINVAL, "fdbind: unknown kind")
    # take the new reference before dropping the old one: rebinding the same
    # pipe end must not let its count touch zero
    if kind == DEVFD_PIPE_R:
        pipe_inc_reader(arg)
    elif kind == DEVFD_PIPE_W:
        pipe_inc_writer(arg)
    _fdn_release(t, n)
    t[0].fdn_kind[n] = kind
    t[0].fdn_arg[n] = arg
    t[0].fdn_pos[n] = pos
    return 0


def _fdn_target(pid: int32) -> Ptr[Thread]:
    if pid == 0:
        return current_thread()
    return thread_by_tid(cast[uint32](pid))


def vfs_fdslot_kind(pid: int32, fdnum: int32) -> int32:
    t: Ptr[Thread] = _fdn_target(pid)
    if t == cast[Ptr[Thread]](0) or fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return DEVFD_NONE
    return t[0].fdn_kind[fdnum]


def vfs_fdslot_arg(pid: int32, fdnum: int32) -> int32:
    t: Ptr[Thread] = _fdn_target(pid)
    if t == cast[Ptr[Thread]](0) or fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return 0
    return t[0].fdn_arg[fdnum]


def vfs_pipechan() -> int32:
    slot: int32 = pipe_alloc_chan(current_thread()[0].tid)
    if slot < 0:
        return _err(EMFILE, "out of pipes or memory")
    return slot


# Open `path` as a channel that can be bound at an /fd name (a redirection).
# mode 0: an existing file, for reading; 1: create or truncate; 2: create if
# missing, keep the contents (for appending).  Returns a tmpfs slot, or a
# value with CHAN_INLINE_TAG for a device or a ROM file.
def vfs_openchan(path: Ptr[uint8], mode: int32) -> int32:
    canon: Array[256, uint8]
    tk: Array[272, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return _err(rc, "path too long")
    kind: uint32 = vfs_fs_kind(_pc(&canon[0]))
    rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
    if kind == FS_KIND_DEVFS:
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return _err(ENOENT, "file does not exist")
        return CHAN_INLINE_TAG | CHAN_DEV | dev
    if kind == FS_KIND_ROM:
        idx: int32 = _rom_lookup(rel)
        if idx < 0:
            return _err(ENOENT, "file does not exist")
        if mode != 0:
            return _err(EROFS, "read-only file system")
        return CHAN_INLINE_TAG | CHAN_ROM | idx
    if kind != FS_KIND_TMPFS:
        return _err(EINVAL, "cannot redirect to this kind of file")
    _tkey(&canon[0], &tk[0])
    mutex_lock(&fs_lock)
    slot: int32 = tmpfs_lookup(_pc(&tk[0]))
    if tmpfs_path_is_dir(_pc(&tk[0])) != 0:
        slot = _err(EISDIR, "is a directory")
    elif slot < 0:
        if mode == 0:
            slot = _err(ENOENT, "file does not exist")
        elif _parent_is_dir(&tk[0]) == 0:
            slot = _err(ENOENT, "directory does not exist")
        else:
            slot = tmpfs_open_for_write_t(_pc(&tk[0]), 1)
            if slot < 0:
                slot = _err(slot, "cannot create file")
    elif mode == 1:
        slot = tmpfs_open_for_write_t(_pc(&tk[0]), 1)
        if slot < 0:
            slot = _err(slot, "cannot truncate file")
    mutex_unlock(&fs_lock)
    return slot


def vfs_read(fd: int32, buf: Ptr[uint8], n: uint64, nonblock: uint32) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: bad fd"))
    if f[0].kind == OF_DEV:
        dev: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        if dev == DEV_CONSOLE:
            return console_read(buf, n, nonblock)
        if dev == DEV_ZERO:
            rt_memset(cast[uint64](buf), 0, n)
            return cast[int64](n)
        if nonblock != 0:
            return -1
        return 0
    if f[0].kind == OF_FDNAME:
        fdn: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        return _fdn_read(fdn, buf, n, nonblock)
    if (f[0].mode & 3) == OWRITE:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: not open for reading"))
    got: uint64 = 0
    if f[0].kind == OF_ROM:
        got = _rom_read(f[0].slot, buf, f[0].pos, n)
    elif f[0].kind == OF_FAT:
        fr: int64 = fat_read(f[0].aux0, f[0].aux1, f[0].pos, n, buf)
        if fr > 0:
            got = cast[uint64](fr)
    elif f[0].kind == OF_FATW:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: not open for reading"))
    elif f[0].kind == OF_DIR:
        if f[0].pos < f[0].dirlen:
            got = f[0].dirlen - f[0].pos
            if got > n:
                got = n
            rt_memcpy(cast[uint64](buf), f[0].dirbuf + f[0].pos, got)
    else:
        got = tmpfs_read(f[0].slot, buf, f[0].pos, n)
    f[0].pos = f[0].pos + got
    mutex_unlock(&fs_lock)
    if got == 0 and nonblock != 0:
        return -1
    return cast[int64](got)


def vfs_write(fd: int32, buf: Ptr[uint8], n: uint64) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "write: bad fd"))
    if f[0].kind == OF_DEV:
        dev: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        if dev == DEV_CONSOLE:
            console_write(buf, n)
        return cast[int64](n)
    if f[0].kind == OF_FDNAME:
        fdn: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        return _fdn_write(fdn, buf, n)
    if f[0].kind == OF_FATW:
        fw: int64 = fat_write(_pc(cast[Ptr[uint8]](f[0].dirbuf)), buf, f[0].pos, n)
        if fw > 0:
            f[0].pos = f[0].pos + cast[uint64](fw)
            if f[0].pos > f[0].aux1:
                f[0].aux1 = f[0].pos
        mutex_unlock(&fs_lock)
        if fw <= 0 and n != 0:
            return cast[int64](_err(ENOSPC, "FAT: write failed (volume full?)"))
        return fw
    if f[0].kind != OF_FILE or (f[0].mode & 3) == OREAD:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "write: not open for writing"))
    if (f[0].mode & OAPPEND) != 0:
        f[0].pos = tmpfs_size(f[0].slot)
    w: uint64 = tmpfs_write(f[0].slot, buf, f[0].pos, n)
    f[0].pos = f[0].pos + w
    mutex_unlock(&fs_lock)
    if w == 0 and n != 0:
        return cast[int64](_err(ENOSPC, "tmpfs: no space"))
    return cast[int64](w)


# Where a /bin file's bytes are, if `fd` is one: the ROM table is in the
# kernel image, readable in place (the loader runs a program's code from
# there on a board whose programs execute in place, kernel/proc.ad).  0 for
# any other kind of file.
def vfs_rom_addr(fd: int32) -> uint64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    a: uint64 = 0
    if f != cast[Ptr[OpenFile]](0) and f[0].kind == OF_ROM:
        a = rom_data(cast[uint32](f[0].slot))
    mutex_unlock(&fs_lock)
    return a


def vfs_lseek(fd: int32, off: int64, whence: uint32) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "lseek: bad fd"))
    if f[0].kind == OF_DEV or f[0].kind == OF_FDNAME:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(ESPIPE, "lseek: not seekable"))
    base: int64 = 0
    if whence == SEEK_CUR:
        base = cast[int64](f[0].pos)
    elif whence == SEEK_END:
        if f[0].kind == OF_DIR:
            base = cast[int64](f[0].dirlen)
        elif f[0].kind == OF_ROM:
            base = cast[int64](rom_size(cast[uint32](f[0].slot)))
        elif f[0].kind == OF_FAT or f[0].kind == OF_FATW:
            base = cast[int64](f[0].aux1)
        else:
            base = cast[int64](tmpfs_size(f[0].slot))
    elif whence != SEEK_SET:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EINVAL, "lseek: bad whence"))
    np: int64 = base + off
    if np < 0:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EINVAL, "lseek: negative offset"))
    f[0].pos = cast[uint64](np)
    mutex_unlock(&fs_lock)
    return np


def vfs_dup2(oldfd: int32, newfd: int32) -> int32:
    t: Ptr[Thread] = current_thread()
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(oldfd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return _err(EBADF, "dup: bad fd")
    if newfd < 0:
        newfd = 0
        while newfd < cast[int32](VFS_NR_FDS) and t[0].fd[newfd] >= 0:
            newfd = newfd + 1
    if newfd >= cast[int32](VFS_NR_FDS):
        mutex_unlock(&fs_lock)
        return _err(EMFILE, "dup: no free fd")
    if newfd != oldfd:
        if t[0].fd[newfd] >= 0:
            _close_index(t[0].fd[newfd])
        t[0].fd[newfd] = t[0].fd[oldfd]
        f[0].refs = f[0].refs + 1
    mutex_unlock(&fs_lock)
    return newfd


def vfs_dup(oldfd: int32) -> int32:
    return vfs_dup2(oldfd, -1)


def vfs_mkdir(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    tk: Array[272, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return _err(rc, "path too long")
    if vfs_fs_kind(_pc(&canon[0])) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    _tkey(&canon[0], &tk[0])
    mutex_lock(&fs_lock)
    if tmpfs_path_exists(_pc(&tk[0])) != 0:
        rc = _err(EEXIST, "file exists")
    elif _parent_is_dir(&tk[0]) == 0:
        rc = _err(ENOENT, "directory does not exist")
    else:
        rc = tmpfs_mkdir(_pc(&tk[0]))
    mutex_unlock(&fs_lock)
    return rc


# Remove a file or an empty directory.  A file that is open cannot be removed
# (EBUSY): tmpfs keeps no open count and would recycle the slot under the
# descriptor.  This differs from POSIX.
def vfs_unlink(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    tk: Array[272, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return _err(rc, "path too long")
    if vfs_fs_kind(_pc(&canon[0])) == FS_KIND_FAT and fat_mounted != 0:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        mutex_lock(&fs_lock)
        if _fat_is_dir(frel) != 0:
            rc = _err(EISDIR, "FAT: removing a directory is not supported")
        elif fat_delete(_pc(frel)) != 0:
            rc = _err(ENOENT, "file does not exist")
        mutex_unlock(&fs_lock)
        return rc
    if vfs_fs_kind(_pc(&canon[0])) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    if canon[1] == 0:
        return _err(EBUSY, "cannot remove the root directory")
    _tkey(&canon[0], &tk[0])
    mutex_lock(&fs_lock)
    slot: int32 = tmpfs_lookup(_pc(&tk[0]))
    if slot < 0:
        rc = _err(ENOENT, "file does not exist")
    elif _slot_is_open(slot) != 0:
        rc = _err(EBUSY, "file is open")
    else:
        isdir: int32 = tmpfs_is_dir(slot)
        rc = tmpfs_unlink(_pc(&tk[0]))
        if rc == EEXIST and isdir != 0:
            rc = _err(ENOTEMPTY, "directory not empty")
    mutex_unlock(&fs_lock)
    return rc


def vfs_rename(oldpath: Ptr[uint8], newpath: Ptr[uint8]) -> int32:
    co: Array[256, uint8]
    cn: Array[256, uint8]
    to: Array[272, uint8]
    tn: Array[272, uint8]
    rc: int32 = vfs_canon(oldpath, &co[0])
    if rc == 0:
        rc = vfs_canon(newpath, &cn[0])
    if rc < 0:
        return _err(rc, "path too long")
    if vfs_fs_kind(_pc(&co[0])) != FS_KIND_TMPFS or vfs_fs_kind(_pc(&cn[0])) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    if co[1] == 0 or cn[1] == 0:
        return _err(EBUSY, "cannot rename the root directory")
    _tkey(&co[0], &to[0])
    _tkey(&cn[0], &tn[0])
    mutex_lock(&fs_lock)
    if tmpfs_path_exists(_pc(&to[0])) == 0:
        rc = _err(ENOENT, "file does not exist")
    elif _parent_is_dir(&tn[0]) == 0:
        rc = _err(ENOENT, "directory does not exist")
    elif tmpfs_path_is_dir(_pc(&tn[0])) != 0:
        rc = _err(EISDIR, "target is a directory")
    else:
        ns: int32 = tmpfs_lookup(_pc(&tn[0]))
        if ns >= 0 and _slot_is_open(ns) != 0:
            rc = _err(EBUSY, "target is open")
        else:
            rc = tmpfs_rename(_pc(&to[0]), _pc(&tn[0]))
    mutex_unlock(&fs_lock)
    return rc


def _put16(b: Ptr[uint8], off: uint32, v: uint32):
    b[off] = cast[uint8](v & 255)
    b[off + 1] = cast[uint8]((v >> 8) & 255)


def _put32(b: Ptr[uint8], off: uint32, v: uint32):
    _put16(b, off, v & 0xFFFF)
    _put16(b, off + 2, v >> 16)


def _putstr(b: Ptr[uint8], off: uint32, s: Ptr[uint8]) -> uint32:
    n: uint32 = _slen(s)
    _put16(b, off, n)
    i: uint32 = 0
    while i < n:
        b[off + 2 + i] = s[i]
        i = i + 1
    return off + 2 + n


# Encode a 9P2000 stat record, the format of Hamnix's SYS_STAT_P9:
#   size[2] type[2] dev[4] qid.type[1] qid.vers[4] qid.path[8] mode[4]
#   atime[4] mtime[4] length[8] name[s] uid[s] gid[s] muid[s]
# Returns the bytes written, or ERANGE when nbuf is too small.
def _stat_encode(buf: Ptr[uint8], nbuf: uint64, name: Ptr[uint8], qtype: uint32, qpath: uint64, mode: uint32, mtime: uint32, length: uint64) -> int64:
    total: uint32 = 41 + 2 + _slen(name) + 3 * 8
    if cast[uint64](total) > nbuf:
        return cast[int64](_err(ERANGE, "stat buffer too small"))
    _put16(buf, 0, total - 2)
    _put16(buf, 2, 0)
    _put32(buf, 4, 0)
    buf[8] = cast[uint8](qtype)
    _put32(buf, 9, 0)
    _put32(buf, 13, cast[uint32](qpath))
    _put32(buf, 17, cast[uint32](qpath >> 32))
    _put32(buf, 21, mode)
    _put32(buf, 25, mtime)
    _put32(buf, 29, mtime)
    _put32(buf, 33, cast[uint32](length))
    _put32(buf, 37, cast[uint32](length >> 32))
    off: uint32 = _putstr(buf, 41, name)
    off = _putstr(buf, off, "hackos")
    off = _putstr(buf, off, "hackos")
    off = _putstr(buf, off, "hackos")
    return cast[int64](off)


def _basename(canon: Ptr[uint8]) -> Ptr[uint8]:
    n: uint32 = _slen(canon)
    while n > 0 and canon[n - 1] != 47:
        n = n - 1
    if canon[n] == 0:
        return "/"
    return cast[Ptr[uint8]](cast[uint64](canon) + cast[uint64](n))


def _stat_slot(slot: int32, name: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    mode: uint32 = tmpfs_table[slot].mode & 0x1FF
    qt: uint32 = 0
    ln: uint64 = 0
    if tmpfs_is_dir(slot) != 0:
        mode = mode | DMDIR
        qt = QTDIR
    else:
        ln = tmpfs_size(slot)
    return _stat_encode(buf, nbuf, name, qt, cast[uint64](slot) + 1, mode, cast[uint32](tmpfs_mtime(slot)), ln)


def vfs_stat(path: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    canon: Array[256, uint8]
    tk: Array[272, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return cast[int64](_err(rc, "path too long"))
    if vfs_fs_kind(_pc(&canon[0])) == FS_KIND_DEVFS:
        rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        if rel[0] == 0:
            return _stat_encode(buf, nbuf, "dev", QTDIR, 0x1000, DMDIR | 0x16D, 0, 0)
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, _basename(&canon[0]), 0, 0x1000 + cast[uint64](dev), DMDEVICE | 0x1B6, 0, 0)
    if vfs_fs_kind(_pc(&canon[0])) == FS_KIND_ROM:
        rrel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        if rrel[0] == 0:
            return _stat_encode(buf, nbuf, "bin", QTDIR, 0x2000, DMDIR | 0x16D, 0, 0)
        ridx: int32 = _rom_lookup(rrel)
        if ridx < 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, _basename(&canon[0]), 0, 0x2001 + cast[uint64](ridx), 0x16D, 0, rom_size(cast[uint32](ridx)))
    if vfs_fs_kind(_pc(&canon[0])) == FS_KIND_FD:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        if frel[0] == 0:
            return _stat_encode(buf, nbuf, "fd", QTDIR, 0x3000, DMDIR | 0x16D, 0, 0)
        if _fdname_number(frel) < 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, _basename(&canon[0]), 0, 0x3001 + cast[uint64](_fdname_number(frel)), DMDEVICE | 0x1B6, 0, 0)
    if vfs_fs_kind(_pc(&canon[0])) == FS_KIND_FAT:
        srel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        fcl: uint64 = 0
        fsz: uint64 = 0
        fr: int64 = 0
        mutex_lock(&fs_lock)
        if fat_mounted == 0:
            fr = cast[int64](_err(ENOENT, "no FAT volume"))
        elif _fat_is_dir(srel) != 0:
            fr = _stat_encode(buf, nbuf, _basename(&canon[0]), QTDIR, 0x4000, DMDIR | 0x1FF, 0, 0)
        elif fat_lookup(_pc(srel), &fcl, &fsz) != 0:
            fr = _stat_encode(buf, nbuf, _basename(&canon[0]), 0, 0x4000 + fcl, 0x1B6, 0, fsz)
        else:
            fr = cast[int64](_err(ENOENT, "file does not exist"))
        mutex_unlock(&fs_lock)
        return fr
    _tkey(&canon[0], &tk[0])
    mutex_lock(&fs_lock)
    r: int64 = 0
    slot: int32 = tmpfs_lookup(_pc(&tk[0]))
    if slot < 0:
        r = cast[int64](_err(ENOENT, "file does not exist"))
    else:
        r = _stat_slot(slot, _basename(&canon[0]), buf, nbuf)
    mutex_unlock(&fs_lock)
    return r


def vfs_fstat(fd: int32, buf: Ptr[uint8], nbuf: uint64) -> int64:
    mutex_lock(&fs_lock)
    r: int64 = 0
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        r = cast[int64](_err(EBADF, "fstat: bad fd"))
    elif f[0].kind == OF_DEV:
        r = _stat_encode(buf, nbuf, "dev", 0, 0x1000 + cast[uint64](f[0].slot), DMDEVICE | 0x1B6, 0, 0)
    elif f[0].kind == OF_FDNAME:
        r = _stat_encode(buf, nbuf, "fd", 0, 0x3001 + cast[uint64](f[0].slot), DMDEVICE | 0x1B6, 0, 0)
    elif f[0].kind == OF_ROM:
        r = _stat_encode(buf, nbuf, rom_name(cast[uint32](f[0].slot)), 0, 0x2001 + cast[uint64](f[0].slot), 0x16D, 0, rom_size(cast[uint32](f[0].slot)))
    elif f[0].kind == OF_FAT or f[0].kind == OF_FATW:
        r = _stat_encode(buf, nbuf, "", 0, 0x4000 + f[0].aux0, 0x1B6, 0, f[0].aux1)
    elif f[0].kind == OF_DIR:
        r = _stat_encode(buf, nbuf, "", QTDIR, 0, DMDIR | 0x1ED, 0, 0)
    else:
        r = _stat_slot(f[0].slot, "", buf, nbuf)
    mutex_unlock(&fs_lock)
    return r


def vfs_chdir(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    tk: Array[272, uint8]
    rc: int32 = vfs_canon(path, &canon[0])
    if rc < 0:
        return _err(rc, "path too long")
    if _slen(&canon[0]) >= 127:
        return _err(ENAMETOOLONG, "chdir: path too long")
    ck: uint32 = vfs_fs_kind(_pc(&canon[0]))
    if ck == FS_KIND_DEVFS or ck == FS_KIND_ROM or ck == FS_KIND_FD:
        if cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))[0] != 0:
            return _err(ENOTDIR, "not a directory")
    elif ck == FS_KIND_FAT:
        mutex_lock(&fs_lock)
        fok: uint32 = 0
        if fat_mounted != 0:
            fok = _fat_is_dir(cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0]))))
        mutex_unlock(&fs_lock)
        if fok == 0:
            return _err(ENOENT, "directory does not exist")
    else:
        _tkey(&canon[0], &tk[0])
        mutex_lock(&fs_lock)
        ok: int32 = tmpfs_path_is_dir(_pc(&tk[0]))
        ex: int32 = tmpfs_path_exists(_pc(&tk[0]))
        mutex_unlock(&fs_lock)
        if ok == 0:
            if ex != 0:
                return _err(ENOTDIR, "not a directory")
            return _err(ENOENT, "directory does not exist")
    cwd: Ptr[uint8] = &current_thread()[0].cwd[0]
    i: uint32 = 0
    while canon[i] != 0:
        cwd[i] = canon[i]
        i = i + 1
    cwd[i] = 0
    return 0


# Copies the working directory including its NUL; returns the byte count.
def vfs_getcwd(buf: Ptr[uint8], n: uint64) -> int64:
    cwd: Ptr[uint8] = &current_thread()[0].cwd[0]
    ln: uint64 = cast[uint64](_slen(cwd)) + 1
    if n < ln:
        return cast[int64](_err(ERANGE, "getcwd: buffer too small"))
    rt_memcpy(cast[uint64](buf), cast[uint64](cwd), ln)
    return cast[int64](ln)


# Number of open-file entries in use (for leak checks).
def vfs_open_count() -> uint32:
    n: uint32 = 0
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        if ofiles[i].refs != 0:
            n = n + 1
        i = i + 1
    return n


# A thread ends: release its descriptors.  Runs in thread context (the exiting
# thread itself, or whoever reaps a thread that was ended by a fault).
def _vfs_thread_exit(tp: uint64) -> int64:
    t: Ptr[Thread] = thr(tp)
    mutex_lock(&fs_lock)
    fd: uint32 = 0
    while fd < VFS_NR_FDS:
        if t[0].fd[fd] >= 0:
            _close_index(t[0].fd[fd])
            t[0].fd[fd] = -1
        fd = fd + 1
    mutex_unlock(&fs_lock)
    # the /fd names: dropping a pipe end is what the other side sees as end
    # of file or EPIPE
    n: uint32 = 0
    while n < DEVFD_SLOTS:
        _fdn_release(t, n)
        n = n + 1
    pipe_release_unbound(t[0].tid)
    return 0


# A thread is created: it starts with its creator's descriptors and directory.
def _vfs_thread_spawn(childp: uint64, parentp: uint64) -> int64:
    c: Ptr[Thread] = thr(childp)
    p: Ptr[Thread] = thr(parentp)
    mutex_lock(&fs_lock)
    fd: uint32 = 0
    while fd < VFS_NR_FDS:
        idx: int32 = p[0].fd[fd]
        c[0].fd[fd] = idx
        if idx >= 0:
            ofiles[idx].refs = ofiles[idx].refs + 1
        fd = fd + 1
    mutex_unlock(&fs_lock)
    i: uint32 = 0
    while p[0].cwd[i] != 0:
        c[0].cwd[i] = p[0].cwd[i]
        i = i + 1
    c[0].cwd[i] = 0
    # the /fd names, each pipe end counted once more
    n: uint32 = 0
    while n < DEVFD_SLOTS:
        c[0].fdn_kind[n] = p[0].fdn_kind[n]
        c[0].fdn_arg[n] = p[0].fdn_arg[n]
        c[0].fdn_pos[n] = p[0].fdn_pos[n]
        if p[0].fdn_kind[n] == DEVFD_PIPE_R:
            pipe_inc_reader(p[0].fdn_arg[n])
        elif p[0].fdn_kind[n] == DEVFD_PIPE_W:
            pipe_inc_writer(p[0].fdn_arg[n])
        n = n + 1
    return 0


# Mount the root tmpfs and /dev, create the standard directories.
def vfs_init():
    mutex_init(&fs_lock)
    mutex_register(&fs_lock)
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        ofiles[i].refs = 0
        i = i + 1
    vfs_mount("/", FS_KIND_TMPFS, 0, 0)
    vfs_mount("/dev", FS_KIND_DEVFS, 4, 0)
    vfs_mount("/bin", FS_KIND_ROM, 4, 0)
    vfs_mount("/fd", FS_KIND_FD, 3, 0)
    pipe_init()
    tmpfs_mkdir("/root/dev")
    tmpfs_mkdir("/root/bin")
    tmpfs_mkdir("/root/fd")
    tmpfs_mkdir("/root/tmp")
    tmpfs_mkdir("/root/etc")
    sched_exit_hook = _vfs_thread_exit
    sched_exit_hook_set = 1
    sched_spawn_hook = _vfs_thread_spawn
    sched_spawn_hook_set = 1
    vfs_ready = 1


# Give the current thread the console on descriptors 0, 1 and 2.
def vfs_open_stdio() -> int32:
    fd: int32 = vfs_open("/dev/console", ORDWR)
    if fd != 0:
        return -1
    vfs_dup2(0, 1)
    vfs_dup2(0, 2)
    vfs_fdbind(0, 0, DEVFD_CONS, 0)
    vfs_fdbind(0, 1, DEVFD_CONS, 0)
    vfs_fdbind(0, 2, DEVFD_CONS, 0)
    return 0
