from fs.procfs import proc_lookup, proc_note_pid, proc_ns_pid, proc_pid_dir, proc_render, proc_listdir, proc_note, proc_set_time, proc_fat_mounted, proc_keys, PROC_BUF, PROC_REALTIME, PROC_POWER, PROC_KEYS
from kernel.power import power_ctl
from kernel.pipe import pipe_init, pipe_alloc_chan, pipe_valid, pipe_owner, pipe_inc_reader, pipe_inc_writer, pipe_close_reader, pipe_close_writer, pipe_read, pipe_write, pipe_release_unbound
from fs.tmpfs import tmpfs_lookup, tmpfs_open_for_write_t, tmpfs_read, tmpfs_write, tmpfs_size, tmpfs_ftruncate, tmpfs_unlink, tmpfs_rename, tmpfs_mkdir, tmpfs_listdir, tmpfs_path_is_dir, tmpfs_path_exists, tmpfs_mtime, tmpfs_is_dir, tmpfs_table, TmpfsEntry, TMPFS_MAX_FILES

# errno values (Linux numbering, as Hamnix returns them)
ENOENT: int32 = -2
EBADF: int32 = -9
ENOMEM: int32 = -12
EFAULT: int32 = -14
EBUSY: int32 = -16
EEXIST: int32 = -17
ENOTDIR: int32 = -20
EISDIR: int32 = -21
EINVAL: int32 = -22
EMFILE: int32 = -24
ENOSPC: int32 = -28
ESPIPE: int32 = -29
ESRCH: int32 = -3
EROFS: int32 = -30
ERANGE: int32 = -34
ENAMETOOLONG: int32 = -36
ENOSYS: int32 = -38
ENOTEMPTY: int32 = -39
EPERM: int32 = -1

# open modes (Plan 9 values, as documented for Hamnix)
OREAD: uint32 = 0
OWRITE: uint32 = 1
ORDWR: uint32 = 2
OTRUNC: uint32 = 16
OAPPEND: uint32 = 128
OCREATE: uint32 = 0x1000            # Hamnix Micro-internal: create if missing

SEEK_SET: uint32 = 0
SEEK_CUR: uint32 = 1
SEEK_END: uint32 = 2

OF_FILE: uint32 = 1
OF_DIR: uint32 = 2
OF_DEV: uint32 = 3
OF_ROM: uint32 = 4                  # a file of /bin; slot = index into the ROM table
OF_FDNAME: uint32 = 5               # "/fd/N"; slot = N, resolved at every read and write
OF_FAT: uint32 = 6                  # a file on /sd open for reading: aux0 = first cluster, aux1 = size
OF_PROCW: uint32 = 8                # a writable /proc file: slot = pid for <pid>/note, -1 realtime, -2 power, -3 keys
OF_FATW: uint32 = 7                 # ... open for writing: dirbuf = its path on the volume, aux1 = size
OF_SOCK: uint32 = 9                 # one end of a socketpair: aux0 = the pipe it reads, aux1 = the pipe it writes
OF_9P: uint32 = 10                  # a file on a 9P server: slot = connection (fs/p9c.ad), aux0 = fid

FS_KIND_ROM: uint32 = 1             # = FS_KIND_CPIO, "read-only baked root" in Hamnix's table
FS_KIND_PROC: uint32 = 5            # = FS_KIND_EXT4 in Hamnix's table: Hamnix Micro has no ext4 and serves /proc (fs/procfs.ad) under this kind
FS_KIND_FD: uint32 = 2              # = FS_KIND_PROCFS, names served by the kernel
FS_KIND_9P: uint32 = 7              # "/#M<n>/...": files of the 9P server on connection n (fs/p9c.ad)
FS_KIND_SRV: uint32 = 8             # "/#s/<name>": posted connections (fs/srv.ad)
# Each server has a key space of its own in Hamnix's table (fs/vfs_mount.ad):
# tmpfs holds "/...", every other server "/#<letter>/...", which is what a
# name is turned into once the caller's namespace has resolved it (below).
# A process names a server directly as "#<letter>/..." (Plan 9's device
# syntax, as in Hamnix):
#     #t  the RAM file system        #c  devices        #r  the programs in ROM
#     #d  the caller's /fd names     #p  /proc          #f  the FAT volume
#     #s  /srv: posted servers       #M<n>  the 9P server on connection n

# What an /fd name is bound to (Hamnix's DEVFD_* values).
DEVFD_NONE: int32 = 0
DEVFD_CONS: int32 = 1               # the console
DEVFD_PIPE_R: int32 = 2             # read end of pipe slot `arg`
DEVFD_PIPE_W: int32 = 3             # write end of pipe slot `arg`
DEVFD_FILE: int32 = 4               # tmpfs slot `arg`, own position
DEVFD_DUP: int32 = 5                # bind request only: copy the binding of /fd/<arg>
DEVFD_FILE_APPEND: int32 = 6        # tmpfs slot `arg`, every write at the end
DEVFD_CHAN: int32 = 7               # a device or ROM file, `arg` from vfs_openchan
DEVFD_SLOTS: uint32 = 16
# vfs_openchan results at or above this value are not tmpfs slots:
# CHAN_INLINE_TAG | CHAN_DEV | device, or CHAN_INLINE_TAG | CHAN_ROM | index.
CHAN_INLINE_TAG: int32 = 0x40000000
CHAN_DEV: int32 = 0x10000
CHAN_ROM: int32 = 0x20000
CHAN_OF: int32 = 0x80000            # ... | CHAN_OF | index: an entry of the open-file table (a file on a 9P server)

# The ROM table (generated: build/romfs.S): `romfs_count` entries of
# {name address, data address, size, 0}, 32-bit words.
extern def romfs_table()
extern def romfs_count()

DEV_CONSOLE: int32 = 1
DEV_NULL: int32 = 2
DEV_ZERO: int32 = 3
DEV_TREE: int32 = 16                # DEV_TREE + n: file n of the drivers' tree (fs/devtree.ad)

VFS_NR_FDS: uint32 = 16             # per thread (Hamnix: 64 per task)
VFS_NR_OPEN: uint32 = 64            # system-wide open files
VFS_PATH_MAX: uint32 = 256
VFS_DIRBUF: uint64 = 8192

QTDIR: uint32 = 0x80
DMDIR: uint32 = 0x80000000
DMDEVICE: uint32 = 0x00800000


class OpenFile:
    refs: uint32                    # descriptors referring to this entry
    kind: uint32
    slot: int32                     # tmpfs slot, or device number
    mode: uint32
    pos: uint64
    dirbuf: uint64                  # OF_DIR: snapshot of the listing (freed at close)
    dirlen: uint64
    aux0: uint64
    aux1: uint64


ofiles: Array[64, OpenFile]
fs_lock: Mutex
vfs_ready: uint32 = 0
fat_mounted: uint32 = 0


def _pc(p: Ptr[uint8]) -> Ptr[char]:
    return cast[Ptr[char]](p)


def _err(code: int32, msg: Ptr[uint8]) -> int32:
    set_current_errstr(msg)
    return code


def _slen(s: Ptr[uint8]) -> uint32:
    n: uint32 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _seq(a: Ptr[uint8], b: Ptr[uint8]) -> uint32:
    i: uint32 = 0
    while a[i] != 0 and a[i] == b[i]:
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


# Append the components of `src` to the canonical path out[0..o): "." is
# dropped, ".." takes the last component away.  Returns the new length, or
# ENAMETOOLONG.
def _canon_part(src: Ptr[uint8], out: Ptr[uint8], o: uint32) -> int32:
    i: uint32 = 0
    while src[i] != 0:
        while src[i] == 47:
            i = i + 1
        if src[i] == 0:
            break
        st: uint32 = i
        while src[i] != 0 and src[i] != 47:
            i = i + 1
        ln: uint32 = i - st
        if ln == 1 and src[st] == 46:
            continue
        if ln == 2 and src[st] == 46 and src[st + 1] == 46:
            while o > 0 and out[o - 1] != 47:
                o = o - 1
            if o > 0:
                o = o - 1
            continue
        if o + ln + 2 > VFS_PATH_MAX:
            return ENAMETOOLONG
        out[o] = 47
        o = o + 1
        k: uint32 = 0
        while k < ln:
            out[o] = src[st + k]
            o = o + 1
            k = k + 1
    return cast[int32](o)


# Make `path` absolute (against the thread's working directory) and canonical:
# no ".", "..", doubled or trailing slashes.  out holds VFS_PATH_MAX bytes.
def vfs_canon(path: Ptr[uint8], out: Ptr[uint8]) -> int32:
    o: int32 = 0
    if path[0] != 47:
        o = _canon_part(&current_thread()[0].cwd[0], out, 0)
    if o >= 0:
        o = _canon_part(path, out, cast[uint32](o))
    if o < 0:
        return o
    if o == 0:
        out[0] = 47
        o = 1
    out[o] = 0
    return 0


# The tmpfs key of the RAM file system's root.  Hamnix's tmpfs only serves a
# fixed set of top-level names, so Hamnix Micro keeps its whole tree under the one
# named "root": "#t/a/b" is the tmpfs path /root/a/b.
def _is_troot(key: Ptr[uint8]) -> uint32:
    if key[5] == 0:
        return 1
    return 0


# Which server a key belongs to (fs/vfs_mount.ad), 0 for a key no server has:
# tmpfs keys start with "/root", every other server's with "/#<name>".
def _kind(key: Ptr[uint8]) -> uint32:
    if key[1] == 35 and key[2] == 77 and key[3] >= 48 and key[3] <= 57:
        return FS_KIND_9P               # "/#M<n>...": the number is part of the server's name
    k: uint32 = vfs_fs_kind(_pc(key))
    if k == FS_KIND_TMPFS:
        if not (key[1] == 114 and key[2] == 111 and key[3] == 111 and key[4] == 116 and (key[5] == 0 or key[5] == 47)):
            return 0
    return k


# Does the directory that would hold tmpfs key `tk` exist?  (The key is cut
# at its last slash for the question and put back.)
def _parent_is_dir(tk: Ptr[uint8]) -> uint32:
    n: uint32 = _slen(tk)
    while n > 0 and tk[n - 1] != 47:
        n = n - 1
    if n <= 1:
        return 0
    tk[n - 1] = 0
    r: uint32 = 0
    if tmpfs_path_is_dir(_pc(tk)) != 0:
        r = 1
    tk[n - 1] = 47
    return r


def _dev_lookup(rel: Ptr[uint8]) -> int32:
    if _seq(rel, "/console") != 0 or _seq(rel, "/cons") != 0:
        return DEV_CONSOLE
    if _seq(rel, "/null") != 0:
        return DEV_NULL
    if _seq(rel, "/zero") != 0:
        return DEV_ZERO
    tn: int32 = devtree_find(rel)
    if tn >= 0:
        return DEV_TREE + tn
    return 0


# Reading and writing a file of the drivers' tree.  fs_lock is not held: a
# driver may sleep.  A driver's error is its negative errno.
def _tree_io(dev: int32, write: uint32, buf: Ptr[uint8], n: uint64, pos: uint64) -> int64:
    r: int64 = 0
    if write != 0:
        r = devtree_write(cast[uint32](dev - DEV_TREE), buf, n, pos)
    else:
        r = devtree_read(cast[uint32](dev - DEV_TREE), buf, n, pos)
    if r == -9:
        if write != 0:
            return cast[int64](_err(EBADF, "write: this device file cannot be written"))
        return cast[int64](_err(EBADF, "read: this device file cannot be read"))
    if r == -22:
        return cast[int64](_err(EINVAL, "device: not understood"))
    if r == -5:
        return cast[int64](_err(-5, "device: input/output error"))
    if r < 0:
        return cast[int64](_err(cast[int32](r), "device error"))
    return r


# ---------------------------------------------------------------- /bin (ROM)
def rom_count() -> uint32:
    return cast[Ptr[uint32]](cast[uint64](&romfs_count))[0]


def _rom_word(i: uint32, w: uint32) -> uint32:
    return cast[Ptr[uint32]](cast[uint64](&romfs_table))[i * 4 + w]


def rom_name(i: uint32) -> Ptr[uint8]:
    return cast[Ptr[uint8]](cast[uint64](_rom_word(i, 0)))


def rom_data(i: uint32) -> uint64:
    return cast[uint64](_rom_word(i, 1))


def rom_size(i: uint32) -> uint64:
    return cast[uint64](_rom_word(i, 2))


# rel is "/name"; returns the index or -1.
def _rom_lookup(rel: Ptr[uint8]) -> int32:
    if rel[0] != 47:
        return -1
    name: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](rel) + 1)
    i: uint32 = 0
    while i < rom_count():
        if _seq(name, rom_name(i)) != 0:
            return cast[int32](i)
        i = i + 1
    return -1


def _rom_read(idx: int32, buf: Ptr[uint8], pos: uint64, n: uint64) -> uint64:
    size: uint64 = rom_size(cast[uint32](idx))
    if pos >= size:
        return 0
    if n > size - pos:
        n = size - pos
    rt_memcpy(cast[uint64](buf), rom_data(cast[uint32](idx)) + pos, n)
    return n


def _fd_file(fd: int32) -> Ptr[OpenFile]:
    if fd < 0 or fd >= cast[int32](VFS_NR_FDS):
        return cast[Ptr[OpenFile]](0)
    idx: int32 = current_thread()[0].fd[fd]
    if idx < 0:
        return cast[Ptr[OpenFile]](0)
    return &ofiles[idx]


# Bind a new OpenFile to the lowest free descriptor of the current thread.
# fs_lock held.  Returns the descriptor or EMFILE.
def _install(kind: uint32, slot: int32, mode: uint32, dirbuf: uint64, dirlen: uint64) -> int32:
    t: Ptr[Thread] = current_thread()
    fd: int32 = 0
    while fd < cast[int32](VFS_NR_FDS) and t[0].fd[fd] >= 0:
        fd = fd + 1
    i: int32 = 0
    while i < cast[int32](VFS_NR_OPEN) and ofiles[i].refs != 0:
        i = i + 1
    if fd == cast[int32](VFS_NR_FDS) or i == cast[int32](VFS_NR_OPEN):
        return _err(EMFILE, "too many open files")
    ofiles[i].refs = 1
    ofiles[i].kind = kind
    ofiles[i].slot = slot
    ofiles[i].mode = mode
    ofiles[i].pos = 0
    ofiles[i].dirbuf = dirbuf
    ofiles[i].dirlen = dirlen
    t[0].fd[fd] = i
    return fd


# Is tmpfs slot `slot` open through a descriptor, or bound at an /fd name of
# any process?
def _slot_is_open(slot: int32) -> uint32:
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        if ofiles[i].refs != 0 and ofiles[i].kind == OF_FILE and ofiles[i].slot == slot:
            return 1
        i = i + 1
    i = 0
    while i < THREAD_MAX:
        if threads[i].state != T_UNUSED:
            k: uint32 = 0
            while k < DEVFD_SLOTS:
                if (threads[i].fdn_kind[k] == DEVFD_FILE or threads[i].fdn_kind[k] == DEVFD_FILE_APPEND) and threads[i].fdn_arg[k] == slot:
                    return 1
                k = k + 1
        i = i + 1
    return 0


def _put_dec(buf: Ptr[uint8], off: uint32, v: uint32) -> uint32:
    if v >= 10:
        buf[off] = cast[uint8](48 + v / 10)
        off = off + 1
    buf[off] = cast[uint8](48 + v % 10)
    return off + 1


# ---------------------------------------------------------------- /sd (FAT)
# rel is the path on the volume without a leading slash ("" = its root).
def _fat_is_dir(rel: Ptr[uint8]) -> uint32:
    probe: Array[8, uint8]
    if fat_listdir(_pc(rel), &probe[0], 8) >= 0:
        return 1
    return 0


def _fat_open(rel: Ptr[uint8], mode: uint32, wants_write: uint32) -> int32:
    if fat_mounted == 0:
        return _err(ENOENT, "no FAT volume")
    if _fat_is_dir(rel) != 0:
        return _err(EISDIR, "is a directory")
    cluster: uint64 = 0
    size: uint64 = 0
    found: int32 = fat_lookup(_pc(rel), &cluster, &size)
    if wants_write == 0:
        if found == 0:
            return _err(ENOENT, "file does not exist")
        fd: int32 = _install(OF_FAT, 0, OREAD, 0, 0)
        if fd >= 0:
            f: Ptr[OpenFile] = _fd_file(fd)
            f[0].aux0 = cluster
            f[0].aux1 = size
        return fd
    if (mode & 3) == ORDWR:
        return _err(EINVAL, "FAT: a file is open for reading or for writing, not both")
    if found == 0 and (mode & OCREATE) == 0:
        return _err(ENOENT, "file does not exist")
    if found == 0 or (mode & OTRUNC) != 0:
        if fat_create(_pc(rel)) != 0:
            return _err(EINVAL, "FAT: cannot create the file (new names must be 8.3; is the directory there, is the volume full?)")
        size = 0
    ln: uint32 = _slen(rel)
    pcopy: uint64 = kmalloc(cast[uint64](ln) + 1)
    if pcopy == 0:
        return _err(ENOMEM, "out of memory")
    rt_memcpy(pcopy, cast[uint64](rel), cast[uint64](ln) + 1)
    fdw: int32 = _install(OF_FATW, 0, mode & (3 | OAPPEND), pcopy, 0)
    if fdw < 0:
        kfree(pcopy)
        return fdw
    fw: Ptr[OpenFile] = _fd_file(fdw)
    fw[0].aux1 = size
    if (mode & OAPPEND) != 0:
        fw[0].pos = size
    return fdw


# Mount the FAT32 volume on block device "ram0" at /sd, if there is one.
# Returns 1 when mounted.
def vfs_fat_mount() -> uint32:
    slot: int32 = board_storage_init()
    if slot < 0:
        return 0
    if fat_init(slot) != 0:
        return 0
    # fat_init registers Hamnix's mount point, /mnt; Hamnix Micro wants /sd
    hm: int32 = vfs_mount("/mnt", FS_KIND_FAT, 5, 0)
    if hm >= 0:
        vfs_umount(hm)
    vfs_mount("/#f", FS_KIND_FAT, 4, 0)
    ns_add(0, "/sd", "#f", 0, NS_BIND)
    fat_mounted = 1
    return 1


# "/N" with N in 0..15 -> N, else -1.
def _fdname_number(rel: Ptr[uint8]) -> int32:
    if rel[0] != 47 or rel[1] < 48 or rel[1] > 57:
        return -1
    n: int32 = cast[int32](rel[1]) - 48
    if rel[2] != 0:
        if rel[2] < 48 or rel[2] > 57 or rel[3] != 0:
            return -1
        n = n * 10 + cast[int32](rel[2]) - 48
    if n >= cast[int32](DEVFD_SLOTS):
        return -1
    return n


# /proc (fs/procfs.ad): a file's text is rendered when it is opened and kept
# like a directory listing; <pid>/note and realtime can be opened for writing.
def _proc_rel(rel: Ptr[uint8]) -> Ptr[uint8]:
    if rel[0] == 47:                    # the path below a mount point starts with '/'
        return cast[Ptr[uint8]](cast[uint64](rel) + 1)
    return rel


def _proc_open(rel0: Ptr[uint8], wants_write: uint32) -> int32:
    rel: Ptr[uint8] = _proc_rel(rel0)
    proc_fat_mounted = fat_mounted
    which: uint32 = proc_lookup(rel)
    if wants_write != 0:
        npid: uint32 = proc_note_pid(rel)
        if npid != 0:
            return _install(OF_PROCW, cast[int32](npid), OWRITE, 0, 0)
        if which == PROC_REALTIME:
            return _install(OF_PROCW, -1, OWRITE, 0, 0)
        if which == PROC_POWER:
            return _install(OF_PROCW, -2, OWRITE, 0, 0)
        if which == PROC_KEYS:
            return _install(OF_PROCW, -3, OWRITE, 0, 0)
        if rel[0] == 0 or proc_pid_dir(rel) != 0:
            return _err(EISDIR, "is a directory")
        return _err(EROFS, "read-only file")
    nspid: uint32 = proc_ns_pid(rel)
    if rel[0] == 0 or proc_pid_dir(rel) != 0:
        return _err(EISDIR, "is a directory")
    if which == 0 and nspid == 0:
        return _err(ENOENT, "file does not exist")
    pb: uint64 = kmalloc(PROC_BUF)
    if pb == 0:
        return _err(ENOMEM, "out of memory")
    pn: uint64 = 0
    if nspid != 0:
        nt: Ptr[Thread] = thread_by_tid(nspid)
        if nt != cast[Ptr[Thread]](0):
            pn = ns_render(nt[0].nsg, cast[Ptr[uint8]](pb), PROC_BUF)
    else:
        pn = proc_render(which, cast[Ptr[uint8]](pb), PROC_BUF)
    pfd: int32 = _install(OF_DIR, 0, OREAD, pb, pn)
    if pfd < 0:
        kfree(pb)
    return pfd


# ---------------------------------------------------------------- names
# A path a process passes is looked up in ITS namespace (fs/ns.ad).  The
# result is a server key: "/tmp/x" (tmpfs), "/#c/console", "/#r/ls", ...
# which the rest of this file hands to the server's code through
# vfs_fs_kind() and vfs_fs_rel().
def _nsg() -> uint32:
    return current_thread()[0].nsg


# A server name a process wrote, "#X" or "#X/rest", -> server key.  key and
# tmp: VFS_PATH_MAX bytes each.  0 or a negative errno.
def _spec_key(spec: Ptr[uint8], key: Ptr[uint8], tmp: Ptr[uint8]) -> int32:
    n: uint32 = 1
    while spec[n] != 0 and spec[n] != 47:
        c: uint8 = spec[n]
        if not ((c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)):
            return ENOENT
        n = n + 1
    if n == 1 or n > 8:
        return ENOENT
    tmp[0] = 47
    tmp[1] = 0
    if spec[n] != 0 and vfs_canon(cast[Ptr[uint8]](cast[uint64](spec) + cast[uint64](n)), tmp) < 0:
        return ENAMETOOLONG
    o: uint32 = 0
    while o < n:
        key[o] = spec[o]
        o = o + 1
    if tmp[1] != 0:
        i: uint32 = 0
        while tmp[i] != 0:
            if o + 2 >= VFS_PATH_MAX:
                return ENAMETOOLONG
            key[o] = tmp[i]
            o = o + 1
            i = i + 1
    key[o] = 0
    return _spec_inplace(key)


# The same for a name the namespace produced ("#X/..." in canonical form,
# fs/ns.ad), in place: "#t/a" -> "/root/a", "#t" -> "/root", "#c/x" ->
# "/#c/x".  The buffer needs three bytes of room.
def _spec_inplace(b: Ptr[uint8]) -> int32:
    n: uint32 = _slen(b)
    d: uint32 = 1
    if b[1] == 116 and (b[2] == 0 or b[2] == 47):
        d = 3
    if n + d + 1 > VFS_PATH_MAX:
        return ENAMETOOLONG
    i: uint32 = n + 1
    while i > 0:
        i = i - 1
        b[i + d] = b[i]
    if d == 3:                          # "#t..." became "???#t...": write "/root" over the first five
        b[0] = 47
        b[1] = 114
        b[2] = 111
        b[3] = 111
        b[4] = 116
    else:
        b[0] = 47
    return 0


# Server key -> "#X/..." (what a bind stores), in place.
def _key_spec(b: Ptr[uint8]):
    n: uint32 = _slen(b)
    d: uint32 = 1                       # "/#c/x" -> "#c/x"
    if b[1] != 35:
        d = 3                           # "/root/a" -> "#t/a"
    i: uint32 = 0
    while i + d <= n:
        b[i] = b[i + d]
        i = i + 1
    if d == 3:
        b[0] = 35
        b[1] = 116


# What a server key names: 0 nothing, 1 a file, 2 a directory.
def _key_kind(key: Ptr[uint8]) -> uint32:
    kind: uint32 = _kind(key)
    rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(key)))
    r: uint32 = 0
    if kind == 0:
        return 0
    if kind == FS_KIND_TMPFS:
        mutex_lock(&fs_lock)
        if tmpfs_path_is_dir(_pc(key)) != 0:
            r = 2
        elif tmpfs_path_exists(_pc(key)) != 0:
            r = 1
        mutex_unlock(&fs_lock)
        return r
    if kind == FS_KIND_FAT:
        cl: uint64 = 0
        sz: uint64 = 0
        mutex_lock(&fs_lock)
        if fat_mounted != 0:
            if _fat_is_dir(rel) != 0:
                r = 2
            elif fat_lookup(_pc(rel), &cl, &sz) != 0:
                r = 1
        mutex_unlock(&fs_lock)
        return r
    if kind == FS_KIND_PROC:
        prel: Ptr[uint8] = _proc_rel(rel)
        if prel[0] == 0 or proc_pid_dir(prel) != 0:
            return 2
        if proc_lookup(prel) != 0 or proc_note_pid(prel) != 0 or proc_ns_pid(prel) != 0:
            return 1
        return 0
    if kind == FS_KIND_9P:
        nrel: Ptr[uint8] = cast[Ptr[uint8]](0)
        pc: int32 = _p9_begin(key, &nrel)
        if pc < 0:
            return 0
        qt: uint32 = 0
        pf: int32 = p9c_walk(cast[uint32](pc), nrel, 0, cast[Ptr[uint32]](0), &qt)
        if pf >= 0:
            p9c_clunk(cast[uint32](pc), cast[uint32](pf))
            r = 1
            if (qt & 0x80) != 0:
                r = 2
        _p9_end(pc)
        return r
    if rel[0] == 0:
        return 2
    if kind == FS_KIND_SRV:
        if srv_find(_proc_rel(rel)) >= 0:
            return 1
        return 0
    if kind == FS_KIND_DEVFS and _dev_lookup(rel) != 0:
        return 1
    if kind == FS_KIND_DEVFS and devtree_is_dir(rel) != 0:
        return 2
    if kind == FS_KIND_ROM and _rom_lookup(rel) >= 0:
        return 1
    if kind == FS_KIND_FD and _fdname_number(rel) >= 0:
        return 1
    return 0


# Is `canon` a directory only because mount points lie below it?
def _ns_synth(canon: Ptr[uint8]) -> uint32:
    tmp: Array[136, uint8]
    if canon[0] == 0:
        return 0
    if ns_children(_nsg(), canon, &tmp[0], 130, 0) != 0:
        return 1
    return 0


# Resolve `path` in the caller's namespace.
#   key    <- the server key (VFS_PATH_MAX bytes)
#   canon  <- the absolute canonical name in the namespace, or "" when
#             `path` named a server directly ("#c/console")
#   intent    RES_LOOKUP  the first union member that has the name, else the
#                         first member (Hamnix's resolve_path)
#             RES_CREATE  the highest-priority MCREATE member if the union
#                         has one, else as RES_LOOKUP (resolve_path_create)
#             RES_CHANGE  as RES_LOOKUP, for removing or renaming
#             (the last two fail with EROFS through a read-only binding)
# 0 or a negative errno with the error string set.  A name that no binding
# covers does not exist: there is nothing behind the namespace.
RES_LOOKUP: uint32 = 0
RES_CREATE: uint32 = 1
RES_CHANGE: uint32 = 2


def _resolve(path: Ptr[uint8], key: Ptr[uint8], canon: Ptr[uint8], intent: uint32) -> int32:
    if path[0] == 35:
        src: int32 = _spec_key(path, key, canon)
        canon[0] = 0
        if src < 0:
            return _err(ENOENT, "no such device")
        return 0
    rc: int32 = vfs_canon(path, canon)
    if rc < 0:
        canon[0] = 0
        return _err(rc, "path too long")
    g: uint32 = _nsg()
    if intent != RES_LOOKUP:
        ct: int32 = ns_create_target(g, canon, key, VFS_PATH_MAX - 4)
        if ct == EROFS:
            return _err(EROFS, "read-only binding")
        if ct < 0:
            return _err(ENAMETOOLONG, "path too long")
        if ct == 1 and intent == RES_CREATE:
            return _spec_inplace(key)
    # the first member that has the name; if none has it, the first member
    nth: uint32 = 0
    while True:
        wr: int32 = ns_walk(g, canon, key, VFS_PATH_MAX - 4, nth, cast[Ptr[uint32]](0))
        if wr == 0:
            return _err(ENOENT, "file does not exist")
        if wr == -1:
            return _err(ENAMETOOLONG, "path too long")
        if wr == -2:
            ns_walk(g, canon, key, VFS_PATH_MAX - 4, 0, cast[Ptr[uint32]](0))
            _spec_inplace(key)
            return 0
        _spec_inplace(key)
        if _key_kind(key) != 0:
            return 0
        nth = nth + 1
    return 0


# Take lines of buf[base..end) out that are in buf[0..base) already; returns
# the new end.
def _dedupe(buf: Ptr[uint8], base: uint64, end: uint64) -> uint64:
    r: uint64 = base
    w: uint64 = base
    while r < end:
        st: uint64 = r
        while r < end and buf[r] != 10:
            r = r + 1
        ln: uint64 = r - st
        if r < end:
            r = r + 1
        if ln > 0 and ns_line_in(buf, base, cast[Ptr[uint8]](cast[uint64](buf) + st), cast[uint32](ln)) == 0:
            k: uint64 = 0
            while k < ln:
                buf[w + k] = buf[st + k]
                k = k + 1
            buf[w + ln] = 10
            w = w + ln + 1
    return w


def _list_add(buf: Ptr[uint8], cap: uint64, off: uint64, name: Ptr[uint8]) -> uint64:
    l: uint64 = cast[uint64](_slen(name))
    if off + l + 1 > cap:
        return off
    rt_memcpy(cast[uint64](buf) + off, cast[uint64](name), l)
    buf[off + l] = 10
    return off + l + 1


# Append the listing of directory `key` ("NAME\n" lines) to buf[0..off),
# leaving out names that are there already.  Returns the new length.
def _list_key(key: Ptr[uint8], buf: Ptr[uint8], cap: uint64, off: uint64) -> uint64:
    kind: uint32 = _kind(key)
    rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(key)))
    at: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](buf) + off)
    end: uint64 = off
    n: int64 = 0
    if kind == FS_KIND_TMPFS:
        mutex_lock(&fs_lock)
        n = tmpfs_listdir(_pc(key), at, cap - off)
        mutex_unlock(&fs_lock)
        if n > 0:
            end = off + cast[uint64](n)
    elif kind == FS_KIND_FAT:
        mutex_lock(&fs_lock)
        n = fat_listdir(_pc(rel), at, cap - off)
        mutex_unlock(&fs_lock)
        if n > 0:
            end = off + cast[uint64](n)
    elif kind == FS_KIND_PROC:
        prel: Ptr[uint8] = _proc_rel(rel)
        if prel[0] == 0:
            end = off + proc_listdir(at, cap - off)
        else:
            end = _list_add(buf, cap, end, "note")
            end = _list_add(buf, cap, end, "ns")
    elif kind == FS_KIND_DEVFS:
        if rel[0] == 0:
            end = _list_add(buf, cap, end, "console")
            end = _list_add(buf, cap, end, "null")
            end = _list_add(buf, cap, end, "zero")
        end = devtree_list(rel, buf, cap, end)
    elif kind == FS_KIND_ROM:
        ri: uint32 = 0
        while ri < rom_count():
            end = _list_add(buf, cap, end, rom_name(ri))
            ri = ri + 1
    elif kind == FS_KIND_SRV:
        si: uint32 = 0
        while si < SRV_MAX:
            if srv_name(si) != cast[Ptr[uint8]](0):
                end = _list_add(buf, cap, end, srv_name(si))
            si = si + 1
    elif kind == FS_KIND_9P:
        end = _p9_list(key, buf, cap, end)
    elif kind == FS_KIND_FD:
        num: Array[8, uint8]
        fi: uint32 = 0
        while fi < DEVFD_SLOTS:
            if current_thread()[0].fdn_kind[fi] != DEVFD_NONE:
                num[_put_dec(&num[0], 0, fi)] = 0
                end = _list_add(buf, cap, end, &num[0])
            fi = fi + 1
    if off == 0:
        return end
    return _dedupe(buf, off, end)


# Open a directory for reading: a snapshot of its listing.  For a name in the
# namespace (canon != "") that is the listing of EVERY union member that has
# the directory, in search order, each name once, and then the mount points
# directly below it (Hamnix lists only the first member; Plan 9 lists all).
# `key` is then used as scratch space.
def _open_dir(canon: Ptr[uint8], key: Ptr[uint8]) -> int32:
    buf: uint64 = kmalloc(VFS_DIRBUF)
    if buf == 0:
        return _err(ENOMEM, "out of memory")
    bp: Ptr[uint8] = cast[Ptr[uint8]](buf)
    n: uint64 = 0
    if canon[0] == 0:
        n = _list_key(key, bp, VFS_DIRBUF, 0)
    else:
        g: uint32 = _nsg()
        nth: uint32 = 0
        while ns_walk(g, canon, key, VFS_PATH_MAX - 4, nth, cast[Ptr[uint32]](0)) == 1:
            if _spec_inplace(key) == 0 and _key_kind(key) == 2:
                n = _list_key(key, bp, VFS_DIRBUF, n)
            nth = nth + 1
        n = ns_children(g, canon, bp, VFS_DIRBUF, n)
    # keep only what the listing needs while the directory is open
    if n + 256 < VFS_DIRBUF:
        small: uint64 = kmalloc(n + 1)
        if small != 0:
            rt_memcpy(small, buf, n)
            kfree(buf)
            buf = small
    mutex_lock(&fs_lock)
    fd: int32 = _install(OF_DIR, 0, OREAD, buf, n)
    mutex_unlock(&fs_lock)
    if fd < 0:
        kfree(buf)
    return fd


# ---------------------------------------------------------------- 9P mounts
# A key "/#M<n>" or "/#M<n>/a/b": connection n and the path on its server.
# Takes a reference to the connection for the time of the operation
# (_p9_end drops it), so that an unmount by another process cannot close it
# under the caller.  Returns n, or -1 when there is no such connection.
def _p9_begin(key: Ptr[uint8], rel: Ptr[Ptr[uint8]]) -> int32:
    n: uint32 = 0
    i: uint32 = 3
    if key[3] < 48 or key[3] > 57:
        return -1
    while key[i] >= 48 and key[i] <= 57 and n < 1000:
        n = n * 10 + cast[uint32](key[i]) - 48
        i = i + 1
    if key[i] != 0 and key[i] != 47:
        return -1
    if p9c_get(cast[uint64](n)) < 0:
        return -1
    rel[0] = cast[Ptr[uint8]](cast[uint64](key) + cast[uint64](i))
    return cast[int32](n)


def _p9_end(n: int32):
    p9c_put(cast[uint64](n))


# What _close_index hands back for a 9P file: the fid to clunk and the
# connection reference to drop, once fs_lock is released (a request to a
# server must never be made under it: the server may be a process that
# needs the file system to answer).
def _p9_token(conn: int32, fid: uint64) -> uint64:
    return ((cast[uint64](conn) + 1) << 32) | fid


def _p9_finish(tok: uint64, tell: uint32):
    if tok == 0:
        return
    conn: uint32 = cast[uint32](tok >> 32) - 1
    if tell != 0:
        p9c_clunk(conn, cast[uint32](tok))
    else:
        p9c_forget(conn, cast[uint32](tok))
    p9c_put(cast[uint64](conn))


# The names in a 9P directory, appended to buf[0..off) as "NAME\n" lines.
def _p9_list(key: Ptr[uint8], buf: Ptr[uint8], cap: uint64, off: uint64) -> uint64:
    rel: Ptr[uint8] = cast[Ptr[uint8]](0)
    conn: int32 = _p9_begin(key, &rel)
    if conn < 0:
        return off
    qt: uint32 = 0
    fid: int32 = p9c_walk(cast[uint32](conn), rel, 0, cast[Ptr[uint32]](0), &qt)
    if fid >= 0:
        tmp: uint64 = kmalloc(512)
        if tmp != 0 and p9c_open(cast[uint32](conn), cast[uint32](fid), 0) == 0:
            tp: Ptr[uint8] = cast[Ptr[uint8]](tmp)
            pos: uint64 = 0
            n: int64 = p9c_read(cast[uint32](conn), cast[uint32](fid), pos, tp, 512)
            while n > 2:
                # whole stat records: size[2], 39 bytes of fixed fields
                # (type dev qid mode atime mtime length), then name[s]
                o: uint64 = 0
                while o + 43 <= cast[uint64](n):
                    sz: uint64 = cast[uint64](tp[o]) | (cast[uint64](tp[o + 1]) << 8)
                    nl: uint64 = cast[uint64](tp[o + 41]) | (cast[uint64](tp[o + 42]) << 8)
                    if o + 2 + sz > cast[uint64](n) or sz < 41 + nl:
                        break
                    if off + nl + 1 <= cap:
                        rt_memcpy(cast[uint64](buf) + off, tmp + o + 43, nl)
                        buf[off + nl] = 10
                        off = off + nl + 1
                    o = o + 2 + sz
                if o == 0:
                    break
                pos = pos + o
                n = p9c_read(cast[uint32](conn), cast[uint32](fid), pos, tp, 512)
        if tmp != 0:
            kfree(tmp)
        p9c_clunk(cast[uint32](conn), cast[uint32](fid))
    _p9_end(conn)
    return off


# Open (or create) a file on a 9P server.  fs_lock is not held.  Returns the
# index of a new entry of the open-file table (one reference, no descriptor
# yet), or a negative errno.
def _p9_open_idx(key: Ptr[uint8], mode: uint32) -> int32:
    rel: Ptr[uint8] = cast[Ptr[uint8]](0)
    conn: int32 = _p9_begin(key, &rel)
    if conn < 0:
        return _err(-5, "9P: the server has gone")
    cu: uint32 = cast[uint32](conn)
    qt: uint32 = 0
    last: uint32 = 0
    pm: uint32 = mode & 3
    if (mode & OTRUNC) != 0:
        pm = pm | 0x10
    fid: int32 = p9c_walk(cu, rel, 0, cast[Ptr[uint32]](0), &qt)
    rc: int32 = 0
    pos: uint64 = 0
    if fid == ENOENT and (mode & OCREATE) != 0:
        fid = p9c_walk(cu, rel, 1, &last, &qt)
        if fid >= 0:
            nm: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](rel) + cast[uint64](last))
            if last == 0:
                rc = _err(EEXIST, "file exists")
            else:
                rc = p9c_create(cu, cast[uint32](fid), nm, _slen(nm), 0x1A4, mode & 3)
    elif fid >= 0:
        if (qt & 0x80) != 0:
            rc = _err(EISDIR, "is a directory")
        else:
            rc = p9c_open(cu, cast[uint32](fid), pm)
            if rc == 0 and (mode & OAPPEND) != 0:
                # writing starts at the end the file has now
                st: Array[128, uint8]
                if p9c_stat(cu, cast[uint32](fid), &st[0], 128) >= 41:
                    pos = cast[uint64](_get32(&st[0], 33))
    if fid < 0:
        _p9_end(conn)
        return fid
    if rc == 0:
        mutex_lock(&fs_lock)
        i: int32 = 0
        while i < cast[int32](VFS_NR_OPEN) and ofiles[i].refs != 0:
            i = i + 1
        if i == cast[int32](VFS_NR_OPEN):
            rc = _err(EMFILE, "too many open files")
        else:
            ofiles[i].refs = 1
            ofiles[i].kind = OF_9P
            ofiles[i].slot = conn
            ofiles[i].mode = mode & 3
            ofiles[i].pos = pos
            ofiles[i].dirbuf = 0
            ofiles[i].dirlen = 0
            ofiles[i].aux0 = cast[uint64](fid)
            rc = i
        mutex_unlock(&fs_lock)
    if rc < 0:
        p9c_clunk(cu, cast[uint32](fid))
        _p9_end(conn)                   # an open file keeps the reference
    return rc


# ... and give it a descriptor.
def _p9_open(key: Ptr[uint8], mode: uint32) -> int32:
    idx: int32 = _p9_open_idx(key, mode)
    if idx < 0:
        return idx
    t: Ptr[Thread] = current_thread()
    mutex_lock(&fs_lock)
    fd: int32 = 0
    while fd < cast[int32](VFS_NR_FDS) and t[0].fd[fd] >= 0:
        fd = fd + 1
    tok: uint64 = 0
    if fd == cast[int32](VFS_NR_FDS):
        tok = _close_index(idx)
        fd = _err(EMFILE, "too many open files")
    else:
        t[0].fd[fd] = idx
    mutex_unlock(&fs_lock)
    _p9_finish(tok, 1)
    return fd


# ---- a 9P file as a channel (a redirection: `cmd < /n/x/f`, `>`, `>>`) ----
# vfs_openchan hands out CHAN_INLINE_TAG | CHAN_OF | index for a file on a 9P
# server: an entry of the open-file table that no descriptor refers to yet.
# Its one reference waits in chan_pend for the opener to bind it at an /fd
# name (the shell does that at once); every name it is then bound at, in any
# process, holds a reference, and the last one to go clunks the fid.  A
# channel the opener never binds is closed at its next openchan or when it
# ends.
class ChanPend:
    tid: uint32
    idx: int32


CHAN_PEND: uint32 = 4
chan_pend: Array[4, ChanPend]


def _chan_drop(idx: int32, tell: uint32):
    mutex_lock(&fs_lock)
    tok: uint64 = _close_index(idx)
    mutex_unlock(&fs_lock)
    _p9_finish(tok, tell)


# Close what `tid` opened and never bound.
def _chan_pend_reap(tid: uint32, tell: uint32):
    i: uint32 = 0
    while i < CHAN_PEND:
        if chan_pend[i].tid == tid:
            chan_pend[i].tid = 0
            _chan_drop(chan_pend[i].idx, tell)
        i = i + 1


# Take the waiting reference of channel idx if `tid` (or `alt`) opened it.
def _chan_pend_take(tid: uint32, alt: uint32, idx: int32) -> uint32:
    i: uint32 = 0
    while i < CHAN_PEND:
        if chan_pend[i].tid != 0 and chan_pend[i].idx == idx and (chan_pend[i].tid == tid or chan_pend[i].tid == alt):
            chan_pend[i].tid = 0
            return 1
        i = i + 1
    return 0


def _p9_openchan(key: Ptr[uint8], mode: int32) -> int32:
    me: uint32 = current_thread()[0].tid
    _chan_pend_reap(me, 1)
    m: uint32 = OREAD
    if mode == 1:
        m = OWRITE | OCREATE | OTRUNC
    elif mode == 2:
        m = OWRITE | OCREATE | OAPPEND
    idx: int32 = _p9_open_idx(key, m)
    if idx < 0:
        return idx
    i: uint32 = 0
    while i < CHAN_PEND and chan_pend[i].tid != 0:
        i = i + 1
    if i == CHAN_PEND:
        _chan_drop(idx, 1)
        return _err(EMFILE, "too many redirections waiting to be bound")
    chan_pend[i].idx = idx
    chan_pend[i].tid = me
    return CHAN_INLINE_TAG | CHAN_OF | idx


def _chan_is_of(kind: int32, arg: int32) -> uint32:
    if kind == DEVFD_CHAN and (arg & CHAN_OF) != 0:
        return 1
    return 0


# stat, remove and mkdir on a 9P server.
def _p9_stat(key: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    rel: Ptr[uint8] = cast[Ptr[uint8]](0)
    conn: int32 = _p9_begin(key, &rel)
    if conn < 0:
        return cast[int64](_err(-5, "9P: the server has gone"))
    qt: uint32 = 0
    r: int64 = cast[int64](p9c_walk(cast[uint32](conn), rel, 0, cast[Ptr[uint32]](0), &qt))
    if r >= 0:
        fid: uint32 = cast[uint32](r)
        r = p9c_stat(cast[uint32](conn), fid, buf, nbuf)
        if r == -34:
            _err(ERANGE, "stat buffer too small")
        p9c_clunk(cast[uint32](conn), fid)
    _p9_end(conn)
    return r


def _p9_remove(key: Ptr[uint8]) -> int32:
    rel: Ptr[uint8] = cast[Ptr[uint8]](0)
    conn: int32 = _p9_begin(key, &rel)
    if conn < 0:
        return _err(-5, "9P: the server has gone")
    qt: uint32 = 0
    r: int32 = EBUSY
    if rel[0] == 0:
        _err(EBUSY, "cannot remove the root of a mount")
    else:
        r = p9c_walk(cast[uint32](conn), rel, 0, cast[Ptr[uint32]](0), &qt)
        if r >= 0:
            r = p9c_remove(cast[uint32](conn), cast[uint32](r))
    _p9_end(conn)
    return r


def _p9_mkdir(key: Ptr[uint8]) -> int32:
    rel: Ptr[uint8] = cast[Ptr[uint8]](0)
    conn: int32 = _p9_begin(key, &rel)
    if conn < 0:
        return _err(-5, "9P: the server has gone")
    qt: uint32 = 0
    last: uint32 = 0
    r: int32 = p9c_walk(cast[uint32](conn), rel, 1, &last, &qt)
    if r >= 0:
        fid: uint32 = cast[uint32](r)
        nm: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](rel) + cast[uint64](last))
        if last == 0:
            r = _err(EEXIST, "file exists")
        else:
            r = p9c_create(cast[uint32](conn), fid, nm, _slen(nm), DMDIR | 0x1ED, 0)
        p9c_clunk(cast[uint32](conn), fid)
    _p9_end(conn)
    return r


def _open_locked(canon: Ptr[uint8], mode: uint32) -> int32:
    kind: uint32 = _kind(canon)
    wants_write: uint32 = 0
    if (mode & 3) != OREAD or (mode & (OTRUNC | OCREATE | OAPPEND)) != 0:
        wants_write = 1
    if kind == FS_KIND_DEVFS:
        rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rel[0] == 0 or devtree_is_dir(rel) != 0:
            return _err(EISDIR, "is a directory")
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return _err(ENOENT, "file does not exist")
        return _install(OF_DEV, dev, mode & 3, 0, 0)
    if kind == FS_KIND_ROM:
        rrel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rrel[0] == 0:
            return _err(EISDIR, "is a directory")
        ridx: int32 = _rom_lookup(rrel)
        if ridx < 0:
            return _err(ENOENT, "file does not exist")
        if wants_write != 0:
            return _err(EROFS, "read-only file system")
        return _install(OF_ROM, ridx, OREAD, 0, 0)
    if kind == FS_KIND_FD:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if frel[0] == 0:
            return _err(EISDIR, "is a directory")
        fn: int32 = _fdname_number(frel)
        if fn < 0:
            return _err(ENOENT, "file does not exist")
        return _install(OF_FDNAME, fn, mode & 3, 0, 0)
    if kind == FS_KIND_FAT:
        return _fat_open(cast[Ptr[uint8]](vfs_fs_rel(_pc(canon))), mode, wants_write)
    if kind == FS_KIND_SRV:
        # opening /srv/NAME gives the posted end of the connection
        srp: int32 = 0
        swp: int32 = 0
        if srv_get(_proc_rel(cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))), &srp, &swp) < 0:
            return _err(ENOENT, "file does not exist")
        return _sock_install(srp, swp)
    if kind == FS_KIND_PROC:
        return _proc_open(cast[Ptr[uint8]](vfs_fs_rel(_pc(canon))), wants_write)
    if kind != FS_KIND_TMPFS:
        return _err(ENOENT, "no such device")
    if tmpfs_path_is_dir(_pc(canon)) != 0:
        return _err(EISDIR, "is a directory")
    slot: int32 = tmpfs_lookup(_pc(canon))
    if slot < 0:
        if (mode & OCREATE) == 0:
            return _err(ENOENT, "file does not exist")
        if _parent_is_dir(canon) == 0:
            return _err(ENOENT, "directory does not exist")
        slot = tmpfs_open_for_write_t(_pc(canon), 1)
        if slot < 0:
            return _err(slot, "cannot create file")
    elif (mode & OTRUNC) != 0:
        slot = tmpfs_open_for_write_t(_pc(canon), 1)
        if slot < 0:
            return _err(slot, "cannot truncate file")
    return _install(OF_FILE, slot, mode & (3 | OAPPEND), 0, 0)


def vfs_open(path: Ptr[uint8], mode: uint32) -> int32:
    canon: Array[256, uint8]
    key: Array[256, uint8]
    intent: uint32 = RES_LOOKUP
    if (mode & OCREATE) != 0:
        intent = RES_CREATE
    elif (mode & 3) != OREAD or (mode & (OTRUNC | OAPPEND)) != 0:
        intent = RES_CHANGE
    rc: int32 = _resolve(path, &key[0], &canon[0], intent)
    k: uint32 = 0
    if rc == 0:
        k = _key_kind(&key[0])
    if k == 2 or (k == 0 and _ns_synth(&canon[0]) != 0):
        if intent != RES_LOOKUP:
            return _err(EISDIR, "is a directory")
        return _open_dir(&canon[0], &key[0])
    if rc < 0:
        return rc
    if _kind(&key[0]) == FS_KIND_9P:
        return _p9_open(&key[0], mode)
    mutex_lock(&fs_lock)
    fd: int32 = _open_locked(&key[0], mode)
    mutex_unlock(&fs_lock)
    return fd


# Drop a reference to an open file.  fs_lock is held.  For the last
# reference to a 9P file the result is what _p9_finish needs once the lock is
# released; otherwise 0.
def _close_index(idx: int32) -> uint64:
    tok: uint64 = 0
    ofiles[idx].refs = ofiles[idx].refs - 1
    if ofiles[idx].refs == 0:
        if ofiles[idx].dirbuf != 0:
            kfree(ofiles[idx].dirbuf)
            ofiles[idx].dirbuf = 0
        if ofiles[idx].kind == OF_SOCK:
            pipe_close_reader(cast[int32](ofiles[idx].aux0))
            pipe_close_writer(cast[int32](ofiles[idx].aux1))
        elif ofiles[idx].kind == OF_9P:
            tok = _p9_token(ofiles[idx].slot, ofiles[idx].aux0)
        ofiles[idx].kind = 0
    return tok


# A new descriptor for the socket end that reads pipe rp and writes pipe wp;
# the descriptor holds a reference to each.  fs_lock is held.
def _sock_install(rp: int32, wp: int32) -> int32:
    fd: int32 = _install(OF_SOCK, 0, ORDWR, 0, 0)
    if fd >= 0:
        f: Ptr[OpenFile] = _fd_file(fd)
        f[0].aux0 = cast[uint64](rp)
        f[0].aux1 = cast[uint64](wp)
        pipe_inc_reader(rp)
        pipe_inc_writer(wp)
    return fd


def vfs_close(fd: int32) -> int32:
    if fd < 0 or fd >= cast[int32](VFS_NR_FDS):
        return _err(EBADF, "close: bad fd")
    t: Ptr[Thread] = current_thread()
    mutex_lock(&fs_lock)
    idx: int32 = t[0].fd[fd]
    if idx < 0:
        mutex_unlock(&fs_lock)
        return _err(EBADF, "close: bad fd")
    t[0].fd[fd] = -1
    tok: uint64 = _close_index(idx)
    mutex_unlock(&fs_lock)
    _p9_finish(tok, 1)
    return 0


# ---------------------------------------------------------------- /fd names
# Read through /fd/<fdn> of the calling process.  fs_lock not held.
def _fdn_read(fdn: int32, buf: Ptr[uint8], n: uint64, nonblock: uint32) -> int64:
    t: Ptr[Thread] = current_thread()
    kind: int32 = t[0].fdn_kind[fdn]
    arg: int32 = t[0].fdn_arg[fdn]
    if kind == DEVFD_CONS:
        return console_read(buf, n, nonblock)
    if kind == DEVFD_PIPE_R:
        return pipe_read(arg, buf, n, nonblock)
    got: uint64 = 0
    if kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        mutex_lock(&fs_lock)
        got = tmpfs_read(arg, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + got
        mutex_unlock(&fs_lock)
    elif _chan_is_of(kind, arg) != 0:
        # a file on a 9P server; the position is the open file's, shared by
        # every name it is bound at
        of: Ptr[OpenFile] = &ofiles[arg & 0xFFFF]
        pr: int64 = p9c_read(cast[uint32](of[0].slot), cast[uint32](of[0].aux0), of[0].pos, buf, n)
        if pr > 0:
            of[0].pos = of[0].pos + cast[uint64](pr)
        if pr == 0 and nonblock != 0:
            return -1
        return pr
    elif kind == DEVFD_CHAN and (arg & CHAN_ROM) != 0:
        got = _rom_read(arg & 0xFFFF, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + got
    elif kind == DEVFD_CHAN and (arg & 0xFFFF) == DEV_CONSOLE:
        return console_read(buf, n, nonblock)
    elif kind == DEVFD_CHAN and (arg & 0xFFFF) == DEV_ZERO:
        rt_memset(cast[uint64](buf), 0, n)
        return cast[int64](n)
    elif kind == DEVFD_CHAN and (arg & 0xFFFF) >= DEV_TREE:
        tr: int64 = _tree_io(arg & 0xFFFF, 0, buf, n, t[0].fdn_pos[fdn])
        if tr > 0:
            t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + cast[uint64](tr)
        if tr == 0 and nonblock != 0:
            return -1
        return tr
    elif kind != DEVFD_CHAN:
        return cast[int64](_err(EBADF, "read: nothing readable is bound at this /fd name"))
    if got == 0 and nonblock != 0:
        return -1
    return cast[int64](got)


def _fdn_write(fdn: int32, buf: Ptr[uint8], n: uint64) -> int64:
    t: Ptr[Thread] = current_thread()
    kind: int32 = t[0].fdn_kind[fdn]
    arg: int32 = t[0].fdn_arg[fdn]
    if kind == DEVFD_CONS:
        console_write(buf, n)
        return cast[int64](n)
    if kind == DEVFD_PIPE_W:
        # A child of rfork that has not exec'ed runs while its parent is
        # suspended; if the parent is the one who would start the reader, a
        # full pipe would never drain.  Such a writer is not put to sleep.
        nb: uint32 = 0
        if (t[0].pflags & PF_VFORK) != 0:
            nb = 1
        r: int64 = pipe_write(arg, buf, n, nb)
        if r == -11:
            set_current_errstr("pipe full: a stage that runs inside the shell cannot write more than the pipe holds")
        elif r == -32:
            set_current_errstr("write: pipe has no reader")
        return r
    if kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        mutex_lock(&fs_lock)
        if kind == DEVFD_FILE_APPEND:
            t[0].fdn_pos[fdn] = tmpfs_size(arg)
        w: uint64 = tmpfs_write(arg, buf, t[0].fdn_pos[fdn], n)
        t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + w
        mutex_unlock(&fs_lock)
        if w == 0 and n != 0:
            return cast[int64](_err(ENOSPC, "tmpfs: no space"))
        return cast[int64](w)
    if _chan_is_of(kind, arg) != 0:
        of: Ptr[OpenFile] = &ofiles[arg & 0xFFFF]
        if (of[0].mode & 3) == OREAD:
            return cast[int64](_err(EBADF, "write: not open for writing"))
        pw: int64 = p9c_write(cast[uint32](of[0].slot), cast[uint32](of[0].aux0), of[0].pos, buf, n)
        if pw > 0:
            of[0].pos = of[0].pos + cast[uint64](pw)
        return pw
    if kind == DEVFD_CHAN and (arg & CHAN_DEV) != 0:
        if (arg & 0xFFFF) == DEV_CONSOLE:
            console_write(buf, n)
        elif (arg & 0xFFFF) >= DEV_TREE:
            tw: int64 = _tree_io(arg & 0xFFFF, 1, buf, n, t[0].fdn_pos[fdn])
            if tw > 0:
                t[0].fdn_pos[fdn] = t[0].fdn_pos[fdn] + cast[uint64](tw)
            return tw
        return cast[int64](n)
    return cast[int64](_err(EBADF, "write: nothing writable is bound at this /fd name"))


# Is descriptor `fd` of the caller a pipe end right now?
def vfs_fd_is_pipe(fd: int32) -> uint32:
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0) or f[0].kind != OF_FDNAME:
        return 0
    k: int32 = current_thread()[0].fdn_kind[f[0].slot]
    if k == DEVFD_PIPE_R or k == DEVFD_PIPE_W:
        return 1
    return 0


# ---- who may bind what ------------------------------------------------
# fdbind takes slot numbers, and a number can be guessed.  So a process may
# bind only what it holds:
#   a pipe    it created with pipechan, or has bound at one of its own names
#             (that is how a child comes by one: the names are inherited);
#   a file    it opened with openchan (a grant, below), or has bound already.
# A child of rfork that has not exec'ed counts as its parent: it is the
# parent's program running on the parent's memory.  Kernel threads and the
# unprivileged threads of the kernel image (the tests) are not restricted.
#
# A grant is (process, tmpfs slot).  It lasts until the process ends or the
# file is removed; the table is small and the oldest entry is overwritten
# when it is full, so a grant should be used soon (the shell binds right
# after openchan).
class ChanGrant:
    tid: uint32
    slot: int32


GRANT_MAX: uint32 = 32
grants: Array[32, ChanGrant]
grant_next: uint32 = 0
fdbind_refused: uint64 = 0          # binds refused by these rules (statistics)


def _grant_add(tid: uint32, slot: int32):
    irq: uint32 = cpu_irq_save()
    i: uint32 = 0
    free: uint32 = GRANT_MAX
    while i < GRANT_MAX:
        if grants[i].tid == tid and grants[i].slot == slot:
            cpu_irq_restore(irq)
            return
        if grants[i].tid == 0 and free == GRANT_MAX:
            free = i
        i = i + 1
    if free == GRANT_MAX:
        free = grant_next
        grant_next = (grant_next + 1) % GRANT_MAX
    grants[free].tid = tid
    grants[free].slot = slot
    cpu_irq_restore(irq)


def _grant_has(tid: uint32, slot: int32) -> uint32:
    i: uint32 = 0
    while i < GRANT_MAX:
        if grants[i].tid == tid and grants[i].slot == slot:
            return 1
        i = i + 1
    return 0


# Forget the grants of a process that has ended (slot < 0), or every grant
# for a file that has been removed (tid 0).
def _grant_drop(tid: uint32, slot: int32):
    irq: uint32 = cpu_irq_save()
    i: uint32 = 0
    while i < GRANT_MAX:
        if (slot < 0 and grants[i].tid == tid) or (slot >= 0 and grants[i].slot == slot):
            grants[i].tid = 0
        i = i + 1
    cpu_irq_restore(irq)


def _fdn_holds(t: Ptr[Thread], pipe: uint32, arg: int32) -> uint32:
    n: uint32 = 0
    while n < DEVFD_SLOTS:
        k: int32 = t[0].fdn_kind[n]
        if t[0].fdn_arg[n] == arg:
            if pipe != 0 and (k == DEVFD_PIPE_R or k == DEVFD_PIPE_W):
                return 1
            if pipe == 0 and (k == DEVFD_FILE or k == DEVFD_FILE_APPEND):
                return 1
            if pipe == 2 and k == DEVFD_CHAN:
                return 1
        n = n + 1
    return 0


# May `me` bind pipe slot / tmpfs slot `arg`?
def _may_bind(me: Ptr[Thread], pipe: uint32, arg: int32) -> uint32:
    if (me[0].flags & TF_PROC) == 0:
        return 1
    who: uint32 = me[0].tid
    alt: uint32 = 0
    if (me[0].pflags & PF_VFORK) != 0:
        alt = me[0].ppid
    if pipe != 0:
        o: uint32 = pipe_owner(arg)
        if o != 0 and (o == who or o == alt):
            return 1
    else:
        if _grant_has(who, arg) != 0 or (alt != 0 and _grant_has(alt, arg) != 0):
            return 1
    if _fdn_holds(me, pipe, arg) != 0:
        return 1
    if alt != 0:
        par: Ptr[Thread] = thread_by_tid(alt)
        if par != cast[Ptr[Thread]](0) and _fdn_holds(par, pipe, arg) != 0:
            return 1
    fdbind_refused = fdbind_refused + 1
    return 0


# Drop what /fd/<n> of `t` is bound to.
def _fdn_release(t: Ptr[Thread], n: uint32, tell: uint32):
    kind: int32 = t[0].fdn_kind[n]
    arg: int32 = t[0].fdn_arg[n]
    t[0].fdn_kind[n] = DEVFD_NONE
    t[0].fdn_arg[n] = 0
    t[0].fdn_pos[n] = 0
    if kind == DEVFD_PIPE_R:
        pipe_close_reader(arg)
    elif kind == DEVFD_PIPE_W:
        pipe_close_writer(arg)
    elif _chan_is_of(kind, arg) != 0:
        _chan_drop(arg & 0xFFFF, tell)


# Bind /fd/<fdnum> of process `pid` (0 = the caller).  The caller may bind
# its own names and those of its children.  kind is a DEVFD_* value.
def vfs_fdbind(pid: int32, fdnum: int32, kind: int32, arg: int32) -> int32:
    me: Ptr[Thread] = current_thread()
    t: Ptr[Thread] = me
    if fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return _err(EINVAL, "fdbind: no such /fd name")
    if pid != 0 and cast[uint32](pid) != me[0].tid:
        t = thread_by_tid(cast[uint32](pid))
        if t == cast[Ptr[Thread]](0) or t[0].ppid != me[0].tid:
            return _err(ESRCH, "fdbind: not a child of the caller")
    n: uint32 = cast[uint32](fdnum)
    pos: uint64 = 0
    dup: uint32 = 0                     # a dup copies what the target already holds
    ofref: uint32 = 0                   # the new name takes a reference to an open-file entry
    if kind == DEVFD_DUP:
        dup = 1
        if arg < 0 or arg >= cast[int32](DEVFD_SLOTS):
            return _err(EINVAL, "fdbind: no such /fd name to duplicate")
        if arg == fdnum:
            return 0
        src: int32 = arg
        kind = t[0].fdn_kind[arg]
        pos = t[0].fdn_pos[arg]
        arg = t[0].fdn_arg[arg]
        if kind == DEVFD_NONE:
            return _err(EBADF, "fdbind: nothing is bound at the name to duplicate")
        if kind == DEVFD_FILE:
            # `> file 2>&1`: two names on one file.  Each name has its own
            # position, so the two streams would overwrite each other;
            # both names are made to write at the end of the file instead,
            # which is what a shared position amounts to for writers.
            kind = DEVFD_FILE_APPEND
            t[0].fdn_kind[src] = DEVFD_FILE_APPEND
    if (kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND) and (arg & CHAN_INLINE_TAG) != 0:
        # what openchan returned says itself that it is not a tmpfs slot;
        # Hamnix's shell binds an appending redirection of a built-in
        # command as a file whatever it got
        kind = DEVFD_CHAN
    if kind == DEVFD_PIPE_R or kind == DEVFD_PIPE_W:
        if pipe_valid(arg) == 0:
            return _err(EBADF, "fdbind: no such pipe")
        if dup == 0 and _may_bind(me, 1, arg) == 0:
            return _err(EPERM, "fdbind: not a pipe of the caller")
    elif kind == DEVFD_FILE or kind == DEVFD_FILE_APPEND:
        if arg < 0 or arg >= cast[int32](TMPFS_MAX_FILES) or tmpfs_table[arg].used == 0 or tmpfs_is_dir(arg) != 0:
            return _err(EBADF, "fdbind: not an open file channel")
        if dup == 0 and _may_bind(me, 0, arg) == 0:
            return _err(EPERM, "fdbind: not a file the caller has opened")
    elif kind == DEVFD_CHAN:
        # exactly the values vfs_openchan hands out, nothing a caller made up
        cok: uint32 = 0
        if (arg & (CHAN_INLINE_TAG | CHAN_OF | 0xFFFF)) == arg and (arg & CHAN_INLINE_TAG) != 0 and (arg & CHAN_OF) != 0:
            # a 9P file: the caller opened it just now (the waiting reference
            # becomes this name's), or holds it at a name already
            oi: int32 = arg & 0xFFFF
            if oi < cast[int32](VFS_NR_OPEN) and ofiles[oi].refs != 0 and ofiles[oi].kind == OF_9P:
                alt: uint32 = 0
                if (me[0].pflags & PF_VFORK) != 0:
                    alt = me[0].ppid
                if dup != 0:
                    cok = 1
                    ofref = 1
                elif _chan_pend_take(me[0].tid, alt, oi) != 0:
                    cok = 1
                elif _fdn_holds(me, 2, arg) != 0:
                    cok = 1
                    ofref = 1
        elif (arg & (CHAN_INLINE_TAG | CHAN_DEV | CHAN_ROM | 0xFFFF)) == arg and (arg & CHAN_INLINE_TAG) != 0:
            idx: int32 = arg & 0xFFFF
            if (arg & CHAN_DEV) != 0 and (arg & CHAN_ROM) == 0 and idx >= DEV_CONSOLE and idx <= DEV_ZERO:
                cok = 1
            if (arg & CHAN_DEV) != 0 and (arg & CHAN_ROM) == 0 and idx >= DEV_TREE and cast[uint32](idx - DEV_TREE) < dt_count:
                cok = 1
            if (arg & CHAN_ROM) != 0 and (arg & CHAN_DEV) == 0 and cast[uint32](idx) < rom_count():
                cok = 1
        if cok == 0:
            return _err(EBADF, "fdbind: not a device channel")
    elif kind != DEVFD_CONS and kind != DEVFD_NONE:
        return _err(EINVAL, "fdbind: unknown kind")
    # take the new reference before dropping the old one: rebinding the same
    # pipe end must not let its count touch zero
    if kind == DEVFD_PIPE_R:
        pipe_inc_reader(arg)
    elif kind == DEVFD_PIPE_W:
        pipe_inc_writer(arg)
    if ofref == 1:
        mutex_lock(&fs_lock)
        ofiles[arg & 0xFFFF].refs = ofiles[arg & 0xFFFF].refs + 1
        mutex_unlock(&fs_lock)
    _fdn_release(t, n, 1)
    t[0].fdn_kind[n] = kind
    t[0].fdn_arg[n] = arg
    t[0].fdn_pos[n] = pos
    return 0


def _fdn_target(pid: int32) -> Ptr[Thread]:
    if pid == 0:
        return current_thread()
    return thread_by_tid(cast[uint32](pid))


def vfs_fdslot_kind(pid: int32, fdnum: int32) -> int32:
    t: Ptr[Thread] = _fdn_target(pid)
    if t == cast[Ptr[Thread]](0) or fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return DEVFD_NONE
    return t[0].fdn_kind[fdnum]


def vfs_fdslot_arg(pid: int32, fdnum: int32) -> int32:
    t: Ptr[Thread] = _fdn_target(pid)
    if t == cast[Ptr[Thread]](0) or fdnum < 0 or fdnum >= cast[int32](DEVFD_SLOTS):
        return 0
    return t[0].fdn_arg[fdnum]


def vfs_pipechan() -> int32:
    slot: int32 = pipe_alloc_chan(current_thread()[0].tid)
    if slot < 0:
        return _err(EMFILE, "out of pipes or memory")
    return slot


# Open `path` as a channel that can be bound at an /fd name (a redirection).
# mode 0: an existing file, for reading; 1: create or truncate; 2: create if
# missing, keep the contents (for appending).  Returns a tmpfs slot, or a
# value with CHAN_INLINE_TAG for a device or a ROM file.
def vfs_openchan(path: Ptr[uint8], mode: int32) -> int32:
    canon: Array[256, uint8]
    nsname: Array[256, uint8]
    intent: uint32 = RES_LOOKUP
    if mode != 0:
        intent = RES_CREATE
    rc: int32 = _resolve(path, &canon[0], &nsname[0], intent)
    if rc < 0:
        return rc
    kind: uint32 = _kind(&canon[0])
    if kind == FS_KIND_9P:
        return _p9_openchan(&canon[0], mode)
    rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
    if kind == FS_KIND_DEVFS:
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return _err(ENOENT, "file does not exist")
        return CHAN_INLINE_TAG | CHAN_DEV | dev
    if kind == FS_KIND_ROM:
        idx: int32 = _rom_lookup(rel)
        if idx < 0:
            return _err(ENOENT, "file does not exist")
        if mode != 0:
            return _err(EROFS, "read-only file system")
        return CHAN_INLINE_TAG | CHAN_ROM | idx
    if kind != FS_KIND_TMPFS:
        return _err(EINVAL, "cannot redirect to this kind of file")
    mutex_lock(&fs_lock)
    slot: int32 = tmpfs_lookup(_pc(&canon[0]))
    if tmpfs_path_is_dir(_pc(&canon[0])) != 0:
        slot = _err(EISDIR, "is a directory")
    elif slot < 0:
        if mode == 0:
            slot = _err(ENOENT, "file does not exist")
        elif _parent_is_dir(&canon[0]) == 0:
            slot = _err(ENOENT, "directory does not exist")
        else:
            slot = tmpfs_open_for_write_t(_pc(&canon[0]), 1)
            if slot < 0:
                slot = _err(slot, "cannot create file")
    elif mode == 1:
        slot = tmpfs_open_for_write_t(_pc(&canon[0]), 1)
        if slot < 0:
            slot = _err(slot, "cannot truncate file")
    mutex_unlock(&fs_lock)
    if slot >= 0:
        _grant_add(current_thread()[0].tid, slot)       # the caller may bind it
    return slot


def vfs_read(fd: int32, buf: Ptr[uint8], n: uint64, nonblock: uint32) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: bad fd"))
    if f[0].kind == OF_DEV:
        dev: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        if dev == DEV_CONSOLE:
            return console_read(buf, n, nonblock)
        if dev == DEV_ZERO:
            rt_memset(cast[uint64](buf), 0, n)
            return cast[int64](n)
        if dev >= DEV_TREE:
            # the position belongs to the open file; this thread is its only
            # user while the call runs (a process is one thread)
            tr: int64 = _tree_io(dev, 0, buf, n, f[0].pos)
            if tr > 0:
                f[0].pos = f[0].pos + cast[uint64](tr)
            if tr == 0 and nonblock != 0:
                return -1
            return tr
        if nonblock != 0:
            return -1
        return 0
    if f[0].kind == OF_FDNAME:
        fdn: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        return _fdn_read(fdn, buf, n, nonblock)
    if f[0].kind == OF_SOCK:
        srp: int32 = cast[int32](f[0].aux0)
        mutex_unlock(&fs_lock)
        sr: int64 = pipe_read(srp, buf, n, nonblock)
        if sr == -4:
            return cast[int64](_err(-4, "interrupted"))
        return sr
    if f[0].kind == OF_9P:
        if (f[0].mode & 3) == OWRITE:
            mutex_unlock(&fs_lock)
            return cast[int64](_err(EBADF, "read: not open for reading"))
        mutex_unlock(&fs_lock)
        pr: int64 = p9c_read(cast[uint32](f[0].slot), cast[uint32](f[0].aux0), f[0].pos, buf, n)
        if pr > 0:
            f[0].pos = f[0].pos + cast[uint64](pr)
        if pr == 0 and nonblock != 0:
            return -1
        return pr
    if (f[0].mode & 3) == OWRITE:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: not open for reading"))
    got: uint64 = 0
    if f[0].kind == OF_ROM:
        got = _rom_read(f[0].slot, buf, f[0].pos, n)
    elif f[0].kind == OF_FAT:
        fr: int64 = fat_read(f[0].aux0, f[0].aux1, f[0].pos, n, buf)
        if fr > 0:
            got = cast[uint64](fr)
    elif f[0].kind == OF_FATW:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "read: not open for reading"))
    elif f[0].kind == OF_DIR:
        if f[0].pos < f[0].dirlen:
            got = f[0].dirlen - f[0].pos
            if got > n:
                got = n
            rt_memcpy(cast[uint64](buf), f[0].dirbuf + f[0].pos, got)
    else:
        got = tmpfs_read(f[0].slot, buf, f[0].pos, n)
    f[0].pos = f[0].pos + got
    mutex_unlock(&fs_lock)
    if got == 0 and nonblock != 0:
        return -1
    return cast[int64](got)


def vfs_write(fd: int32, buf: Ptr[uint8], n: uint64) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "write: bad fd"))
    if f[0].kind == OF_DEV:
        dev: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        if dev == DEV_CONSOLE:
            console_write(buf, n)
        elif dev >= DEV_TREE:
            tw: int64 = _tree_io(dev, 1, buf, n, f[0].pos)
            if tw > 0:
                f[0].pos = f[0].pos + cast[uint64](tw)
            return tw
        return cast[int64](n)
    if f[0].kind == OF_FDNAME:
        fdn: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        return _fdn_write(fdn, buf, n)
    if f[0].kind == OF_SOCK:
        swp: int32 = cast[int32](f[0].aux1)
        mutex_unlock(&fs_lock)
        sw: int64 = pipe_write(swp, buf, n, 0)
        if sw == -32:
            return cast[int64](_err(-32, "write: the other end is closed"))
        if sw == -4:
            return cast[int64](_err(-4, "interrupted"))
        return sw
    if f[0].kind == OF_9P:
        if (f[0].mode & 3) == OREAD:
            mutex_unlock(&fs_lock)
            return cast[int64](_err(EBADF, "write: not open for writing"))
        mutex_unlock(&fs_lock)
        pw: int64 = p9c_write(cast[uint32](f[0].slot), cast[uint32](f[0].aux0), f[0].pos, buf, n)
        if pw > 0:
            f[0].pos = f[0].pos + cast[uint64](pw)
        return pw
    if f[0].kind == OF_PROCW:
        pslot: int32 = f[0].slot
        mutex_unlock(&fs_lock)
        prc: int32 = 0
        if pslot == -3:
            prc = proc_keys(buf, n)
            if prc == -19:
                return cast[int64](_err(EINVAL, "keys: no emulated keyboard on this board"))
        elif pslot == -2:
            prc = power_ctl(buf, n)
        elif pslot < 0:
            prc = proc_set_time(buf, n)
        else:
            prc = proc_note(cast[uint32](pslot), buf, n)
        if prc == -3:
            return cast[int64](_err(ESRCH, "note: no such process"))
        if prc < 0:
            return cast[int64](_err(EINVAL, "write: not understood (notes: kill, interrupt, hangup, term; realtime: seconds since 1970)"))
        return cast[int64](n)
    if f[0].kind == OF_FATW:
        fw: int64 = fat_write(_pc(cast[Ptr[uint8]](f[0].dirbuf)), buf, f[0].pos, n)
        if fw > 0:
            f[0].pos = f[0].pos + cast[uint64](fw)
            if f[0].pos > f[0].aux1:
                f[0].aux1 = f[0].pos
        mutex_unlock(&fs_lock)
        if fw <= 0 and n != 0:
            return cast[int64](_err(ENOSPC, "FAT: write failed (volume full?)"))
        return fw
    if f[0].kind != OF_FILE or (f[0].mode & 3) == OREAD:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "write: not open for writing"))
    if (f[0].mode & OAPPEND) != 0:
        f[0].pos = tmpfs_size(f[0].slot)
    w: uint64 = tmpfs_write(f[0].slot, buf, f[0].pos, n)
    f[0].pos = f[0].pos + w
    mutex_unlock(&fs_lock)
    if w == 0 and n != 0:
        return cast[int64](_err(ENOSPC, "tmpfs: no space"))
    return cast[int64](w)


# Where a /bin file's bytes are, if `fd` is one: the ROM table is in the
# kernel image, readable in place (the loader runs a program's code from
# there on a board whose programs execute in place, kernel/proc.ad).  0 for
# any other kind of file.
def vfs_rom_addr(fd: int32) -> uint64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    a: uint64 = 0
    if f != cast[Ptr[OpenFile]](0) and f[0].kind == OF_ROM:
        a = rom_data(cast[uint32](f[0].slot))
    mutex_unlock(&fs_lock)
    return a


def vfs_lseek(fd: int32, off: int64, whence: uint32) -> int64:
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EBADF, "lseek: bad fd"))
    if (f[0].kind == OF_DEV and (f[0].slot < DEV_TREE or whence == SEEK_END)) or f[0].kind == OF_FDNAME or f[0].kind == OF_SOCK:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(ESPIPE, "lseek: not seekable"))
    if f[0].kind == OF_9P and whence == SEEK_END:
        # the length is the server's to say
        st: Array[128, uint8]
        mutex_unlock(&fs_lock)
        sl: int64 = p9c_stat(cast[uint32](f[0].slot), cast[uint32](f[0].aux0), &st[0], 128)
        if sl < 41:
            return cast[int64](_err(ESPIPE, "lseek: the server gives no length"))
        f[0].pos = cast[uint64](cast[int64](_get32(&st[0], 33)) + off)
        return cast[int64](f[0].pos)
    base: int64 = 0
    if whence == SEEK_CUR:
        base = cast[int64](f[0].pos)
    elif whence == SEEK_END:
        if f[0].kind == OF_DIR:
            base = cast[int64](f[0].dirlen)
        elif f[0].kind == OF_ROM:
            base = cast[int64](rom_size(cast[uint32](f[0].slot)))
        elif f[0].kind == OF_FAT or f[0].kind == OF_FATW:
            base = cast[int64](f[0].aux1)
        else:
            base = cast[int64](tmpfs_size(f[0].slot))
    elif whence != SEEK_SET:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EINVAL, "lseek: bad whence"))
    np: int64 = base + off
    if np < 0:
        mutex_unlock(&fs_lock)
        return cast[int64](_err(EINVAL, "lseek: negative offset"))
    f[0].pos = cast[uint64](np)
    mutex_unlock(&fs_lock)
    return np


def vfs_dup2(oldfd: int32, newfd: int32) -> int32:
    t: Ptr[Thread] = current_thread()
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(oldfd)
    if f == cast[Ptr[OpenFile]](0):
        mutex_unlock(&fs_lock)
        return _err(EBADF, "dup: bad fd")
    if newfd < 0:
        newfd = 0
        while newfd < cast[int32](VFS_NR_FDS) and t[0].fd[newfd] >= 0:
            newfd = newfd + 1
    if newfd >= cast[int32](VFS_NR_FDS):
        mutex_unlock(&fs_lock)
        return _err(EMFILE, "dup: no free fd")
    tok: uint64 = 0
    if newfd != oldfd:
        if t[0].fd[newfd] >= 0:
            tok = _close_index(t[0].fd[newfd])
        t[0].fd[newfd] = t[0].fd[oldfd]
        f[0].refs = f[0].refs + 1
    mutex_unlock(&fs_lock)
    _p9_finish(tok, 1)
    return newfd


def vfs_dup(oldfd: int32) -> int32:
    return vfs_dup2(oldfd, -1)


def vfs_mkdir(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    nsname: Array[256, uint8]
    rc: int32 = _resolve(path, &canon[0], &nsname[0], RES_CREATE)
    if rc < 0:
        return rc
    if _kind(&canon[0]) == FS_KIND_9P:
        return _p9_mkdir(&canon[0])
    if _kind(&canon[0]) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    mutex_lock(&fs_lock)
    if tmpfs_path_exists(_pc(&canon[0])) != 0:
        rc = _err(EEXIST, "file exists")
    elif _parent_is_dir(&canon[0]) == 0:
        rc = _err(ENOENT, "directory does not exist")
    else:
        rc = tmpfs_mkdir(_pc(&canon[0]))
    mutex_unlock(&fs_lock)
    return rc


# Remove a file or an empty directory.  A file that is open cannot be removed
# (EBUSY): tmpfs keeps no open count and would recycle the slot under the
# descriptor.  This differs from POSIX.
def vfs_unlink(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    nsname: Array[256, uint8]
    rc: int32 = _resolve(path, &canon[0], &nsname[0], RES_CHANGE)
    if rc < 0:
        return rc
    if _kind(&canon[0]) == FS_KIND_FAT and fat_mounted != 0:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0])))
        mutex_lock(&fs_lock)
        if _fat_is_dir(frel) != 0:
            rc = _err(EISDIR, "FAT: removing a directory is not supported")
        elif fat_delete(_pc(frel)) != 0:
            rc = _err(ENOENT, "file does not exist")
        mutex_unlock(&fs_lock)
        return rc
    if _kind(&canon[0]) == FS_KIND_9P:
        return _p9_remove(&canon[0])
    if _kind(&canon[0]) == FS_KIND_SRV:
        if srv_remove(_proc_rel(cast[Ptr[uint8]](vfs_fs_rel(_pc(&canon[0]))))) < 0:
            return _err(ENOENT, "file does not exist")
        return 0
    if _kind(&canon[0]) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    if _is_troot(&canon[0]) != 0:
        return _err(EBUSY, "cannot remove the root directory")
    mutex_lock(&fs_lock)
    slot: int32 = tmpfs_lookup(_pc(&canon[0]))
    if slot < 0:
        rc = _err(ENOENT, "file does not exist")
    elif _slot_is_open(slot) != 0:
        rc = _err(EBUSY, "file is open")
    else:
        isdir: int32 = tmpfs_is_dir(slot)
        rc = tmpfs_unlink(_pc(&canon[0]))
        if rc == 0:
            _grant_drop(0, slot)        # the slot may become another file
        if rc == EEXIST and isdir != 0:
            rc = _err(ENOTEMPTY, "directory not empty")
    mutex_unlock(&fs_lock)
    return rc


def vfs_rename(oldpath: Ptr[uint8], newpath: Ptr[uint8]) -> int32:
    co: Array[256, uint8]
    cn: Array[256, uint8]
    nsname: Array[256, uint8]
    rc: int32 = _resolve(oldpath, &co[0], &nsname[0], RES_CHANGE)
    if rc == 0:
        rc = _resolve(newpath, &cn[0], &nsname[0], RES_CREATE)
    if rc < 0:
        return rc
    if _kind(&co[0]) != FS_KIND_TMPFS or _kind(&cn[0]) != FS_KIND_TMPFS:
        return _err(EROFS, "read-only file system")
    if _is_troot(&co[0]) != 0 or _is_troot(&cn[0]) != 0:
        return _err(EBUSY, "cannot rename the root directory")
    mutex_lock(&fs_lock)
    if tmpfs_path_exists(_pc(&co[0])) == 0:
        rc = _err(ENOENT, "file does not exist")
    elif _parent_is_dir(&cn[0]) == 0:
        rc = _err(ENOENT, "directory does not exist")
    elif tmpfs_path_is_dir(_pc(&cn[0])) != 0:
        rc = _err(EISDIR, "target is a directory")
    else:
        ns: int32 = tmpfs_lookup(_pc(&cn[0]))
        if ns >= 0 and _slot_is_open(ns) != 0:
            rc = _err(EBUSY, "target is open")
        else:
            rc = tmpfs_rename(_pc(&co[0]), _pc(&cn[0]))
    mutex_unlock(&fs_lock)
    return rc


def _get32(b: Ptr[uint8], off: uint32) -> uint32:
    return cast[uint32](b[off]) | (cast[uint32](b[off + 1]) << 8) | (cast[uint32](b[off + 2]) << 16) | (cast[uint32](b[off + 3]) << 24)


def _put16(b: Ptr[uint8], off: uint32, v: uint32):
    b[off] = cast[uint8](v & 255)
    b[off + 1] = cast[uint8]((v >> 8) & 255)


def _put32(b: Ptr[uint8], off: uint32, v: uint32):
    _put16(b, off, v & 0xFFFF)
    _put16(b, off + 2, v >> 16)


def _putstr(b: Ptr[uint8], off: uint32, s: Ptr[uint8]) -> uint32:
    n: uint32 = _slen(s)
    _put16(b, off, n)
    i: uint32 = 0
    while i < n:
        b[off + 2 + i] = s[i]
        i = i + 1
    return off + 2 + n


# Encode a 9P2000 stat record, the format of Hamnix's SYS_STAT_P9:
#   size[2] type[2] dev[4] qid.type[1] qid.vers[4] qid.path[8] mode[4]
#   atime[4] mtime[4] length[8] name[s] uid[s] gid[s] muid[s]
# Returns the bytes written, or ERANGE when nbuf is too small.
def _stat_encode(buf: Ptr[uint8], nbuf: uint64, name: Ptr[uint8], qtype: uint32, qpath: uint64, mode: uint32, mtime: uint32, length: uint64) -> int64:
    total: uint32 = 41 + 2 + _slen(name) + 3 * 8
    if cast[uint64](total) > nbuf:
        return cast[int64](_err(ERANGE, "stat buffer too small"))
    _put16(buf, 0, total - 2)
    _put16(buf, 2, 0)
    _put32(buf, 4, 0)
    buf[8] = cast[uint8](qtype)
    _put32(buf, 9, 0)
    _put32(buf, 13, cast[uint32](qpath))
    _put32(buf, 17, cast[uint32](qpath >> 32))
    _put32(buf, 21, mode)
    _put32(buf, 25, mtime)
    _put32(buf, 29, mtime)
    _put32(buf, 33, cast[uint32](length))
    _put32(buf, 37, cast[uint32](length >> 32))
    off: uint32 = _putstr(buf, 41, name)
    off = _putstr(buf, off, "hmicro")
    off = _putstr(buf, off, "hmicro")
    off = _putstr(buf, off, "hmicro")
    return cast[int64](off)


def _basename(canon: Ptr[uint8]) -> Ptr[uint8]:
    n: uint32 = _slen(canon)
    while n > 0 and canon[n - 1] != 47:
        n = n - 1
    if canon[n] == 0:
        return "/"
    return cast[Ptr[uint8]](cast[uint64](canon) + cast[uint64](n))


def _stat_slot(slot: int32, name: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    mode: uint32 = tmpfs_table[slot].mode & 0x1FF
    qt: uint32 = 0
    ln: uint64 = 0
    if tmpfs_is_dir(slot) != 0:
        mode = mode | DMDIR
        qt = QTDIR
    else:
        ln = tmpfs_size(slot)
    return _stat_encode(buf, nbuf, name, qt, cast[uint64](slot) + 1, mode, cast[uint32](tmpfs_mtime(slot)), ln)


def vfs_stat(path: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    key: Array[256, uint8]
    nsname: Array[256, uint8]
    rc: int32 = _resolve(path, &key[0], &nsname[0], RES_LOOKUP)
    name: Ptr[uint8] = _basename(&nsname[0])
    if nsname[0] == 0:
        name = _basename(&key[0])
    r: int64 = cast[int64](rc)
    if rc == 0:
        r = _stat_key(&key[0], name, buf, nbuf)
    if r == cast[int64](ENOENT) and _ns_synth(&nsname[0]) != 0:
        return _stat_encode(buf, nbuf, name, QTDIR, 0x6000, DMDIR | 0x16D, 0, 0)
    return r


# The stat record of what server key `canon` names; `name` is its name in
# the caller's namespace.
def _stat_key(canon: Ptr[uint8], name: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    kind: uint32 = _kind(canon)
    if kind == FS_KIND_9P:
        return _p9_stat(canon, buf, nbuf)
    if kind == FS_KIND_SRV:
        xrel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if xrel[0] == 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x7000, DMDIR | 0x1FF, 0, 0)
        if srv_find(_proc_rel(xrel)) < 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, name, 0, 0x7001 + cast[uint64](srv_find(_proc_rel(xrel))), 0x1B6, 0, 0)
    if kind == FS_KIND_DEVFS:
        rel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rel[0] == 0 or devtree_is_dir(rel) != 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x1000, DMDIR | 0x16D, 0, 0)
        dev: int32 = _dev_lookup(rel)
        if dev == 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, name, 0, 0x1000 + cast[uint64](dev), DMDEVICE | 0x1B6, 0, 0)
    if kind == FS_KIND_ROM:
        rrel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if rrel[0] == 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x2000, DMDIR | 0x16D, 0, 0)
        ridx: int32 = _rom_lookup(rrel)
        if ridx < 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, name, 0, 0x2001 + cast[uint64](ridx), 0x16D, 0, rom_size(cast[uint32](ridx)))
    if kind == FS_KIND_FD:
        frel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        if frel[0] == 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x3000, DMDIR | 0x16D, 0, 0)
        if _fdname_number(frel) < 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, name, 0, 0x3001 + cast[uint64](_fdname_number(frel)), DMDEVICE | 0x1B6, 0, 0)
    if kind == FS_KIND_PROC:
        prel: Ptr[uint8] = _proc_rel(cast[Ptr[uint8]](vfs_fs_rel(_pc(canon))))
        if prel[0] == 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x5000, DMDIR | 0x16D, 0, 0)
        if proc_pid_dir(prel) != 0:
            return _stat_encode(buf, nbuf, name, QTDIR, 0x5100, DMDIR | 0x16D, 0, 0)
        if proc_lookup(prel) == 0 and proc_note_pid(prel) == 0 and proc_ns_pid(prel) == 0:
            return cast[int64](_err(ENOENT, "file does not exist"))
        return _stat_encode(buf, nbuf, name, 0, 0x5001 + cast[uint64](proc_lookup(prel)), 0x124, 0, 0)
    if kind == FS_KIND_FAT:
        srel: Ptr[uint8] = cast[Ptr[uint8]](vfs_fs_rel(_pc(canon)))
        fcl: uint64 = 0
        fsz: uint64 = 0
        fr: int64 = 0
        mutex_lock(&fs_lock)
        if fat_mounted == 0:
            fr = cast[int64](_err(ENOENT, "no FAT volume"))
        elif _fat_is_dir(srel) != 0:
            fr = _stat_encode(buf, nbuf, name, QTDIR, 0x4000, DMDIR | 0x1FF, 0, 0)
        elif fat_lookup(_pc(srel), &fcl, &fsz) != 0:
            fr = _stat_encode(buf, nbuf, name, 0, 0x4000 + fcl, 0x1B6, 0, fsz)
        else:
            fr = cast[int64](_err(ENOENT, "file does not exist"))
        mutex_unlock(&fs_lock)
        return fr
    if kind != FS_KIND_TMPFS:
        return cast[int64](_err(ENOENT, "no such device"))
    mutex_lock(&fs_lock)
    r: int64 = 0
    slot: int32 = tmpfs_lookup(_pc(canon))
    if slot < 0:
        r = cast[int64](_err(ENOENT, "file does not exist"))
    else:
        r = _stat_slot(slot, name, buf, nbuf)
    mutex_unlock(&fs_lock)
    return r


def vfs_fstat(fd: int32, buf: Ptr[uint8], nbuf: uint64) -> int64:
    mutex_lock(&fs_lock)
    r: int64 = 0
    f: Ptr[OpenFile] = _fd_file(fd)
    if f == cast[Ptr[OpenFile]](0):
        r = cast[int64](_err(EBADF, "fstat: bad fd"))
    elif f[0].kind == OF_DEV:
        r = _stat_encode(buf, nbuf, "dev", 0, 0x1000 + cast[uint64](f[0].slot), DMDEVICE | 0x1B6, 0, 0)
    elif f[0].kind == OF_FDNAME:
        r = _stat_encode(buf, nbuf, "fd", 0, 0x3001 + cast[uint64](f[0].slot), DMDEVICE | 0x1B6, 0, 0)
    elif f[0].kind == OF_ROM:
        r = _stat_encode(buf, nbuf, rom_name(cast[uint32](f[0].slot)), 0, 0x2001 + cast[uint64](f[0].slot), 0x16D, 0, rom_size(cast[uint32](f[0].slot)))
    elif f[0].kind == OF_9P:
        mutex_unlock(&fs_lock)
        r = p9c_stat(cast[uint32](f[0].slot), cast[uint32](f[0].aux0), buf, nbuf)
        if r == -34:
            _err(ERANGE, "stat buffer too small")
        return r
    elif f[0].kind == OF_SOCK:
        r = _stat_encode(buf, nbuf, "", 0, 0x7100, 0x1B6, 0, 0)
    elif f[0].kind == OF_FAT or f[0].kind == OF_FATW:
        r = _stat_encode(buf, nbuf, "", 0, 0x4000 + f[0].aux0, 0x1B6, 0, f[0].aux1)
    elif f[0].kind == OF_DIR:
        r = _stat_encode(buf, nbuf, "", QTDIR, 0, DMDIR | 0x1ED, 0, 0)
    else:
        r = _stat_slot(f[0].slot, "", buf, nbuf)
    mutex_unlock(&fs_lock)
    return r


def vfs_chdir(path: Ptr[uint8]) -> int32:
    canon: Array[256, uint8]
    key: Array[256, uint8]
    rc: int32 = _resolve(path, &key[0], &canon[0], RES_LOOKUP)
    if canon[0] == 0:
        if rc < 0:
            return rc
        return _err(EINVAL, "chdir: a server has no place in the namespace; bind it to a name first")
    if _slen(&canon[0]) >= 127:
        return _err(ENAMETOOLONG, "chdir: path too long")
    k: uint32 = 0
    if rc == 0:
        k = _key_kind(&key[0])
    if k == 1:
        return _err(ENOTDIR, "not a directory")
    if k == 0 and _ns_synth(&canon[0]) == 0:
        return _err(ENOENT, "directory does not exist")
    cwd: Ptr[uint8] = &current_thread()[0].cwd[0]
    i: uint32 = 0
    while canon[i] != 0:
        cwd[i] = canon[i]
        i = i + 1
    cwd[i] = 0
    return 0


# Copies the working directory including its NUL; returns the byte count.
def vfs_getcwd(buf: Ptr[uint8], n: uint64) -> int64:
    cwd: Ptr[uint8] = &current_thread()[0].cwd[0]
    ln: uint64 = cast[uint64](_slen(cwd)) + 1
    if n < ln:
        return cast[int64](_err(ERANGE, "getcwd: buffer too small"))
    rt_memcpy(cast[uint64](buf), cast[uint64](cwd), ln)
    return cast[int64](ln)


# Number of open-file entries in use (for leak checks).
def vfs_open_count() -> uint32:
    n: uint32 = 0
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        if ofiles[i].refs != 0:
            n = n + 1
        i = i + 1
    return n


# A thread ends: release its descriptors.  Runs in thread context (the exiting
# thread itself, or whoever reaps a thread that was ended by a fault).
def _vfs_thread_exit(tp: uint64) -> int64:
    t: Ptr[Thread] = thr(tp)
    toks: Array[16, uint64]
    mutex_lock(&fs_lock)
    fd: uint32 = 0
    while fd < VFS_NR_FDS:
        toks[fd] = 0
        if t[0].fd[fd] >= 0:
            toks[fd] = _close_index(t[0].fd[fd])
            t[0].fd[fd] = -1
        fd = fd + 1
    mutex_unlock(&fs_lock)
    # 9P files: the server is told when the thread itself closes them; the
    # reaper, cleaning up after a fault, must not wait for a server
    tell: uint32 = 0
    if t == current_thread():
        tell = 1
    fd = 0
    while fd < VFS_NR_FDS:
        _p9_finish(toks[fd], tell)
        fd = fd + 1
    # the /fd names: dropping a pipe end is what the other side sees as end
    # of file or EPIPE
    n: uint32 = 0
    while n < DEVFD_SLOTS:
        _fdn_release(t, n, tell)
        n = n + 1
    _chan_pend_reap(t[0].tid, tell)
    pipe_release_unbound(t[0].tid)
    _grant_drop(t[0].tid, -1)
    ns_unref(t[0].nsg)
    t[0].nsg = 0
    return 0


# A thread is created: it starts with its creator's descriptors and directory.
def _vfs_thread_spawn(childp: uint64, parentp: uint64) -> int64:
    c: Ptr[Thread] = thr(childp)
    p: Ptr[Thread] = thr(parentp)
    mutex_lock(&fs_lock)
    fd: uint32 = 0
    while fd < VFS_NR_FDS:
        idx: int32 = p[0].fd[fd]
        c[0].fd[fd] = idx
        if idx >= 0:
            ofiles[idx].refs = ofiles[idx].refs + 1
        fd = fd + 1
    mutex_unlock(&fs_lock)
    i: uint32 = 0
    while p[0].cwd[i] != 0:
        c[0].cwd[i] = p[0].cwd[i]
        i = i + 1
    c[0].cwd[i] = 0
    # the namespace is shared with the creator (Hamnix: the same Pgrp)
    c[0].nsg = p[0].nsg
    ns_ref(c[0].nsg)
    # the /fd names, each pipe end counted once more
    n: uint32 = 0
    while n < DEVFD_SLOTS:
        c[0].fdn_kind[n] = p[0].fdn_kind[n]
        c[0].fdn_arg[n] = p[0].fdn_arg[n]
        c[0].fdn_pos[n] = p[0].fdn_pos[n]
        if p[0].fdn_kind[n] == DEVFD_PIPE_R:
            pipe_inc_reader(p[0].fdn_arg[n])
        elif p[0].fdn_kind[n] == DEVFD_PIPE_W:
            pipe_inc_writer(p[0].fdn_arg[n])
        elif _chan_is_of(p[0].fdn_kind[n], p[0].fdn_arg[n]) != 0:
            mutex_lock(&fs_lock)
            ofiles[p[0].fdn_arg[n] & 0xFFFF].refs = ofiles[p[0].fdn_arg[n] & 0xFFFF].refs + 1
            mutex_unlock(&fs_lock)
        n = n + 1
    return 0


# ---------------------------------------------------------------- bind, unmount
# Freeze a bind source to a server-anchored name, as Hamnix's mnttab_bind
# does: "#X/..." is kept, a path is resolved in the caller's namespace NOW
# (so the binding does not change when the namespace does later).  Hamnix
# takes the first union member whether or not it has the name; Hamnix Micro takes
# the member the name is found in.  A source that names nothing is an error
# (Hamnix: do_bind, "#86").
def _bind_source(old: Ptr[uint8], spec: Ptr[uint8], tmp: Ptr[uint8]) -> int32:
    if _resolve(old, spec, tmp, RES_LOOKUP) < 0:
        return ENOENT
    if tmp[0] != 0 and _key_kind(spec) == 0:
        return ENOENT
    _key_spec(spec)
    return 0


def _ns_err(rc: int32, what: Ptr[uint8]) -> int32:
    if rc == ENOSPC:
        return _err(rc, "mount table full")
    if rc == ENOMEM:
        return _err(rc, "out of memory")
    if rc == ENAMETOOLONG:
        return _err(rc, "path too long")
    return _err(rc, what)


# bind(new, old, flag), Hamnix's argument order: afterwards the name `new`
# leads to what `old` names now.  (The shell's `bind SRC DST` passes
# new = DST, old = SRC.)  flag: MREPL 0, MBEFORE 1, MAFTER 2, | MCREATE 4,
# | MCACHE 8 (no effect), | MRDONLY 16.
def vfs_bind(newp: Ptr[uint8], oldp: Ptr[uint8], flag: uint32) -> int32:
    cn: Array[256, uint8]
    spec: Array[256, uint8]
    if (flag & MORDER) == MORDER or flag > 31:
        return _err(EINVAL, "bind failed: bad flag")
    if newp[0] == 35:
        return _err(EINVAL, "bind failed: the mount point must be a path")
    if _bind_source(oldp, &spec[0], &cn[0]) < 0:
        return _err(ENOENT, "bind failed: source does not resolve in this namespace")
    rc: int32 = vfs_canon(newp, &cn[0])
    if rc < 0:
        return _err(rc, "bind failed: new path too long")
    rc = ns_add(_nsg(), &cn[0], &spec[0], flag, NS_BIND)
    if rc < 0:
        return _ns_err(rc, "bind failed: no such connection")
    return 0


def _unmount_pair(point: Ptr[uint8], src: Ptr[uint8]) -> int32:
    cn: Array[256, uint8]
    spec: Array[256, uint8]
    if point[0] == 35 or _bind_source(src, &spec[0], &cn[0]) < 0:
        return 0
    if spec[0] == 35 and spec[1] == 115 and spec[2] == 47:
        # "/srv/NAME": the mount of that server
        mc: int32 = p9c_find_name(&spec[3])
        if mc < 0:
            return 0
        spec[1] = 77
        spec[_put_dec(&spec[0], 2, cast[uint32](mc))] = 0
    if vfs_canon(point, &cn[0]) < 0:
        return 0
    return ns_remove(_nsg(), &cn[0], &spec[0])


# unmount(new, old).  new == 0: remove everything bound at the name `old`.
# Otherwise remove one binding.  Hamnix's kernel takes new = the mount point
# and old = the source here, the reverse of Plan 9's unmount(2) (and of its
# own shell's usage line, "unmount [new] old"); Hamnix Micro accepts both orders.
def vfs_unmount(newp: Ptr[uint8], oldp: Ptr[uint8]) -> int32:
    cn: Array[256, uint8]
    n: int32 = 0
    if newp == cast[Ptr[uint8]](0):
        if oldp[0] != 35 and vfs_canon(oldp, &cn[0]) == 0:
            n = ns_remove(_nsg(), &cn[0], cast[Ptr[uint8]](0))
    else:
        n = _unmount_pair(newp, oldp)
        if n == 0:
            n = _unmount_pair(oldp, newp)
    if n < 0:
        return _ns_err(n, "unmount failed")
    if n == 0:
        return _err(ENOENT, "unmount failed: not mounted")
    return 0


# Hamnix's nslabel: op 0 stamps `label` on the newest binding at `to`;
# op 1 removes the binding that carries `label`.
def vfs_nslabel(op: uint32, label: Ptr[uint8], to: Ptr[uint8]) -> int32:
    cn: Array[256, uint8]
    if op == 1:
        if ns_remove_label(_nsg(), label) < 0:
            return _err(ENOENT, "unmount failed: no such label")
        return 0
    if to == cast[Ptr[uint8]](0) or to[0] == 35 or vfs_canon(to, &cn[0]) < 0:
        return _err(EINVAL, "nslabel failed: bad path")
    rc: int32 = ns_set_label(_nsg(), &cn[0], label)
    if rc == -1:
        return _err(ENOENT, "nslabel failed: no matching mount")
    if rc < 0:
        return _ns_err(rc, "nslabel failed")
    return 0


# rfork's namespace flags.  A new group for thread t: the same namespace,
# copied when either side changes it (clean = 0, RFNAMEG), or an empty one
# (clean = 1, RFCNAMEG).
def vfs_ns_split(t: Ptr[Thread], clean: uint32) -> int32:
    g: int32 = ns_split(t[0].nsg, clean)
    if g < 0:
        return _ns_err(g, "rfork: out of namespace groups")
    old: uint32 = t[0].nsg
    t[0].nsg = cast[uint32](g)
    ns_unref(old)
    return 0


# rfork(RFPROC | RFNAMEG or RFCNAMEG): the group is made before the child
# (vfs_ns_prepare, in the parent), then given to it (vfs_ns_adopt) or
# dropped (vfs_ns_discard).
def vfs_ns_prepare(clean: uint32) -> int32:
    g: int32 = ns_split(_nsg(), clean)
    if g < 0:
        return _ns_err(g, "rfork: out of namespace groups")
    return g


def vfs_ns_adopt(t: Ptr[Thread], g: uint32):
    old: uint32 = t[0].nsg
    t[0].nsg = g
    ns_unref(old)


def vfs_ns_discard(g: uint32):
    ns_unref(g)


def vfs_nsid() -> uint32:
    return _nsg() + 1


# ---------------------------------------------------------------- mount, /srv
# socketpair: two descriptors, each end reading what the other writes (two
# pipes).  sv[0] and sv[1] are C ints.
def vfs_socketpair(sv: Ptr[int32]) -> int32:
    a: int32 = pipe_alloc_chan(current_thread()[0].tid)
    if a < 0:
        return _err(EMFILE, "out of pipes or memory")
    b: int32 = pipe_alloc_chan(current_thread()[0].tid)
    if b < 0:
        pipe_release_unbound(current_thread()[0].tid)
        return _err(EMFILE, "out of pipes or memory")
    mutex_lock(&fs_lock)
    f0: int32 = _sock_install(a, b)
    f1: int32 = -1
    if f0 >= 0:
        f1 = _sock_install(b, a)
    mutex_unlock(&fs_lock)
    if f1 < 0:
        if f0 >= 0:
            vfs_close(f0)
        pipe_release_unbound(current_thread()[0].tid)
        return _err(EMFILE, "too many open files")
    sv[0] = f0
    sv[1] = f1
    return 0


# The transport a descriptor is: 0 with kind/rp/wp set, or -1.
def _fd_transport(fd: int32, kind: Ptr[uint32], rp: Ptr[int32], wp: Ptr[int32]) -> int32:
    r: int32 = -1
    mutex_lock(&fs_lock)
    f: Ptr[OpenFile] = _fd_file(fd)
    if f != cast[Ptr[OpenFile]](0):
        if f[0].kind == OF_SOCK:
            kind[0] = P9C_PIPES
            rp[0] = cast[int32](f[0].aux0)
            wp[0] = cast[int32](f[0].aux1)
            r = 0
        elif f[0].kind == OF_DEV and f[0].slot >= DEV_TREE:
            kind[0] = P9C_DEVICE
            rp[0] = f[0].slot - DEV_TREE
            wp[0] = 0
            r = 0
    mutex_unlock(&fs_lock)
    return r


# srv_post(name, fd): leave the socket end `fd` in /srv under `name`.
def vfs_srv_post(name: Ptr[uint8], fd: int32) -> int32:
    kind: uint32 = 0
    rp: int32 = 0
    wp: int32 = 0
    if _fd_transport(fd, &kind, &rp, &wp) < 0 or kind != P9C_PIPES:
        return _err(EBADF, "srv_post: not one end of a socketpair")
    rc: int32 = srv_post(name, rp, wp)
    if rc == EEXIST:
        return _err(rc, "srv_post: the name is taken")
    if rc == ENOSPC:
        return _err(rc, "srv_post: /srv is full")
    if rc < 0:
        return _err(rc, "srv_post: bad name")
    return 0


# srv_open(name): a descriptor for the end posted as /srv/<name>.
def vfs_srv_open(name: Ptr[uint8]) -> int32:
    rp: int32 = 0
    wp: int32 = 0
    if srv_get(name, &rp, &wp) < 0:
        return _err(ENOENT, "srv_open: no such server in /srv")
    mutex_lock(&fs_lock)
    fd: int32 = _sock_install(rp, wp)
    mutex_unlock(&fs_lock)
    return fd


# mount(srvfd, afd, old, flag, spec): attach the 9P server reached through
# descriptor srvfd at the name `old`.  srvfd is one end of a socketpair
# (what srv_open returns) or an open device file that carries bytes both
# ways (a serial port).  There is no authentication (afd is ignored; Hamnix
# passes -1 too) and one tree per server (spec is ignored).  On success the
# descriptor is closed: the connection is the kernel's from then on.
# Hamnix leaves it open, which here would use up the shell's sixteen.
def vfs_mount_9p(srvfd: int32, oldp: Ptr[uint8], flag: uint32) -> int32:
    cn: Array[256, uint8]
    spec: Array[16, uint8]
    kind: uint32 = 0
    rp: int32 = 0
    wp: int32 = 0
    if (flag & MORDER) == MORDER or flag > 31:
        return _err(EINVAL, "mount failed: bad flag")
    if oldp[0] == 35 or vfs_canon(oldp, &cn[0]) < 0:
        return _err(EINVAL, "mount failed: bad path")
    if _fd_transport(srvfd, &kind, &rp, &wp) < 0:
        return _err(EBADF, "mount failed: srvfd is not a 9P transport")
    if kind == P9C_PIPES and (pipe_readers(wp) == 0 or pipe_writers(rp) == 0):
        return _err(-5, "mount failed: nobody serves this connection")
    conn: int32 = p9c_connect(kind, rp, wp, srv_name_of(rp, wp))
    if conn < 0:
        return conn
    spec[0] = 35
    spec[1] = 77
    spec[_put_dec(&spec[0], 2, cast[uint32](conn))] = 0
    rc: int32 = ns_add(_nsg(), &cn[0], &spec[0], flag, NS_MOUNT)
    if rc < 0:
        p9c_discard(cast[uint32](conn))
        return _ns_err(rc, "mount failed")
    vfs_close(srvfd)
    return 0


# Mount the root tmpfs and /dev, create the standard directories.
def vfs_init():
    mutex_init(&fs_lock)
    mutex_register(&fs_lock)
    i: uint32 = 0
    while i < VFS_NR_OPEN:
        ofiles[i].refs = 0
        i = i + 1
    # the servers' key spaces (Hamnix's table routes a key to its server)
    vfs_mount("/", FS_KIND_TMPFS, 0, 0)
    vfs_mount("/#c", FS_KIND_DEVFS, 3, 0)
    vfs_mount("/#r", FS_KIND_ROM, 3, 0)
    vfs_mount("/#d", FS_KIND_FD, 3, 0)
    vfs_mount("/#p", FS_KIND_PROC, 3, 0)
    vfs_mount("/#s", FS_KIND_SRV, 3, 0)
    p9c_init()
    # the boot namespace: what every process sees until it binds something
    # else (Hamnix's pgrp_init plants its default namespace the same way)
    ns_init()
    ns_add(0, "/", "#t", 0, NS_BIND)
    ns_add(0, "/dev", "#c", 0, NS_BIND)
    ns_add(0, "/bin", "#r", 0, NS_BIND)
    ns_add(0, "/fd", "#d", 0, NS_BIND)
    ns_add(0, "/proc", "#p", 0, NS_BIND)
    ns_add(0, "/srv", "#s", 0, NS_BIND)
    ns_conn_get = p9c_get
    ns_conn_put = p9c_put
    ns_conn_name = p9c_name
    ns_conn_hooks = 1
    pipe_init()
    tmpfs_mkdir("/root/tmp")
    tmpfs_mkdir("/root/etc")
    sched_exit_hook = _vfs_thread_exit
    sched_exit_hook_set = 1
    sched_spawn_hook = _vfs_thread_spawn
    sched_spawn_hook_set = 1
    vfs_ready = 1


# Give the current thread the console on descriptors 0, 1 and 2.
def vfs_open_stdio() -> int32:
    fd: int32 = vfs_open("/dev/console", ORDWR)
    if fd != 0:
        return -1
    vfs_dup2(0, 1)
    vfs_dup2(0, 2)
    vfs_fdbind(0, 0, DEVFD_CONS, 0)
    vfs_fdbind(0, 1, DEVFD_CONS, 0)
    vfs_fdbind(0, 2, DEVFD_CONS, 0)
    return 0
