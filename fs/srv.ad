# Hamnix Micro -- /srv (the server #s): where a file server leaves the end of a
# connection for others to mount.
#
# Hamnix's model (sys/src/9/port/devsrv.ad, system calls 275 and 276): a
# server makes a socketpair, posts one end under a name with
# srv_post(name, fd) and serves 9P on the other; `mount /srv/name /n/x` in
# the shell is srv_open(name) + mount(fd, ...).  The table here holds the
# posted end itself (its two pipes, with references of its own), not a
# descriptor number of the poster as Hamnix's does, so the name stays good
# after the poster has closed its descriptor and until it is removed
# (`rm /srv/name`).  New code: Hamnix's table is tied to its task and
# descriptor structures.
#
# A device file that carries bytes both ways (a serial port) can be posted
# too (`srv /dev/eia1 pc`): the entry then names the device, and whoever
# opens it gets a descriptor on that device, for mount to speak 9P over.

from kernel.cpu import cpu_irq_save, cpu_irq_restore
from kernel.pipe import pipe_inc_reader, pipe_inc_writer, pipe_close_reader, pipe_close_writer

SRV_MAX: uint32 = 8                 # = the dimension of srv_tab
SRV_NAME: uint32 = 23
SRV_DEVICE: int32 = -2              # an entry's wp when it is a device file: rp is the file's number (fs/devtree.ad)


class SrvEntry:
    used: uint32
    rp: int32                       # the posted end reads this pipe
    wp: int32                       # ... and writes this one
    name: Array[24, uint8]


srv_tab: Array[8, SrvEntry]


def _eq(a: Ptr[uint8], b: Ptr[uint8]) -> uint32:
    i: uint32 = 0
    while a[i] != 0 and a[i] == b[i]:
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


def srv_find(name: Ptr[uint8]) -> int32:
    i: uint32 = 0
    while i < SRV_MAX:
        if srv_tab[i].used != 0 and _eq(&srv_tab[i].name[0], name) != 0:
            return cast[int32](i)
        i = i + 1
    return -1


# Post the socket end (rp, wp) as `name`.  0, -17 (the name is taken), -22
# (not a usable name), -28 (the table is full).
def srv_post(name: Ptr[uint8], rp: int32, wp: int32) -> int32:
    n: uint32 = 0
    while name[n] != 0:
        if name[n] == 47 or n >= SRV_NAME:
            return -22
        n = n + 1
    if n == 0:
        return -22
    irq: uint32 = cpu_irq_save()
    if srv_find(name) >= 0:
        cpu_irq_restore(irq)
        return -17
    i: uint32 = 0
    while i < SRV_MAX and srv_tab[i].used != 0:
        i = i + 1
    if i == SRV_MAX:
        cpu_irq_restore(irq)
        return -28
    srv_tab[i].rp = rp
    srv_tab[i].wp = wp
    k: uint32 = 0
    while k <= n:
        srv_tab[i].name[k] = name[k]
        k = k + 1
    srv_tab[i].used = 1
    cpu_irq_restore(irq)
    if wp != SRV_DEVICE:
        pipe_inc_reader(rp)
        pipe_inc_writer(wp)
    return 0


# The pipes of the end posted as `name`.  0 or -2.
def srv_get(name: Ptr[uint8], rp: Ptr[int32], wp: Ptr[int32]) -> int32:
    i: int32 = srv_find(name)
    if i < 0:
        return -2
    rp[0] = srv_tab[i].rp
    wp[0] = srv_tab[i].wp
    return 0


def srv_remove(name: Ptr[uint8]) -> int32:
    irq: uint32 = cpu_irq_save()
    i: int32 = srv_find(name)
    if i >= 0:
        srv_tab[i].used = 0
    cpu_irq_restore(irq)
    if i < 0:
        return -2
    if srv_tab[i].wp != SRV_DEVICE:
        pipe_close_reader(srv_tab[i].rp)
        pipe_close_writer(srv_tab[i].wp)
    return 0


# The name an end was posted under ("" if it was not).
def srv_name_of(rp: int32, wp: int32) -> Ptr[uint8]:
    i: uint32 = 0
    while i < SRV_MAX:
        if srv_tab[i].used != 0 and srv_tab[i].rp == rp and srv_tab[i].wp == wp:
            return &srv_tab[i].name[0]
        i = i + 1
    return ""


def srv_name(i: uint32) -> Ptr[uint8]:
    if i < SRV_MAX and srv_tab[i].used != 0:
        return &srv_tab[i].name[0]
    return cast[Ptr[uint8]](0)
