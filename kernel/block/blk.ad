# Hamnix Micro -- block devices under the names Hamnix's file systems expect.
#
# Hamnix's kernel/block/blk.ad is a registry of block devices with a buffer
# cache and I/O statistics.  The FAT code Hamnix Micro carries (fs/fat.ad, copied
# unmodified) needs four things from it: the sector size, a device by name,
# and synchronous reads and writes of whole sectors.  This module supplies
# those names over a small table of devices, each with a pair of functions.
#
# The only device so far is "ram0": a RAM disk at a fixed address
# (boards/*/link.ld: __ramdisk_start, __ramdisk_size).  In the emulator the
# test harness has QEMU load a FAT32 image there before the kernel starts
# (-device loader), which is how a "card" gets into a machine that has no
# card slot.  On the board the same slot is the SD card through the USDHC
# driver: register_blockdev() with two other functions.
#
# No cache: a RAM disk does not need one, and an SD driver should bring its
# own policy.  Calls are serialised by the file-system lock of the caller.

from kernel.rt import rt_memcpy

extern def __ramdisk_start()
extern def __ramdisk_size()

SECTOR_SIZE: uint64 = 512
BLKDEV_MAX: uint32 = 4


class BlockDev:
    used: uint32
    pad: uint32
    capacity: uint64                # sectors
    name: Array[16, uint8]
    rd_sectors: uint64              # statistics
    wr_sectors: uint64


blkdevs: Array[4, BlockDev]
# The two functions of each device: (lba, count, buffer address) -> 0 or -1.
blk_read_fn: Array[4, Fn[int32, uint64, uint64, uint64]]
blk_write_fn: Array[4, Fn[int32, uint64, uint64, uint64]]


def _blk_name_eq(a: Ptr[uint8], b: Ptr[uint8]) -> uint32:
    i: uint32 = 0
    while i < 15 and a[i] != 0 and a[i] == b[i]:
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


# Returns the slot or -1.
def register_blockdev(name: Ptr[uint8], capacity_sectors: uint64, read: Fn[int32, uint64, uint64, uint64], write: Fn[int32, uint64, uint64, uint64]) -> int32:
    i: uint32 = 0
    while i < BLKDEV_MAX and blkdevs[i].used != 0:
        i = i + 1
    if i == BLKDEV_MAX:
        return -1
    k: uint32 = 0
    while k < 15 and name[k] != 0:
        blkdevs[i].name[k] = name[k]
        k = k + 1
    blkdevs[i].name[k] = 0
    blkdevs[i].capacity = capacity_sectors
    blk_read_fn[i] = read
    blk_write_fn[i] = write
    blkdevs[i].rd_sectors = 0
    blkdevs[i].wr_sectors = 0
    blkdevs[i].used = 1
    return cast[int32](i)


def find_blockdev(name: Ptr[char]) -> int32:
    i: uint32 = 0
    while i < BLKDEV_MAX:
        if blkdevs[i].used != 0 and _blk_name_eq(&blkdevs[i].name[0], cast[Ptr[uint8]](name)) != 0:
            return cast[int32](i)
        i = i + 1
    return -1


def _blk_ok(slot: int32, lba: uint64, count: uint64) -> uint32:
    if slot < 0 or slot >= cast[int32](BLKDEV_MAX) or blkdevs[slot].used == 0:
        return 0
    if count == 0 or lba + count < lba or lba + count > blkdevs[slot].capacity:
        return 0
    return 1


def blk_read_sectors(slot: int32, lba: uint64, count: uint64, buf: Ptr[uint8]) -> int32:
    if _blk_ok(slot, lba, count) == 0:
        return -1
    blkdevs[slot].rd_sectors = blkdevs[slot].rd_sectors + count
    rd: Fn[int32, uint64, uint64, uint64] = blk_read_fn[slot]
    return rd(lba, count, cast[uint64](buf))


def blk_write_sectors(slot: int32, lba: uint64, count: uint64, buf: Ptr[uint8]) -> int32:
    if _blk_ok(slot, lba, count) == 0:
        return -1
    blkdevs[slot].wr_sectors = blkdevs[slot].wr_sectors + count
    wr: Fn[int32, uint64, uint64, uint64] = blk_write_fn[slot]
    return wr(lba, count, cast[uint64](buf))


def blk_capacity_sectors(slot: int32) -> uint64:
    if slot < 0 or slot >= cast[int32](BLKDEV_MAX) or blkdevs[slot].used == 0:
        return 0
    return blkdevs[slot].capacity


# ---- the RAM disk ------------------------------------------------------------
def _ram_read(lba: uint64, count: uint64, buf: uint64) -> int32:
    rt_memcpy(buf, cast[uint64](&__ramdisk_start) + lba * SECTOR_SIZE, count * SECTOR_SIZE)
    return 0


def _ram_write(lba: uint64, count: uint64, buf: uint64) -> int32:
    rt_memcpy(cast[uint64](&__ramdisk_start) + lba * SECTOR_SIZE, buf, count * SECTOR_SIZE)
    return 0


# Register "ram0".  Returns its slot.
def blk_init() -> int32:
    i: uint32 = 0
    while i < BLKDEV_MAX:
        blkdevs[i].used = 0
        i = i + 1
    return register_blockdev("ram0", cast[uint64](&__ramdisk_size) / SECTOR_SIZE, _ram_read, _ram_write)
