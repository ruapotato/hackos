# HackOS -- Cortex-M7 core access from Adder.
#
# Special registers are read and written by the leaf routines in
# arch/armv7m/cpu.S.  Adder's inline assembly takes no operands, so a value
# could only leave an `asm_volatile` body through a global, and that is not
# re-entrant (an interrupt between the store and the load corrupts the result).
# RULE for kernel code: `asm_volatile` may be used only for instructions that
# exchange no value with Adder (cpsid, cpsie, wfi, svc, udf, bkpt with fixed
# registers); anything that produces or consumes a value goes through cpu.S.

# Interrupts with a priority value >= KERNEL_BASEPRI may use kernel services
# and are masked by a critical section; 0x00..0x3F stay enabled and must not
# touch kernel data.  Keep in step with arch/armv7m/cpu.S and switch.S.
KERNEL_BASEPRI: uint32 = 0x40

# Critical sections: prev = cpu_irq_save() ... cpu_irq_restore(prev).  Nestable.
extern def cpu_irq_save() -> uint32
extern def cpu_irq_restore(prev: uint32)
extern def cpu_basepri() -> uint32
extern def cpu_set_basepri(v: uint32)
extern def cpu_primask() -> uint32
# Interrupt Program Status Register: 0 in thread mode, else the active
# exception number (15 = SysTick, 11 = SVCall, ...).
extern def cpu_ipsr() -> uint32
extern def cpu_control() -> uint32
extern def cpu_psp() -> uint32
extern def cpu_set_psp(v: uint32)
extern def cpu_msp() -> uint32
extern def cpu_sp() -> uint32
extern def cpu_wfi()
extern def cpu_isb()


def cpu_irq_disable():
    asm_volatile("cpsid i")


def cpu_irq_enable():
    asm_volatile("cpsie i")


def cpu_wait_for_interrupt():
    cpu_wfi()


# 32-bit memory-mapped register access.  The pointee type is `volatile`, so
# every call is exactly one load or one store that the optimiser may not
# remove, merge or reorder.
def mmio_read32(addr: uint64) -> uint32:
    return cast[Ptr[volatile uint32]](addr)[0]


def mmio_write32(addr: uint64, v: uint32):
    cast[Ptr[volatile uint32]](addr)[0] = v


def mmio_write8(addr: uint64, v: uint32):
    cast[Ptr[volatile uint8]](addr)[0] = cast[uint8](v)
