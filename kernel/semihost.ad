# HackOS -- ARM semihosting (debug channel to the host / emulator).
#
# Used only to END an emulator run with a status: QEMU must be started with
# `-semihosting-config enable=on,target=native`.  On real hardware without a
# debugger attached, `bkpt` escalates to HardFault, so nothing here may be
# called outside a test build.
#
# The call is `bkpt 0xAB` with r0 = operation, r1 = parameter (block).

semi_op: volatile uint32 = 0
semi_arg: volatile uint32 = 0
semi_ret: volatile uint32 = 0
semi_exit_block: Array[2, uint32]


def semihost_call(op: uint32, arg: uint32) -> uint32:
    semi_op = op
    semi_arg = arg
    asm_volatile("movw r2, #:lower16:semi_op\n movt r2, #:upper16:semi_op\n ldr r0, [r2]\n movw r2, #:lower16:semi_arg\n movt r2, #:upper16:semi_arg\n ldr r1, [r2]\n bkpt 0xAB\n movw r2, #:lower16:semi_ret\n movt r2, #:upper16:semi_ret\n str r0, [r2]")
    return semi_ret


# End the emulator run; `code` becomes the QEMU process exit status.
# SYS_EXIT_EXTENDED (0x20) with {ADP_Stopped_ApplicationExit, code}.
def semihost_exit(code: uint32):
    semi_exit_block[0] = 0x20026
    semi_exit_block[1] = code
    semihost_call(0x20, cast[uint32](cast[uint64](&semi_exit_block[0])))
    while 1 == 1:
        asm_volatile("wfi")
