# Hamnix Micro -- faults raised by a thread: report, end the thread, carry on.
#
# hmicro_fault_entry (arch/armv7m/startup.S) offers every fault taken from
# thread mode on the process stack to hmicro_thread_fault() below.  It runs in
# handler mode on the main stack, which is intact even when the thread's own
# stack is not.  The thread is turned into a zombie whose exit code says what
# happened; whoever joins it reads the code.  Faults in handler mode, inside a
# critical section, or before the scheduler runs are fatal and go to the
# report in kernel/fault.ad.

from kernel.cpu import mmio_read32, mmio_write32, cpu_basepri, cpu_set_basepri, cpu_set_psp, cpu_control
from kernel.print import kputs, kput_hex32, kput_u64, kputc
from kernel.sched.core import Thread, thr, sched_current, sched_running, thread_kill_current_from_fault, sched_report_hook, sched_report_hook_set, STACK_GUARD, TF_PROC

FAULT_STACK_OVERFLOW: uint32 = 1
FAULT_ACCESS: uint32 = 2
FAULT_BUS: uint32 = 3
FAULT_USAGE: uint32 = 4

# What the last thread fault was (read by tests and the monitor).
trap_count: uint32 = 0
trap_last_tid: uint32 = 0
trap_last_kind: uint32 = 0
trap_last_addr: uint32 = 0
trap_last_pc: uint32 = 0


def _in_guard(addr: uint32, base: uint64) -> uint32:
    if base == 0:
        return 0
    b: uint32 = cast[uint32](base)
    if addr >= b and addr < b + STACK_GUARD:
        return 1
    return 0


# A process's stack is the bottom of its block: running off it lands just
# below the block, in memory the process has no right to.  What tells an
# overflow from a wild pointer that happens to point there is the stack
# pointer: at an overflow it is at the very bottom of the block or below it.
def _below_block(addr: uint32, psp: uint32, t: Ptr[Thread]) -> uint32:
    if (t[0].flags & TF_PROC) == 0 or t[0].mem_lo == 0 or (cpu_control() & 1) == 0:
        return 0
    if addr < t[0].mem_lo and addr + 0x10000 >= t[0].mem_lo and psp < t[0].mem_lo + 128:
        return 1
    return 0


def hmicro_thread_fault(kind: uint64, frame: uint64, exc_return: uint64) -> uint64:
    if sched_running == 0 or sched_current == 0 or cpu_basepri() != 0:
        return 1
    # 11: an `svc` the kernel does not accept from this thread (an unknown
    # immediate, or the kernel-only return-from-system-call).  It is the
    # thread's mistake, not the kernel's.
    # 3: a HardFault taken from UNPRIVILEGED thread code.  That is a `bkpt`
    # with no debugger attached, or a fault that escalated; whatever it was,
    # unprivileged code must not be able to stop the system with it.  A
    # HardFault in privileged code stays fatal.
    if kind == 3 and (cpu_control() & 1) == 0:
        return 1
    if kind != 3 and kind != 4 and kind != 5 and kind != 6 and kind != 11:
        return 1
    t: Ptr[Thread] = thr(sched_current)
    cfsr: uint32 = mmio_read32(0xE000ED28)
    mmfar: uint32 = mmio_read32(0xE000ED34)
    bfar: uint32 = mmio_read32(0xE000ED38)
    psp: uint32 = cast[uint32](frame)
    unpriv: uint32 = cpu_control() & 1
    what: uint32 = FAULT_USAGE
    addr: uint32 = 0
    addr_valid: uint32 = 0
    stacking: uint32 = 0
    if kind == 4:
        what = FAULT_ACCESS
        if (cfsr & 0x80) != 0:
            addr = mmfar
            addr_valid = 1
        if (cfsr & 0x30) != 0:          # MSTKERR | MLSPERR: the frame itself faulted
            stacking = 1
        # A stack overflow shows up either as an access inside a guard, or as
        # the exception frame not fitting above the guard.
        if addr_valid != 0 and (_in_guard(addr, t[0].kstack_base) != 0 or _in_guard(addr, t[0].ustack_base) != 0 or _below_block(addr, psp, t) != 0):
            what = FAULT_STACK_OVERFLOW
        elif stacking != 0 and _below_block(psp, psp, t) != 0:
            what = FAULT_STACK_OVERFLOW
            addr = psp
            addr_valid = 1
        elif stacking != 0 and (_in_guard(psp, t[0].kstack_base) != 0 or _in_guard(psp, t[0].ustack_base) != 0 or _in_guard(psp + 104, t[0].kstack_base) != 0 or _in_guard(psp + 104, t[0].ustack_base) != 0):
            what = FAULT_STACK_OVERFLOW
            addr = psp
            addr_valid = 1
    elif kind == 5:
        what = FAULT_BUS
        if (cfsr & 0x8000) != 0:
            addr = bfar
            addr_valid = 1
    pc: uint32 = 0
    if stacking == 0:
        pc = cast[Ptr[uint32]](frame)[6]
    if (t[0].flags & TF_PROC) != 0:
        kputs("\n*** Hamnix Micro: process ")
    else:
        kputs("\n*** Hamnix Micro: thread ")
    kput_u64(cast[uint64](t[0].tid))
    kputs(" '")
    kputs(&t[0].name[0])
    kputs("' ended: ")
    if what == FAULT_STACK_OVERFLOW:
        kputs("stack overflow")
    elif what == FAULT_ACCESS:
        if unpriv != 0:
            kputs("unprivileged access violation")
        else:
            kputs("access violation")
    elif what == FAULT_BUS:
        kputs("bus fault")
    elif kind == 11:
        kputs("invalid svc instruction")
    elif kind == 3:
        kputs("breakpoint instruction or escalated fault")
    else:
        kputs("usage fault")
    if addr_valid != 0:
        kputs(" at ")
        kput_hex32(addr)
    kputs(", pc ")
    kput_hex32(pc)
    kputs(", CFSR ")
    kput_hex32(cfsr)
    kputs(" ***\n")
    trap_count = trap_count + 1
    trap_last_tid = t[0].tid
    trap_last_kind = what
    trap_last_addr = addr
    trap_last_pc = pc
    # Clear the sticky status bits and any armed lazy FP save (it may point
    # into the stack that just overflowed).
    mmio_write32(0xE000ED28, cfsr)
    if kind == 3:
        mmio_write32(0xE000ED2C, mmio_read32(0xE000ED2C))       # HFSR: write one to clear
        mmio_write32(0xE000ED30, mmio_read32(0xE000ED30))       # DFSR likewise
    mmio_write32(0xE000EF34, mmio_read32(0xE000EF34) & 0xFFFFFFFE)
    # The switch that follows saves the dead thread's registers below PSP:
    # point it at memory that is certainly writable.
    cpu_set_psp(t[0].kstack_top)
    code: int64 = 139                   # 128 + SIGSEGV, as a shell would show it
    if what == FAULT_BUS:
        code = 135
    elif what == FAULT_USAGE:
        code = 132
    thread_kill_current_from_fault(code, what, addr)
    return 0


# The context switch refused to save a thread's context (sched_bad_stack).
def _trap_bad_stack(tp: uint64, sp: uint64) -> int64:
    t: Ptr[Thread] = thr(tp)
    if (t[0].flags & TF_PROC) != 0:
        kputs("\n*** Hamnix Micro: process ")
    else:
        kputs("\n*** Hamnix Micro: thread ")
    kput_u64(cast[uint64](t[0].tid))
    kputs(" '")
    kputs(&t[0].name[0])
    kputs("' ended: stack overflow at ")
    kput_hex32(cast[uint32](sp))
    kputs(" (no room for its context at a switch) ***\n")
    trap_count = trap_count + 1
    trap_last_tid = t[0].tid
    trap_last_kind = FAULT_STACK_OVERFLOW
    trap_last_addr = cast[uint32](sp)
    return 0


def trap_init():
    sched_report_hook = _trap_bad_stack
    sched_report_hook_set = 1
