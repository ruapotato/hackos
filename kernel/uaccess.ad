# HackOS -- checking addresses that arrive in a system call.
#
# A pointer from an unprivileged caller is checked against what the MPU lets
# that caller touch before the kernel uses it:
#   * a process: its own block, nothing else;
#   * an unprivileged thread of the kernel image: the shared user arena
#     (read/write) and the image's text and constants (read-only; string
#     literals live there);
#   * privileged code may pass anything.

from kernel.sched.core import Thread, thr, sched_current, TF_PROC
from mm.slab import user_arena_start, user_arena_end

extern def __text_end()
extern def __vectors_start()


# May the system-call caller access [addr, addr+len)?
def uok(addr: uint64, len: uint64, write: uint32) -> uint32:
    t: Ptr[Thread] = thr(sched_current)
    if t[0].svc_ctrl == 0:
        return 1
    end: uint64 = addr + len
    if end < addr or addr > 0xFFFFFFFF or end > 0x100000000:
        return 0
    if (t[0].flags & TF_PROC) != 0:
        if addr >= cast[uint64](t[0].mem_lo) and end <= cast[uint64](t[0].mem_hi):
            return 1
        return 0
    if addr >= user_arena_start() and end <= user_arena_end():
        return 1
    if write == 0 and addr >= cast[uint64](&__vectors_start) and end <= cast[uint64](&__text_end):
        return 1
    return 0


# A NUL-terminated string of at most 255 bytes, readable by the caller.
def ustr(addr: uint64) -> uint32:
    if thr(sched_current)[0].svc_ctrl == 0:
        return 1
    i: uint64 = 0
    while i < 256:
        if uok(addr + i, 1, 0) == 0:
            return 0
        if cast[Ptr[uint8]](addr + i)[0] == 0:
            return 1
        i = i + 1
    return 0
