# HackOS -- kernel bring-up, shared by the interactive image and the tests.

from kernel.start import hackos_start
from kernel.fault import hackos_fault
from kernel.trap import hackos_thread_fault
from kernel.syscall import syscall_dispatch, syscall_init
from kernel.sched.core import sched_init, sched_start, sched_pick, systick_handler
from kernel.mpu import mpu_init
from mm.slab import mm_init
from drivers.tty.console import console_init, uart0_rx_handler
from fs.hvfs import vfs_init, vfs_fat_mount


# Everything up to, but not including, the first thread switch.  Runs on the
# boot stack with the scheduler stopped.
def kernel_init():
    mm_init()
    mpu_init()
    sched_init()
    syscall_init()
    console_init()
    vfs_init()
    vfs_fat_mount()
