# Hamnix Micro -- what happens when main() returns, the kernel gives up, or someone
# asks for a halt: report a status on the console and reset the system.
#
# The status line is the whole protocol between an image and the test harness:
#
#     [hmicro] exit status N
#
# followed by a system reset request (AIRCR.SYSRESETREQ), which is what a
# real board does to restart.  The harness starts QEMU with `-no-reboot`, so
# the reset ends the emulator run, and reads N from the serial log.  Nothing
# here depends on a debugger or on semihosting: the same code is correct on
# hardware, where it reboots the device.

from kernel.cpu import cpu_irq_disable, mmio_write32
from kernel.print import kputs, kput_u64
from board.board import board_halt


def hmicro_exit(code: uint32):
    cpu_irq_disable()
    kputs("\n[hmicro] exit status ")
    kput_u64(cast[uint64](code))
    kputs("\n")
    board_halt(code)
    while 1 == 1:
        mmio_write32(0xE000ED0C, 0x05FA0004)        # AIRCR: VECTKEY | SYSRESETREQ
