# HackOS -- a periodic tick from an nRF52 RTC (NRF_RTC_Type), the
# scheduler's clock on this chip.  UNTESTED ON HARDWARE.
#
# Why not SysTick: SysTick counts the CPU clock, which the nRF52 stops while
# the CPU sleeps in WFI (HackOS's idle thread), so the tick would stop with
# it.  The RTC runs from LFCLK (32768 Hz) in sleep; Nordic's own and
# Zephyr's system timers use RTC1 for the same reason.
#
# 32768 is not a multiple of 1000, so ticks are placed by arithmetic, not by
# a fixed step: tick number k is due when the counter (extended to 64 bits
# here, the hardware has 24) reaches ceil(k * 32768 / hz).  Consecutive
# ticks are then 32 or 33 counts apart and `hz` of them take exactly one
# second of LFCLK.  How many ticks are due is always computed from the
# counter, so a late interrupt makes ticks late, not lost, and the compare
# register can be set any number of ticks ahead:
#
#   periodic   CC[0] = the count of the next tick; the handler delivers
#              every tick that is due and moves CC[0] on.
#   tickless   rtc_tick_stop_for(n): CC[0] = the count of the n-th tick
#              from now; the processor sleeps in System ON (WFI) with only
#              the RTC running, until that compare or any other interrupt.
#              rtc_tick_resume(): the ticks that are due by now are counted
#              as skipped (the kernel moves its clock by them), and CC[0]
#              goes back to the next tick.
#
# CC is never set closer than 2 counts ahead of COUNTER (the product
# specification: a CC of COUNTER or COUNTER+1 may not raise COMPARE).

from kernel.cpu import mmio_read32, mmio_write32, cpu_wfi

RTC_TASKS_START: uint64 = 0x000          # hdr: NRF_RTC_Type.TASKS_START
RTC_TASKS_STOP: uint64 = 0x004           # hdr: NRF_RTC_Type.TASKS_STOP
RTC_TASKS_CLEAR: uint64 = 0x008          # hdr: NRF_RTC_Type.TASKS_CLEAR
RTC_EVENTS_COMPARE0: uint64 = 0x140      # hdr: NRF_RTC_Type.EVENTS_COMPARE[0]
RTC_INTENSET: uint64 = 0x304             # hdr: NRF_RTC_Type.INTENSET
RTC_INTENCLR: uint64 = 0x308             # hdr: NRF_RTC_Type.INTENCLR
RTC_EVTENCLR: uint64 = 0x348             # hdr: NRF_RTC_Type.EVTENCLR
RTC_COUNTER: uint64 = 0x504              # hdr: NRF_RTC_Type.COUNTER
RTC_PRESCALER: uint64 = 0x508            # hdr: NRF_RTC_Type.PRESCALER
RTC_CC0: uint64 = 0x540                  # hdr: NRF_RTC_Type.CC[0]
RTC_INT_COMPARE0: uint32 = 0x10000       # hdr: RTC_INTENSET_COMPARE0_Msk
RTC_COUNTER_MASK: uint32 = 0xFFFFFF      # hdr: RTC_COUNTER_COUNTER_Msk
LFCLK_HZ: uint32 = 32768                 # unchecked: LFCLK frequency (product specification)
RTC_MAX_CATCHUP: uint32 = 1000           # unchecked: policy -- after a stall longer than this many ticks, the rest are dropped

RTC_MAX_SLEEP_TICKS: uint32 = 60000      # unchecked: policy -- longest tickless stretch (60 s; the 24-bit counter wraps after 512 s)

rtc_hz: uint32 = 1000
rtc_last24: uint32 = 0                   # COUNTER as last read
rtc_count: uint64 = 0                    # the counter extended to 64 bits
rtc_tick_no: uint64 = 0                  # ticks delivered or accounted for so far
rtc_long: uint32 = 0                     # the tick is stopped (rtc_tick_stop_for)
rtc_late: uint64 = 0                     # handler runs that delivered more than one tick
rtc_dropped: uint64 = 0                  # ticks dropped after a stall
rtc_stops: uint64 = 0                    # tickless stretches


# Read COUNTER and extend it.
def _now(base: uint64) -> uint64:
    c: uint32 = mmio_read32(base + RTC_COUNTER) & RTC_COUNTER_MASK
    rtc_count = rtc_count + cast[uint64]((c - rtc_last24) & RTC_COUNTER_MASK)
    rtc_last24 = c
    return rtc_count


# The count at which tick number k is due.
def _due_count(k: uint64) -> uint64:
    return (k * cast[uint64](LFCLK_HZ) + cast[uint64](rtc_hz) - 1) / cast[uint64](rtc_hz)


# Ticks due at count `now` that have not been accounted for.
def _due_ticks(now: uint64) -> uint64:
    return now * cast[uint64](rtc_hz) / cast[uint64](LFCLK_HZ) - rtc_tick_no


# Aim CC[0] at tick number k (at least 2 counts ahead).
def _aim(base: uint64, k: uint64, now: uint64):
    cc: uint64 = _due_count(k)
    if cc < now + 2:
        cc = now + 2
    mmio_write32(base + RTC_CC0, cast[uint32](cc) & RTC_COUNTER_MASK)


def rtc_tick_start(base: uint64, hz: uint32):
    mmio_write32(base + RTC_TASKS_STOP, 1)
    mmio_write32(base + RTC_INTENCLR, 0xFFFFFFFF)
    mmio_write32(base + RTC_EVTENCLR, 0xFFFFFFFF)
    mmio_write32(base + RTC_PRESCALER, 0)
    mmio_write32(base + RTC_TASKS_CLEAR, 1)
    rtc_hz = hz
    rtc_last24 = 0
    rtc_count = 0
    rtc_tick_no = 0
    rtc_long = 0
    _aim(base, 1, 0)
    mmio_write32(base + RTC_EVENTS_COMPARE0, 0)
    mmio_write32(base + RTC_INTENSET, RTC_INT_COMPARE0)
    mmio_write32(base + RTC_TASKS_START, 1)


# From the RTC's interrupt handler.  Returns how many ticks are due (the
# caller runs the kernel's tick that many times) and sets the next compare.
def rtc_tick_ack(base: uint64) -> uint32:
    mmio_write32(base + RTC_EVENTS_COMPARE0, 0)
    mmio_read32(base + RTC_EVENTS_COMPARE0)          # the write has reached the peripheral
    now: uint64 = _now(base)
    n: uint64 = _due_ticks(now)
    if n > cast[uint64](RTC_MAX_CATCHUP):
        rtc_dropped = rtc_dropped + (n - cast[uint64](RTC_MAX_CATCHUP))
        rtc_tick_no = rtc_tick_no + (n - cast[uint64](RTC_MAX_CATCHUP))
        n = cast[uint64](RTC_MAX_CATCHUP)
    if n > 1:
        rtc_late = rtc_late + 1
    rtc_tick_no = rtc_tick_no + n
    _aim(base, rtc_tick_no + 1, now)
    return cast[uint32](n)


# Tickless idle: let up to `n` tick periods pass without an interrupt.
# Interrupts off.  Returns 1 (always possible on this timer).
def rtc_tick_stop_for(base: uint64, n: uint32) -> uint32:
    if n > RTC_MAX_SLEEP_TICKS:
        n = RTC_MAX_SLEEP_TICKS
    now: uint64 = _now(base)
    if _due_ticks(now) != 0:
        return 0                        # a tick is due right now: take it first
    _aim(base, rtc_tick_no + cast[uint64](n), now)
    rtc_long = 1
    rtc_stops = rtc_stops + 1
    return 1


# After the sleep: the ticks that are due are accounted for here (returned,
# not delivered by the handler), and the compare goes back to the next tick.
def rtc_tick_resume(base: uint64) -> uint32:
    if rtc_long == 0:
        return 0
    rtc_long = 0
    now: uint64 = _now(base)
    n: uint64 = _due_ticks(now)
    rtc_tick_no = rtc_tick_no + n
    mmio_write32(base + RTC_EVENTS_COMPARE0, 0)
    _aim(base, rtc_tick_no + 1, now)
    return cast[uint32](n)


# Milliseconds since rtc_tick_start by the counter itself (for a suspend
# that stops the kernel's clock: soc-level wall time).
def rtc_count_ms(base: uint64) -> uint64:
    return _now(base) * 1000 / cast[uint64](LFCLK_HZ)


# Suspend (kernel/power.ad) on this timer: the processor sleeps until an
# interrupt of `wake_irqs` (bits of NVIC ISER0) is pending or `ms`
# milliseconds (0 = no limit) have passed.  Every other interrupt is
# disabled at the NVIC meanwhile; this RTC's own (bit `rtc_irq_bit`) stays
# enabled because its compare is what ends the wait, and with no limit it
# still wakes the processor every 128 s so that the 24-bit counter is read
# before it wraps.  Interrupts off (PRIMASK).  Returns 1 (a wake interrupt
# is pending) or 2 (the time is up); res[0] = tick periods that passed (the
# caller moves the kernel's clock by them), res[1] = times the processor
# woke.
def rtc_suspend(base: uint64, ms: uint64, wake_irqs: uint32, rtc_irq_bit: uint32, res: Ptr[uint64]) -> int32:
    iser: uint32 = mmio_read32(0xE000E100)                  # unchecked: NVIC ISER0 (ARMv7-M)
    mmio_write32(0xE000E180, iser & (0xFFFFFFFF ^ (wake_irqs | rtc_irq_bit)))     # unchecked: NVIC ICER0
    start: uint64 = _now(base)
    target: uint64 = start + ms * cast[uint64](LFCLK_HZ) / 1000
    wakes: uint64 = 0
    reason: int32 = 0
    while reason == 0:
        now: uint64 = _now(base)
        if ms != 0 and now >= target:
            reason = 2
            break
        nxt: uint64 = now + 0x400000
        if ms != 0 and target < nxt:
            nxt = target
        if nxt < now + 2:
            nxt = now + 2
        mmio_write32(base + RTC_CC0, cast[uint32](nxt) & RTC_COUNTER_MASK)
        mmio_write32(base + RTC_EVENTS_COMPARE0, 0)
        mmio_read32(base + RTC_EVENTS_COMPARE0)
        mmio_write32(0xE000E280, rtc_irq_bit)               # unchecked: NVIC ICPR0 -- forget an earlier compare
        if (mmio_read32(0xE000E200) & wake_irqs) == 0:      # unchecked: NVIC ISPR0
            cpu_wfi()
        wakes = wakes + 1
        if (mmio_read32(0xE000E200) & wake_irqs) != 0:
            reason = 1
    end: uint64 = _now(base)
    n: uint64 = _due_ticks(end)
    rtc_tick_no = rtc_tick_no + n
    mmio_write32(base + RTC_EVENTS_COMPARE0, 0)
    mmio_read32(base + RTC_EVENTS_COMPARE0)
    mmio_write32(0xE000E280, rtc_irq_bit)
    _aim(base, rtc_tick_no + 1, end)
    mmio_write32(0xE000E100, iser)
    res[0] = n
    res[1] = wakes
    return reason
