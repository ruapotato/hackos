# HackOS kernel test: code that runs in UNPRIVILEGED threads.
#
# Nothing here may touch a global: kernel data is not accessible from an
# unprivileged thread (that is one of the things under test).  Results go to
# memory the test runner allocated in the user arena, or to the exit code.

from user.sys import sys_putc, sys_exit, sys_get_jiffies, sys_getpid, sys_open, sys_read, sys_close, sys_write, sys_lseek, sys_open_write, sys_dup, sys_dup2, sys_chdir, sys_getcwd, sys_unlink, sys_mkdir, sys_read_nb, sys_yield, sys_create, sys_stat_p9, sys_fstat_p9, sys_remove, sys_errstr, sys_mmap, sys_munmap, sys_thread_spawn, sys_thread_join, sys_rename, sys_gettid, sys_sleep_ms, sys_nanosleep, hackos_syscall
from kernel.cpu import cpu_control

extern def fp_hold(seed: uint64, loops: uint64) -> uint64


def f64_bits(d: float64) -> uint64:
    cell: Array[1, uint64]
    cast[Ptr[float64]](cast[uint64](&cell[0]))[0] = d
    return cell[0]


# 64-bit multiply/divide/modulo and double arithmetic in one loop; the
# reference is tests/reference_m2.py.  With do_yield != 0 the thread also makes
# a system call every 512 rounds, so FP state must survive SVC entry and exit.
def stress_mix(seed: uint64, n: uint64, do_yield: uint64) -> uint64:
    x: uint64 = seed
    acc: float64 = 1.0
    xs: uint64 = 0
    i: uint64 = 0
    while i < n:
        x = x * 6364136223846793005 + 1442695040888963407
        q: uint64 = x / (i + 3)
        r: uint64 = x % 1000003
        xs = xs ^ q
        acc = acc * 0.5 + cast[float64](r) / cast[float64](i + 1)
        if do_yield != 0 and (i & 511) == 511:
            sys_yield()
        i = i + 1
    return xs ^ f64_bits(acc)


def u_stress(seed: uint64) -> int64:
    return cast[int64](stress_mix(seed, 12000, 1))


def u_fphold(seed: uint64) -> int64:
    return cast[int64](fp_hold(seed, 20000))


def u_child(arg: uint64) -> int64:
    sys_yield()
    return cast[int64](arg) * 3 + 1


def _eq(a: Ptr[uint8], b: Ptr[uint8], n: uint64) -> int64:
    i: uint64 = 0
    while i < n:
        if a[i] != b[i]:
            return 0
        i = i + 1
    return 1


def _len(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def _puts(fd: int32, s: Ptr[uint8]) -> int64:
    return sys_write(fd, s, _len(s)) - cast[int64](_len(s))


def _u32at(b: Ptr[uint8], off: uint32) -> int64:
    return cast[int64](cast[uint64](b[off]) | (cast[uint64](b[off + 1]) << 8) | (cast[uint64](b[off + 2]) << 16) | (cast[uint64](b[off + 3]) << 24))


# The system-call round trips.  `arg` points at 64 int64 result cells in the
# user arena; r[63] holds a kernel address handed in by the test runner.
def u_syscalls(arg: uint64) -> int64:
    r: Ptr[int64] = cast[Ptr[int64]](arg)
    kaddr: uint64 = cast[uint64](r[63])
    buf: Array[128, uint8]
    st: Array[128, uint8]
    r[0] = cast[int64](sys_getpid())
    r[1] = cast[int64](cpu_control() & 1)
    r[2] = cast[int64](sys_mkdir("/t"))
    fd: int32 = sys_open_write("/t/a.txt")
    r[3] = cast[int64](fd)
    r[4] = sys_write(fd, "hello world\n", 12)
    r[5] = cast[int64](sys_close(fd))
    fd = sys_open("/t/a.txt")
    r[6] = sys_read(fd, &buf[0], 64)
    r[7] = _eq(&buf[0], "hello world\n", 12)
    r[8] = sys_lseek(fd, 6, 0)
    sys_read(fd, &buf[0], 5)
    r[9] = _eq(&buf[0], "world", 5)
    r[10] = sys_lseek(fd, 0, 2)
    r[11] = sys_read(fd, &buf[0], 16)
    r[12] = sys_stat_p9("/t/a.txt", &st[0], 128)
    r[13] = _u32at(&st[0], 33)                       # length
    r[14] = cast[int64](st[8])                       # qid.type
    r[15] = _eq(&st[43], "a.txt", 5) + cast[int64](st[41])    # name: 1 + length 5
    sys_stat_p9("/t", &st[0], 128)
    r[16] = cast[int64](st[8])
    dfd: int32 = sys_open("/t")
    r[17] = sys_read(dfd, &buf[0], 64)
    r[18] = _eq(&buf[0], "a.txt\n", 6)
    sys_close(dfd)
    r[19] = cast[int64](sys_unlink("/t/a.txt"))      # still open: EBUSY
    r[20] = cast[int64](sys_close(fd))
    r[21] = cast[int64](sys_rename("/t/a.txt", "/t/b.txt"))
    r[22] = cast[int64](sys_open("/t/a.txt"))        # gone: ENOENT
    buf[0] = 0
    sys_errstr(&buf[0], 64)
    r[23] = _eq(&buf[0], "file does not exist", 20)
    r[24] = cast[int64](sys_remove("/t"))            # not empty
    r[25] = cast[int64](sys_unlink("/t/b.txt"))
    r[26] = cast[int64](sys_remove("/t"))
    r[27] = cast[int64](sys_open("/t"))
    # pointers the kernel must refuse
    r[28] = sys_write(1, cast[Ptr[uint8]](kaddr), 4)
    r[29] = cast[int64](sys_open(cast[Ptr[uint8]](kaddr)))
    fd = sys_open("/dev/zero")
    r[30] = sys_read(fd, cast[Ptr[uint8]](kaddr), 4)
    lit: Ptr[uint8] = "read-only literal"
    r[31] = sys_read(fd, lit, 4)                     # constants are not writable
    buf[0] = 9
    buf[7] = 9
    r[32] = sys_read(fd, &buf[0], 8) + cast[int64](buf[0]) + cast[int64](buf[7])
    sys_close(fd)
    r[33] = hackos_syscall(9999, 0, 0, 0, 0, 0, 0)
    fd = sys_open_write("/dev/null")
    r[34] = sys_write(fd, "discarded", 9)
    sys_close(fd)
    fd = sys_open("/dev/null")
    r[35] = sys_read(fd, &buf[0], 8)
    sys_close(fd)
    fd = sys_open("/etc")
    r[36] = sys_write(fd, "x", 1)                    # a directory: EBADF
    sys_close(fd)
    j0: uint64 = sys_get_jiffies()
    sys_sleep_ms(50)
    r[37] = cast[int64](sys_get_jiffies() - j0)
    m: int64 = sys_mmap(0, 8192, 3, 0x22, -1, 0)
    r[38] = m
    mp: Ptr[uint32] = cast[Ptr[uint32]](cast[uint64](m))
    r[39] = cast[int64](mp[0]) + cast[int64](mp[2047])   # zero filled
    mp[2047] = 0x12345678
    r[40] = cast[int64](mp[2047])
    r[41] = sys_munmap(cast[uint64](m), 8192)
    r[42] = sys_munmap(cast[uint64](m), 8192)        # twice: EINVAL
    tid: int64 = sys_thread_spawn(cast[uint64](&u_child), 14, 3, 4096)
    r[43] = tid
    code: Array[1, int64]
    code[0] = 0
    r[44] = cast[int64](sys_thread_join(cast[uint32](tid), &code[0]))
    r[45] = code[0]
    r[46] = cast[int64](sys_create("/tmp/sub", 0, 0x800001ED))
    fd = sys_create("/tmp/sub/c.bin", 0, 0x1A4)
    sys_write(fd, &st[0], 100)
    sys_fstat_p9(fd, &st[0], 128)
    r[47] = _u32at(&st[0], 33)
    d2: int32 = sys_dup(fd)
    sys_write(d2, "tail", 4)                         # shares the offset
    r[48] = sys_lseek(fd, 0, 1)
    sys_close(d2)
    sys_close(fd)
    r[49] = cast[int64](sys_chdir("/tmp/sub"))
    r[50] = sys_getcwd(&buf[0], 64)
    r[51] = _eq(&buf[0], "/tmp/sub", 9)
    fd = sys_open("c.bin")                           # relative to the cwd
    r[52] = sys_lseek(fd, 0, 2)
    sys_close(fd)
    fd = sys_open("../../tmp/./sub//c.bin")
    r[53] = cast[int64](fd)
    sys_close(fd)
    sys_unlink("c.bin")
    sys_chdir("/")
    r[54] = cast[int64](sys_remove("/tmp/sub"))
    r[55] = cast[int64](sys_chdir("/nowhere"))
    r[56] = cast[int64](sys_close(11))
    fd = sys_open("/dev/console")
    r[57] = _puts(fd, "[user thread writes to /dev/console]\n")
    sys_close(fd)
    r[58] = cast[int64](sys_gettid())
    r[59] = cast[int64](sys_dup2(1, 9))
    r[60] = _puts(9, "[and through a dup2'd descriptor]\n")
    sys_close(9)
    ts: Array[4, int64]
    ts[0] = 0
    ts[1] = 30000000                                 # 30 ms
    ts[2] = 5
    ts[3] = 5
    j0 = sys_get_jiffies()
    r[61] = sys_nanosleep(&ts[0], &ts[2]) + ts[2] + ts[3]
    r[62] = cast[int64](sys_get_jiffies() - j0)
    return 77
