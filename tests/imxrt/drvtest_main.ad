# Driver test image (QEMU mps2-an500; tests/imxrt/drvtest.sh): the i.MX RT
# drivers, compiled unchanged, against register models (tests/imxrt/models/).
#
# soc/imxrt/reg.ad and delay.ad are replaced in this image's source tree (and
# imported here under those names: the same file under two paths would be
# two modules), so
# every register access of LPUART, LPI2C, LPSPI, GPIO, IOMUXC and the CCM
# code is answered by a model at the RT1062's addresses, and every delay
# advances the models' clock.  The models are my reading of the reference
# manual (not an independent oracle); what this proves is that the drivers
# do what that reading requires, including their error and time-out paths.
# The clock arithmetic is checked against frequencies worked out by hand from
# NXP's documented mux values.
#
# Output: "PASS name" / "FAIL name" per check, then the exit status line.

from kernel.start import hackos_start
from kernel.fault import hackos_fault
from kernel.print import kputs, kputc, kput_u64, kput_hex32
from soc.imxrt.reg import m_iomuxc, m_ccm, m_analog, m_unmodelled, m_unmodelled_addr
