# Stand-in for soc/imxrt/delay.ad in the uSDHC test image on QEMU's i.MX6UL
# (no DWT there; QEMU's models answer at once, so a short loop is enough).
# The drivers count their time limits in delay_us(1) calls, so every limit
# is still a bounded number of polls.

# The names soc/imxrt/delay.ad exports besides the functions.
DWT_CYCCNT: uint64 = 0xE0001004
delay_calls: uint64 = 0


def delay_init(max_core_mhz: uint32):
    delay_calls = 0


def delay_us(us: uint32):
    delay_calls = delay_calls + cast[uint64](us)
