extern def fp_hold(seed: uint64, loops: uint64) -> uint64

failures: uint32 = 0


def check(ok: uint32, name: Ptr[uint8]):
    if ok != 0:
        printk1("PASS %s\n", cast[uint64](name))
    else:
        printk1("FAIL %s\n", cast[uint64](name))
        failures = failures + 1


def spawn(name: Ptr[uint8], entry: uint64, arg: uint64, prio: uint32, flags: uint32) -> uint32:
    t: Ptr[Thread] = thread_create(name, entry, arg, prio, 4096, flags)
    if t == cast[Ptr[Thread]](0):
        return 0
    return t[0].tid


def join(tid: uint32) -> int64:
    code: int64 = -9999
    thread_join(tid, &code)
    return code


# ============================================================ 1. boot state
def test_boot():
    printk0("-- 1. boot state\n")
    check(cast[uint32]((cpu_control() & 3) == 2 and cpu_ipsr() == 0), "runner: thread mode, process stack, privileged")
    check(cast[uint32](mpu_regions() == 16 and (mmio_read32(0xE000ED94) & 5) == 5), "mpu: 16 regions, enabled, privileged default map")
    check(cast[uint32]((mmio_read32(0xE000EF34) >> 30) == 3), "fpu: automatic + lazy state saving (FPCCR.ASPEN|LSPEN)")
    check(cast[uint32](mmio_read32(0xE000ED08) == 0x1000), "vector table behind the null guard (VTOR = 0x1000)")
    printk3("   kernel heap %d bytes, user arena %d bytes, %d threads at start\n", heap_total(&kheap), heap_total(&uheap), 3)


# ============================================================ 2. heap
hp_slot: Array[64, uint64]
hp_size: Array[64, uint32]
hp_seed: uint32 = 12345


def hp_rand() -> uint32:
    hp_seed = hp_seed * 1103515245 + 12345
    return (hp_seed >> 8) & 0xFFFFFF


def test_heap():
    printk0("-- 2. kernel heap\n")
    used0: uint32 = kheap.used_bytes
    live0: uint32 = kheap.n_live
    blocks0: uint64 = heap_free_blocks(&kheap)
    large0: uint64 = heap_largest_free(&kheap)
    a: uint64 = kmalloc(100)
    b: uint64 = kmalloc(200)
    c: uint64 = kmalloc(300)
    check(cast[uint32](a != 0 and b != 0 and c != 0 and ((a | b | c) & 15) == 0 and b > a and c > b), "heap: allocations are distinct and 16-byte aligned")
    printk2("   overhead: 3 blocks for 600 requested bytes take %d (16-byte header + rounding to 16)\n", cast[uint64](kheap.used_bytes - used0), 0)
    kfree(b)
    fb1: uint64 = heap_free_blocks(&kheap)
    kfree(a)
    fb2: uint64 = heap_free_blocks(&kheap)
    kfree(c)
    fb3: uint64 = heap_free_blocks(&kheap)
    check(cast[uint32](fb1 == blocks0 + 1 and fb2 == blocks0 + 1 and fb3 == blocks0 and kheap.used_bytes == used0), "heap: freed neighbours coalesce in both directions")
    al: uint64 = kmalloc_aligned(5000, 4096)
    check(cast[uint32](al != 0 and (al & 4095) == 0 and heap_check(&kheap) == 0), "heap: 4 KiB-aligned allocation")
    kfree(al)
    check(cast[uint32](heap_free(&kheap, al) == -1 and heap_check(&kheap) == 0), "heap: double free refused, heap intact")
    fail0: uint32 = kheap.n_fail
    check(cast[uint32](kmalloc(64 * 1024 * 1024) == 0 and kheap.n_fail == fail0 + 1), "heap: impossible request returns 0 and is counted")
    # churn: 20000 random allocate/verify/free steps over 64 slots
    i: uint32 = 0
    while i < 64:
        hp_slot[i] = 0
        i = i + 1
    bad: uint32 = 0
    nofit: uint32 = 0
    maxfrag: uint64 = 0
    step: uint32 = 0
    while step < 20000:
        s: uint32 = hp_rand() % 64
        if hp_slot[s] != 0:
            p: Ptr[uint8] = cast[Ptr[uint8]](hp_slot[s])
            k: uint32 = 0
            while k < hp_size[s]:
                if p[k] != cast[uint8](s * 7 + k):
                    bad = bad + 1
                k = k + 1
            kfree(hp_slot[s])
            hp_slot[s] = 0
        else:
            sz: uint32 = 1 + hp_rand() % 3000
            q: uint64 = 0
            if (hp_rand() & 7) == 0:
                q = kmalloc_aligned(cast[uint64](sz), cast[uint64](64) << cast[uint64](hp_rand() % 5))
            else:
                q = kmalloc(cast[uint64](sz))
            if q == 0:
                nofit = nofit + 1
            else:
                hp_slot[s] = q
                hp_size[s] = sz
                p2: Ptr[uint8] = cast[Ptr[uint8]](q)
                k2: uint32 = 0
                while k2 < sz:
                    p2[k2] = cast[uint8](s * 7 + k2)
                    k2 = k2 + 1
        if (step % 500) == 0:
            if heap_check(&kheap) != 0:
                bad = bad + 1000
            fbn: uint64 = heap_free_blocks(&kheap)
            if fbn > maxfrag:
                maxfrag = fbn
        step = step + 1
    check(cast[uint32](bad == 0 and nofit == 0), "heap churn: 20000 steps, every block kept its contents, heap consistent")
    printk3("   churn: peak %d bytes in use, at most %d free fragments, %d live blocks at the end\n", cast[uint64](kheap.peak_bytes), maxfrag, cast[uint64](kheap.n_live - live0))
    i = 0
    while i < 64:
        if hp_slot[i] != 0:
            kfree(hp_slot[i])
        i = i + 1
    check(cast[uint32](kheap.used_bytes == used0 and kheap.n_live == live0), "heap churn: no leak (bytes and blocks back to the start)")
    check(cast[uint32](heap_free_blocks(&kheap) == blocks0 and heap_largest_free(&kheap) == large0 and heap_check(&kheap) == 0), "heap churn: no fragmentation left (free list as at the start)")


# ============================================================ 3. threads
th_flag: volatile uint32 = 0
th_flag2: volatile uint32 = 0
th_stop: volatile uint32 = 0
th_count: Array[4, uint64]
th_order: Array[16, uint32]
th_order_n: volatile uint32 = 0
th_wake: Array[4, uint64]


def th_log(id: uint32):
    irq: uint32 = cpu_irq_save()
    if th_order_n < 16:
        th_order[th_order_n] = id
        th_order_n = th_order_n + 1
    cpu_irq_restore(irq)


def w_exit(arg: uint64) -> int64:
    return cast[int64](arg) * 2 + 1


def w_flag(arg: uint64) -> int64:
    th_flag = cast[uint32](arg)
    return 0


def w_flag2(arg: uint64) -> int64:
    th_flag2 = cast[uint32](arg)
    return 0


def w_sleeper(arg: uint64) -> int64:
    t0: uint64 = sched_now()
    thread_sleep(arg * 10)
    th_wake[arg] = sched_now() - t0
    th_log(cast[uint32](arg))
    return 0


def w_spin(arg: uint64) -> int64:
    n: uint64 = 0
    while th_stop == 0:
        n = n + 1
    th_count[arg] = n
    return 0


def w_yielder(arg: uint64) -> int64:
    i: uint32 = 0
    while i < 4:
        th_log(cast[uint32](arg))
        thread_yield()
        i = i + 1
    return 0


def w_nop(arg: uint64) -> int64:
    return 0


th_tids: Array[32, uint32]


def test_threads():
    printk0("-- 3. threads, sleep, time slices, priorities\n")
    check(cast[uint32](join(spawn("exit", cast[uint64](&w_exit), 20, 3, 0)) == 41), "thread: create, run, exit code through join")
    t0: uint64 = sched_now()
    thread_sleep(50)
    d: uint64 = sched_now() - t0
    printk1("   thread_sleep(50) took %d ticks\n", d)
    check(cast[uint32](d == 50), "sleep: 50 ticks by the SysTick count")
    th_order_n = 0
    s3: uint32 = spawn("sleep3", cast[uint64](&w_sleeper), 3, 3, 0)
    s1: uint32 = spawn("sleep1", cast[uint64](&w_sleeper), 1, 3, 0)
    s2: uint32 = spawn("sleep2", cast[uint64](&w_sleeper), 2, 3, 0)
    join(s3)
    join(s1)
    join(s2)
    check(cast[uint32](th_order[0] == 1 and th_order[1] == 2 and th_order[2] == 3), "sleep: three sleepers wake in deadline order")
    printk3("   sleepers measured %d, %d and %d ticks\n", th_wake[1], th_wake[2], th_wake[3])
    check(cast[uint32](th_wake[1] == 10 and th_wake[2] == 20 and th_wake[3] == 30), "sleep: each sleeper measured its own 10/20/30 ticks")
    # two threads that never yield or block must both make progress
    th_stop = 0
    sw0: uint64 = sched_switches
    a: uint32 = spawn("spin0", cast[uint64](&w_spin), 0, 4, 0)
    b: uint32 = spawn("spin1", cast[uint64](&w_spin), 1, 4, 0)
    thread_sleep(100)
    th_stop = 1
    join(a)
    swa: uint64 = reap_switches
    join(b)
    swb: uint64 = reap_switches
    printk4("   spinners counted %d and %d, were switched in %d and %d times\n", th_count[0], th_count[1], swa, swb)
    check(cast[uint32](th_count[0] > 1000 and th_count[1] > 1000 and swa >= 4 and swb >= 4), "preemption: two CPU-bound threads share the CPU by time slice")
    check(cast[uint32](th_count[0] < th_count[1] * 3 and th_count[1] < th_count[0] * 3), "preemption: round robin is roughly fair")
    # priorities: the runner has priority 2
    th_flag = 0
    hi: uint32 = spawn("hi", cast[uint64](&w_flag), 7, 1, 0)
    check(cast[uint32](th_flag == 7), "priority: a more urgent thread runs before thread_create returns")
    join(hi)
    th_flag2 = 0
    lo: uint32 = spawn("lo", cast[uint64](&w_flag2), 9, 5, 0)
    before: uint32 = th_flag2
    join(lo)
    check(cast[uint32](before == 0 and th_flag2 == 9), "priority: a less urgent thread waits until the runner blocks")
    th_order_n = 0
    y1: uint32 = spawn("yield1", cast[uint64](&w_yielder), 1, 3, 0)
    y2: uint32 = spawn("yield2", cast[uint64](&w_yielder), 2, 3, 0)
    join(y1)
    join(y2)
    check(cast[uint32](th_order_n == 8 and th_order[0] == 1 and th_order[1] == 2 and th_order[2] == 1 and th_order[3] == 2 and th_order[6] == 1 and th_order[7] == 2), "yield: two equal threads alternate")
    # fill the thread table, then release everything
    live0: uint32 = kheap.n_live
    n: uint32 = 0
    while n < 32:
        th_tids[n] = spawn("fill", cast[uint64](&w_nop), 0, 5, 0)
        if th_tids[n] == 0:
            break
        n = n + 1
    k: uint32 = 0
    while k < n:
        join(th_tids[k])
        k = k + 1
    printk1("   %d more threads fitted in the table\n", cast[uint64](n))
    check(cast[uint32](n == 29 and kheap.n_live == live0), "thread table: full at 32 threads (29 + idle, reaper, runner); joins release every stack")


# ============================================================ 4. FP context
# Expected checksums: output of tests/reference_m2.py.
EXP1: uint64 = 0x62e4dcaf4e253d6c
EXP2: uint64 = 0x0632d33d64327bd0
EXP3: uint64 = 0x6b09613201aeb380
EXP4: uint64 = 0x76db175d7964cced
EXP5: uint64 = 0x2ed09b786f1da182
EXP6: uint64 = 0x5ed2b94a73d1b0c7


def w_stress(seed: uint64) -> int64:
    return cast[int64](stress_mix(seed, 12000, 0))


def w_fphold(seed: uint64) -> int64:
    return cast[int64](fp_hold(seed, 20000))


# Count a just-joined thread if it was switched in at least three times.
def busy(n: uint32) -> uint32:
    if reap_switches >= 3:
        return n + 1
    return n


def test_fp_switch():
    printk0("-- 4. context-switch stress: float64 and 64-bit integer maths under preemption\n")
    sw0: uint64 = sched_switches
    t0: uint64 = sched_now()
    k1: uint32 = spawn("mixk1", cast[uint64](&w_stress), 1, 4, 0)
    k2: uint32 = spawn("mixk2", cast[uint64](&w_stress), 2, 4, 0)
    k3: uint32 = spawn("mixk3", cast[uint64](&w_stress), 3, 4, 0)
    k4: uint32 = spawn("mixk4", cast[uint64](&w_stress), 4, 4, 0)
    u5: uint32 = spawn("mixu5", cast[uint64](&u_stress), 5, 4, TF_USER)
    u6: uint32 = spawn("mixu6", cast[uint64](&u_stress), 6, 4, TF_USER)
    hk: uint32 = spawn("fpk", cast[uint64](&w_fphold), 0x1000, 4, 0)
    hu: uint32 = spawn("fpu", cast[uint64](&u_fphold), 0x2000, 4, TF_USER)
    hk2: uint32 = spawn("fpk2", cast[uint64](&w_fphold), 0x3000, 4, 0)
    r1: uint64 = cast[uint64](join(k1))
    nsw: uint32 = busy(0)
    r2: uint64 = cast[uint64](join(k2))
    nsw = busy(nsw)
    r3: uint64 = cast[uint64](join(k3))
    nsw = busy(nsw)
    r4: uint64 = cast[uint64](join(k4))
    nsw = busy(nsw)
    r5: uint64 = cast[uint64](join(u5))
    nsw = busy(nsw)
    r6: uint64 = cast[uint64](join(u6))
    nsw = busy(nsw)
    h1: uint64 = cast[uint64](join(hk))
    nsw = busy(nsw)
    h2: uint64 = cast[uint64](join(hu))
    nsw = busy(nsw)
    h3: uint64 = cast[uint64](join(hk2))
    nsw = busy(nsw)
    printk3("   9 threads, %d ticks, %d context switches; %d of the threads were switched in 3 times or more\n", sched_now() - t0, sched_switches - sw0, cast[uint64](nsw))
    printk4("   checksums %x %x %x %x\n", r1, r2, r3, r4)
    check(cast[uint32](nsw >= 7 and sched_switches - sw0 >= 40), "stress: the threads were preempted and resumed many times while computing")
    check(cast[uint32](r1 == EXP1 and r2 == EXP2), "stress: privileged threads 1-2 match the host reference bit for bit")
    check(cast[uint32](r3 == EXP3 and r4 == EXP4), "stress: privileged threads 3-4 match the host reference bit for bit")
    check(cast[uint32](r5 == EXP5 and r6 == EXP6), "stress: unprivileged threads (with system calls in the loop) match")
    check(cast[uint32](h1 == 0 and h3 == 0), "fp registers: d0-d15 held their patterns in two privileged threads")
    check(cast[uint32](h2 == 0), "fp registers: d0-d15 held their patterns in an unprivileged thread")


# ============================================================ 5. synchronisation
sy_m: Mutex
sy_shared: volatile uint64 = 0
sy_sem: Semaphore
sy_cv: Cond
sy_ready: volatile uint32 = 0
sy_woken: volatile uint32 = 0
sy_tokens: volatile uint32 = 0
sy_q: MsgQueue
sy_sum: uint64 = 0
sy_seq_ok: uint32 = 0
sy_prio_seen: uint32 = 0
sy_got: volatile uint32 = 0
sy_rc: volatile int32 = 0


def spin(n: uint64):
    k: uint64 = 0
    while k < n:
        th_flag2 = th_flag2 + 1
        k = k + 1


def w_counter(arg: uint64) -> int64:
    i: uint32 = 0
    while i < 300:
        mutex_lock(&sy_m)
        tmp: uint64 = sy_shared
        spin(2000)
        sy_shared = tmp + 1
        mutex_unlock(&sy_m)
        i = i + 1
    return 0


# priority inversion cast: L (5) holds the mutex, M (4) hogs the CPU, H (3) wants the mutex
def w_low(arg: uint64) -> int64:
    mutex_lock(&sy_m)
    sy_got = 1
    spin(1200000)
    sy_prio_seen = thr(sched_current)[0].prio
    th_log(1)
    mutex_unlock(&sy_m)
    return cast[int64](thr(sched_current)[0].prio)


def w_mid(arg: uint64) -> int64:
    spin(3000000)
    th_log(2)
    return 0


def w_high(arg: uint64) -> int64:
    mutex_lock(&sy_m)
    th_log(3)
    mutex_unlock(&sy_m)
    return 0


def w_holder(arg: uint64) -> int64:
    mutex_lock(&sy_m)
    sy_got = 1
    thread_sleep(40)
    mutex_unlock(&sy_m)
    return 0


def w_foreign_unlock(arg: uint64) -> int64:
    return cast[int64](mutex_unlock(&sy_m))


def w_producer(arg: uint64) -> int64:
    i: uint32 = 0
    while i < 50:
        sem_post(&sy_sem)
        if (i & 7) == 0:
            thread_yield()
        i = i + 1
    return 0


def w_consumer(arg: uint64) -> int64:
    n: int64 = 0
    while n < 50:
        if sem_wait_timeout(&sy_sem, 500) != SYNC_OK:
            break
        n = n + 1
    return n


def w_cv_all(arg: uint64) -> int64:
    mutex_lock(&sy_m)
    while sy_ready == 0:
        cond_wait(&sy_cv, &sy_m)
    sy_woken = sy_woken + 1
    mutex_unlock(&sy_m)
    return 0


def w_cv_token(arg: uint64) -> int64:
    mutex_lock(&sy_m)
    while sy_tokens == 0:
        cond_wait(&sy_cv, &sy_m)
    sy_tokens = sy_tokens - 1
    sy_woken = sy_woken + 1
    mutex_unlock(&sy_m)
    return 0


def w_mq_send(arg: uint64) -> int64:
    msg: Array[2, uint32]
    i: uint32 = 0
    while i < 200:
        msg[0] = i
        msg[1] = i * 3 + 1
        if mq_send(&sy_q, cast[uint64](&msg[0]), 1000) != SYNC_OK:
            return -1
        i = i + 1
    return 0


def w_mq_recv(arg: uint64) -> int64:
    msg: Array[2, uint32]
    i: uint32 = 0
    ok: uint32 = 1
    sum: uint64 = 0
    while i < 200:
        if mq_recv(&sy_q, cast[uint64](&msg[0]), 1000) != SYNC_OK:
            return -1
        if msg[0] != i:
            ok = 0
        sum = sum + cast[uint64](msg[1])
        if (i % 50) == 49:
            thread_sleep(2)             # let the queue fill: the sender must block
        i = i + 1
    sy_sum = sum
    sy_seq_ok = ok
    return 0


def test_sync():
    printk0("-- 5. mutex, semaphore, condition variable, message queue\n")
    mutex_init(&sy_m)
    sy_shared = 0
    c0: uint32 = spawn("cnt0", cast[uint64](&w_counter), 0, 4, 0)
    c1: uint32 = spawn("cnt1", cast[uint64](&w_counter), 1, 4, 0)
    c2: uint32 = spawn("cnt2", cast[uint64](&w_counter), 2, 4, 0)
    c3: uint32 = spawn("cnt3", cast[uint64](&w_counter), 3, 4, 0)
    join(c0)
    join(c1)
    join(c2)
    join(c3)
    printk2("   shared counter %d, lockers had to wait %d times\n", sy_shared, cast[uint64](sy_m.contended))
    check(cast[uint32](sy_shared == 1200), "mutex: 4 threads x 300 read-modify-write steps lose no update")
    check(cast[uint32](sy_m.contended > 0), "mutex: the lock was contended (threads were preempted inside it)")
    check(cast[uint32](mutex_lock(&sy_m) == SYNC_OK and mutex_lock(&sy_m) == SYNC_EDEADLK), "mutex: locking it twice is refused, not a deadlock")
    fu: int64 = join(spawn("foreign", cast[uint64](&w_foreign_unlock), 0, 1, 0))
    check(cast[uint32](fu == cast[int64](SYNC_EPERM) and mutex_unlock(&sy_m) == SYNC_OK), "mutex: only the owner can unlock")
    sy_got = 0
    h: uint32 = spawn("holder", cast[uint64](&w_holder), 0, 3, 0)
    thread_sleep(5)
    t0: uint64 = sched_now()
    r_try: int32 = mutex_trylock(&sy_m)
    r_to: int32 = mutex_lock_timeout(&sy_m, 10)
    dt: uint64 = sched_now() - t0
    r_lock: int32 = mutex_lock(&sy_m)
    dt2: uint64 = sched_now() - t0
    mutex_unlock(&sy_m)
    join(h)
    printk2("   timed lock gave up after %d ticks, plain lock got it after %d\n", dt, dt2)
    check(cast[uint32](sy_got == 1 and r_try == SYNC_TIMEOUT and r_to == SYNC_TIMEOUT and dt == 10), "mutex: trylock and a 10-tick timed lock fail while it is held")
    check(cast[uint32](r_lock == SYNC_OK and dt2 == 35), "mutex: a blocked locker gets it when the holder releases")
    # priority inheritance
    th_order_n = 0
    sy_got = 0
    lo: uint32 = spawn("low", cast[uint64](&w_low), 0, 5, 0)
    while sy_got == 0:
        thread_sleep(1)
    hi: uint32 = spawn("high", cast[uint64](&w_high), 0, 3, 0)
    mid: uint32 = spawn("mid", cast[uint64](&w_mid), 0, 4, 0)
    lowp: int64 = join(lo)
    join(hi)
    join(mid)
    printk4("   order of completion: %d %d %d (1 = low releases, 3 = high gets the mutex, 2 = middle finishes); low ran at priority %d\n", cast[uint64](th_order[0]), cast[uint64](th_order[1]), cast[uint64](th_order[2]), cast[uint64](sy_prio_seen))
    check(cast[uint32](th_order[0] == 1 and th_order[1] == 3 and th_order[2] == 2), "priority inheritance: the middle thread cannot starve the mutex holder")
    check(cast[uint32](sy_prio_seen == 3 and lowp == 5), "priority inheritance: holder boosted to 3 while holding, back to 5 after")
    # semaphore
    sem_init(&sy_sem, 0)
    cons: uint32 = spawn("consumer", cast[uint64](&w_consumer), 0, 3, 0)
    prod: uint32 = spawn("producer", cast[uint64](&w_producer), 0, 4, 0)
    join(prod)
    check(cast[uint32](join(cons) == 50 and sy_sem.count == 0), "semaphore: 50 posts, 50 waits, count back to zero")
    t0 = sched_now()
    r_sem: int32 = sem_wait_timeout(&sy_sem, 20)
    check(cast[uint32](r_sem == SYNC_TIMEOUT and sched_now() - t0 == 20), "semaphore: a timed wait on an empty semaphore gives up after 20 ticks")
    # condition variable
    cond_init(&sy_cv)
    sy_ready = 0
    sy_woken = 0
    w1: uint32 = spawn("cv1", cast[uint64](&w_cv_all), 0, 3, 0)
    w2: uint32 = spawn("cv2", cast[uint64](&w_cv_all), 0, 3, 0)
    w3: uint32 = spawn("cv3", cast[uint64](&w_cv_all), 0, 3, 0)
    thread_sleep(10)
    early: uint32 = sy_woken
    mutex_lock(&sy_m)
    sy_ready = 1
    mutex_unlock(&sy_m)
    cond_broadcast(&sy_cv)
    join(w1)
    join(w2)
    join(w3)
    check(cast[uint32](early == 0 and sy_woken == 3), "condition: broadcast wakes all three waiters, none before")
    sy_tokens = 0
    sy_woken = 0
    w1 = spawn("tok1", cast[uint64](&w_cv_token), 0, 3, 0)
    w2 = spawn("tok2", cast[uint64](&w_cv_token), 0, 3, 0)
    thread_sleep(5)
    mutex_lock(&sy_m)
    sy_tokens = 1
    mutex_unlock(&sy_m)
    cond_signal(&sy_cv)
    thread_sleep(10)
    one: uint32 = sy_woken
    mutex_lock(&sy_m)
    sy_tokens = 1
    mutex_unlock(&sy_m)
    cond_signal(&sy_cv)
    join(w1)
    join(w2)
    check(cast[uint32](one == 1 and sy_woken == 2), "condition: signal wakes exactly one waiter at a time")
    mutex_lock(&sy_m)
    t0 = sched_now()
    r_cv: int32 = cond_wait_timeout(&sy_cv, &sy_m, 15)
    check(cast[uint32](r_cv == SYNC_TIMEOUT and sched_now() - t0 == 15 and mutex_unlock(&sy_m) == SYNC_OK), "condition: a timed wait gives up after 15 ticks holding the mutex again")
    # message queue
    mq_init(&sy_q, 8, 4)
    rx: uint32 = spawn("mqrecv", cast[uint64](&w_mq_recv), 0, 4, 0)
    tx: uint32 = spawn("mqsend", cast[uint64](&w_mq_send), 0, 4, 0)
    rtx: int64 = join(tx)
    rrx: int64 = join(rx)
    check(cast[uint32](rtx == 0 and rrx == 0 and sy_seq_ok == 1 and sy_sum == 59900), "message queue: 200 messages through 4 slots, in order, none lost")
    msg: Array[2, uint32]
    t0 = sched_now()
    r_mq: int32 = mq_recv(&sy_q, cast[uint64](&msg[0]), 12)
    check(cast[uint32](r_mq == SYNC_TIMEOUT and sched_now() - t0 == 12), "message queue: receive on an empty queue times out after 12 ticks")
    mq_destroy(&sy_q)


# ============================================================ 6. system calls
sc_canary: volatile uint32 = 0x0BADCAFE


def test_syscalls():
    printk0("-- 6. system calls from an unprivileged thread\n")
    ulive0: uint32 = uheap.n_live
    ures: uint64 = umalloc_aligned(64 * 8, 16)
    r: Ptr[int64] = cast[Ptr[int64]](ures)
    i: uint32 = 0
    while i < 64:
        r[i] = -7777
        i = i + 1
    r[63] = cast[int64](cast[uint64](&sc_canary))     # a kernel address
    sc0: uint64 = sys_count
    bp0: uint64 = sys_bad_ptr
    open0: uint32 = vfs_open_count()
    t: Ptr[Thread] = thread_create("usys", cast[uint64](&u_syscalls), ures, 3, 8192, TF_USER)
    tid: uint32 = t[0].tid
    code: int64 = join(tid)
    printk3("   the thread made %d system calls; %d were refused for a bad pointer; kernel stack high-water %d bytes\n", sys_count - sc0, sys_bad_ptr - bp0, reap_stack_used)
    check(cast[uint32](code == 77), "syscall: the unprivileged thread ran to its end (exit code through SVC)")
    check(cast[uint32](r[0] == cast[int64](tid) and r[58] == cast[int64](tid)), "syscall: getpid and gettid return the thread id")
    check(cast[uint32](r[1] == 1), "syscall: the thread really is unprivileged (CONTROL.nPRIV = 1)")
    check(cast[uint32](r[2] == 0 and r[3] == 3 and r[4] == 12 and r[5] == 0), "syscall: mkdir, open_write (first free fd is 3), write, close")
    check(cast[uint32](r[6] == 12 and r[7] == 1), "syscall: open + read return what was written")
    check(cast[uint32](r[8] == 6 and r[9] == 1 and r[10] == 12 and r[11] == 0), "syscall: lseek SET and END, read at the offset, 0 at end of file")
    check(cast[uint32](r[12] == 72 and r[13] == 12 and r[14] == 0 and r[15] == 6), "syscall: stat returns a 9P record (length 12, plain file, name a.txt)")
    check(cast[uint32](r[16] == 0x80), "syscall: stat marks a directory (qid.type = QTDIR)")
    check(cast[uint32](r[17] == 6 and r[18] == 1), "syscall: reading a directory lists its names, one per line")
    check(cast[uint32](r[19] == -16 and r[20] == 0), "syscall: unlink of an open file is refused (EBUSY), close succeeds")
    check(cast[uint32](r[21] == 0 and r[22] == -2 and r[23] == 1), "syscall: rename; the old name is gone (ENOENT, errstr says why)")
    check(cast[uint32](r[24] == -39 and r[25] == 0 and r[26] == 0 and r[27] == -2), "syscall: remove refuses a non-empty directory, then removes file and directory")
    check(cast[uint32](r[28] == -14 and r[29] == -14 and r[30] == -14), "syscall: kernel addresses as buffer or path are refused (EFAULT)")
    check(cast[uint32](r[31] == -14 and sc_canary == 0x0BADCAFE), "syscall: a read into constant data is refused; kernel memory untouched")
    check(cast[uint32](r[32] == 8 and r[34] == 9 and r[35] == 0), "syscall: /dev/zero reads zeros, /dev/null swallows writes and reads empty")
    check(cast[uint32](r[33] == -38 and r[36] == -9 and r[56] == -9), "syscall: unknown number is ENOSYS, bad descriptors are EBADF")
    printk1("   sleep_ms(50) measured %d jiffies (100 Hz)\n", cast[uint64](r[37]))
    check(cast[uint32](r[37] == 5 or r[37] == 6), "syscall: sleep_ms(50) takes 5 jiffies by get_jiffies")
    check(cast[uint32](r[61] == 0 and (r[62] == 3 or r[62] == 4)), "syscall: nanosleep(30 ms) takes 3 jiffies and clears the remaining time")
    check(cast[uint32](r[38] >= 0x60F00000 and r[39] == 0 and r[40] == 0x12345678 and r[41] == 0 and r[42] == -22), "syscall: mmap gives zeroed user memory, munmap frees it once")
    check(cast[uint32](r[43] > 0 and r[44] == 0 and r[45] == 43), "syscall: thread_spawn + thread_join from user mode, exit code 43")
    check(cast[uint32](r[46] == 0 and r[47] == 100 and r[48] == 104 and r[52] == 104), "syscall: create (dir and file), fstat, dup shares the file offset")
    check(cast[uint32](r[49] == 0 and r[50] == 9 and r[51] == 1 and r[53] >= 0), "syscall: chdir, getcwd, relative and dot-dot paths")
    check(cast[uint32](r[54] == 0 and r[55] == -2), "syscall: remove of the emptied directory; chdir to nowhere fails")
    check(cast[uint32](r[57] == 0 and r[59] == 9 and r[60] == 0), "syscall: writes to /dev/console and through dup2")
    check(cast[uint32](vfs_open_count() == open0), "syscall: no open file left behind by the thread")
    ufree(ures)
    check(cast[uint32](uheap.n_live == ulive0), "syscall: user arena back to its starting block count (stacks freed)")


# ============================================================ 7. memory protection
mp_secret: volatile uint32 = 0x5EC2E7
mp_beat: volatile uint64 = 0
mp_stop: volatile uint32 = 0


def w_heartbeat(arg: uint64) -> int64:
    while mp_stop == 0:
        mp_beat = mp_beat + 1
        thread_sleep(1)
    return 0


def test_mpu():
    printk0("-- 7. memory protection: each fault must end only the thread that caused it\n")
    klive0: uint32 = kheap.n_live
    ulive0: uint32 = uheap.n_live
    hb: uint32 = spawn("heartbeat", cast[uint64](&w_heartbeat), 0, 1, 0)
    beat0: uint64 = mp_beat
    tc0: uint32 = trap_count
    # (a) unprivileged stack overflow
    t: uint32 = spawn("deep-user", cast[uint64](&fault_stack_overflow), 1, 3, TF_USER)
    code: int64 = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t and trap_last_kind == FAULT_STACK_OVERFLOW), "mpu: unprivileged stack overflow hits the guard, thread ended (139)")
    check(cast[uint32](trap_last_addr >= 0x60F00000 and (trap_last_addr & 0x3FF) < 0x400 and trap_count == tc0 + 1), "mpu: the faulting address is inside the thread's user-stack guard")
    # (b) privileged stack overflow
    t = spawn("deep-kern", cast[uint64](&fault_stack_overflow), 1, 3, 0)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t and trap_last_kind == FAULT_STACK_OVERFLOW and trap_last_addr < 0x60400000 and trap_last_addr >= 0x60000000), "mpu: a kernel thread overflowing its stack is caught the same way")
    # (c) unprivileged read and write of kernel data
    t = spawn("peek", cast[uint64](&fault_read), cast[uint64](&mp_secret), 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t and trap_last_kind == FAULT_ACCESS and trap_last_addr == cast[uint32](cast[uint64](&mp_secret))), "mpu: unprivileged read of a kernel variable faults at its address")
    t = spawn("poke", cast[uint64](&fault_write), cast[uint64](&mp_secret), 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_kind == FAULT_ACCESS and mp_secret == 0x5EC2E7), "mpu: unprivileged write to a kernel variable faults, value unchanged")
    t = spawn("heap-peek", cast[uint64](&fault_read), cast[uint64](kheap.base) + 64, 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_addr == kheap.base + 64), "mpu: unprivileged read of the kernel heap faults")
    t = spawn("uart-poke", cast[uint64](&fault_write), 0x40004000, 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_addr == 0x40004000), "mpu: unprivileged write to a peripheral register faults")
    # (d) the same functions run to completion when allowed
    t = spawn("kpeek", cast[uint64](&fault_read), cast[uint64](&mp_secret), 3, 0)
    check(cast[uint32](join(t) == 0x5EC2E7 + 1000), "mpu: control -- a privileged thread reads the same variable normally")
    um: uint64 = umalloc_aligned(64, 16)
    cast[Ptr[uint32]](um)[0] = 41
    t = spawn("upeek", cast[uint64](&fault_read), um, 3, TF_USER)
    check(cast[uint32](join(t) == 1041), "mpu: control -- an unprivileged thread reads user-arena memory normally")
    # (e) null pointers
    t = spawn("null-user", cast[uint64](&fault_read), 0, 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t and trap_last_addr == 0), "mpu: unprivileged null pointer read faults at address 0")
    t = spawn("null-kern", cast[uint64](&fault_write), 8, 3, 0)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t and trap_last_addr == 8), "mpu: privileged null pointer write (offset 8) faults too")
    t = spawn("jump-null", cast[uint64](&fault_jump), 0, 3, 0)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t), "mpu: calling a null function pointer faults")
    # (f) code and constants are read-only, data is not executable
    lit: Ptr[uint8] = "constant text"
    t = spawn("rom-write", cast[uint64](&fault_write), cast[uint64](lit), 3, 0)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_addr == cast[uint32](cast[uint64](lit)) and lit[0] == 99), "mpu: even privileged code cannot write to constants")
    cast[Ptr[uint16]](um)[0] = 0x4770                # `bx lr`
    t = spawn("exec-data", cast[uint64](&fault_jump), um + 1, 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 139 and trap_last_tid == t), "mpu: data is not executable (jump into the user arena faults)")
    ufree(um)
    # (g) an undefined instruction is a usage fault, also survivable
    t = spawn("undefined", cast[uint64](&fault_udf), 0, 3, TF_USER)
    code = join(t)
    check(cast[uint32](code == 132 and trap_last_kind == FAULT_USAGE), "fault: undefined instruction ends the thread with 132")
    # (h) the kernel-only svc numbers are not for threads
    t = spawn("bad-svc", cast[uint64](&fault_badsvc), 7, 3, TF_USER)
    code = join(t)
    t = spawn("fake-ret", cast[uint64](&fault_badsvc), 1, 3, TF_USER)
    code2: int64 = join(t)
    check(cast[uint32](code == 132 and code2 == 132 and trap_last_tid == t), "fault: an unknown svc and a forged return-from-system-call end the thread, not the kernel")
    mp_stop = 1
    join(hb)
    printk2("   %d faults handled; the heartbeat thread counted %d beats meanwhile\n", cast[uint64](trap_count - tc0), mp_beat - beat0)
    check(cast[uint32](trap_count == tc0 + 14 and mp_beat > beat0), "fault: fourteen faults, the other threads kept running")
    check(cast[uint32](kheap.n_live == klive0 and uheap.n_live == ulive0 and heap_check(&kheap) == 0 and heap_check(&uheap) == 0), "fault: the stacks of all ended threads were released, heaps intact")


# ============================================================ 8. file system
fs_buf: Array[4096, uint8]


def fs_pattern(i: uint64) -> uint8:
    return cast[uint8]((i * 31 + (i >> 8) * 7 + 5) & 255)


def test_fs():
    printk0("-- 8. file system (Hamnix tmpfs through the HackOS file layer)\n")
    open0: uint32 = vfs_open_count()
    # a file larger than three 64 KiB tmpfs chunks, written in odd-sized pieces
    fd: int32 = vfs_open("/tmp/big.bin", OWRITE | OTRUNC | OCREATE)
    total: uint64 = 0
    okw: uint32 = 1
    while total < 200000:
        n: uint64 = 3001
        if total + n > 200000:
            n = 200000 - total
        k: uint64 = 0
        while k < n:
            fs_buf[k] = fs_pattern(total + k)
            k = k + 1
        if vfs_write(fd, &fs_buf[0], n) != cast[int64](n):
            okw = 0
            break
        total = total + n
    vfs_close(fd)
    fd = vfs_open("/tmp/big.bin", OREAD)
    size: int64 = vfs_lseek(fd, 0, 2)
    vfs_lseek(fd, 0, 0)
    bad: uint64 = 0
    pos: uint64 = 0
    got: int64 = vfs_read(fd, &fs_buf[0], 4096, 0)
    while got > 0:
        k2: uint64 = 0
        while k2 < cast[uint64](got):
            if fs_buf[k2] != fs_pattern(pos + k2):
                bad = bad + 1
            k2 = k2 + 1
        pos = pos + cast[uint64](got)
        got = vfs_read(fd, &fs_buf[0], 4096, 0)
    # random access across a chunk boundary
    vfs_lseek(fd, 65530, 0)
    vfs_read(fd, &fs_buf[0], 12, 0)
    edge: uint32 = 1
    k3: uint64 = 0
    while k3 < 12:
        if fs_buf[k3] != fs_pattern(65530 + k3):
            edge = 0
        k3 = k3 + 1
    vfs_close(fd)
    check(cast[uint32](okw == 1 and size == 200000 and pos == 200000 and bad == 0), "fs: 200000-byte file written in pieces reads back identical")
    check(cast[uint32](edge == 1), "fs: seek + read across a 64 KiB chunk boundary")
    # append and truncate
    fd = vfs_open("/tmp/log.txt", OWRITE | OCREATE)
    vfs_write(fd, "one\n", 4)
    vfs_close(fd)
    fd = vfs_open("/tmp/log.txt", OWRITE | OAPPEND)
    vfs_write(fd, "two\n", 4)
    vfs_close(fd)
    fd = vfs_open("/tmp/log.txt", OREAD)
    n2: int64 = vfs_read(fd, &fs_buf[0], 64, 0)
    vfs_close(fd)
    app: uint32 = cast[uint32](n2 == 8 and fs_buf[0] == 111 and fs_buf[4] == 116 and fs_buf[7] == 10)
    fd = vfs_open("/tmp/log.txt", OWRITE | OTRUNC)
    vfs_close(fd)
    fd = vfs_open("/tmp/log.txt", OREAD)
    n3: int64 = vfs_read(fd, &fs_buf[0], 64, 0)
    vfs_close(fd)
    check(cast[uint32](app == 1 and n3 == 0), "fs: append adds at the end, truncate empties the file")
    # many small files in a directory
    vfs_mkdir("/tmp/many")
    name: Array[32, uint8]
    made: uint32 = 0
    i: uint32 = 0
    while i < 40:
        name[0] = 47
        name[1] = 116
        name[2] = 109
        name[3] = 112
        name[4] = 47
        name[5] = 109
        name[6] = 97
        name[7] = 110
        name[8] = 121
        name[9] = 47
        name[10] = 102
        name[11] = cast[uint8](48 + i / 10)
        name[12] = cast[uint8](48 + i % 10)
        name[13] = 0
        fd = vfs_open(&name[0], OWRITE | OCREATE)
        if fd >= 0:
            vfs_write(fd, &name[0], 13)
            vfs_close(fd)
            made = made + 1
        i = i + 1
    fd = vfs_open("/tmp/many", OREAD)
    listed: int64 = vfs_read(fd, &fs_buf[0], 4096, 0)
    vfs_close(fd)
    check(cast[uint32](made == 40 and listed == 160 and fs_buf[0] == 102 and fs_buf[3] == 10), "fs: 40 files created, the directory lists 40 names")
    check(cast[uint32](vfs_unlink("/tmp/many") == -39), "fs: a directory with files in it cannot be removed")
    removed: uint32 = 0
    i = 0
    while i < 40:
        name[11] = cast[uint8](48 + i / 10)
        name[12] = cast[uint8](48 + i % 10)
        if vfs_unlink(&name[0]) == 0:
            removed = removed + 1
        i = i + 1
    check(cast[uint32](removed == 40 and vfs_unlink("/tmp/many") == 0 and vfs_open("/tmp/many", OREAD) == -2), "fs: all 40 removed, then the directory")
    check(cast[uint32](vfs_rename("/tmp/big.bin", "/etc/moved.bin") == 0 and vfs_open("/tmp/big.bin", OREAD) == -2), "fs: rename across directories")
    fd = vfs_open("/etc/moved.bin", OREAD)
    sz2: int64 = vfs_lseek(fd, 0, 2)
    vfs_close(fd)
    check(cast[uint32](sz2 == 200000 and vfs_unlink("/etc/moved.bin") == 0 and vfs_unlink("/tmp/log.txt") == 0), "fs: the renamed file kept its contents; clean-up")
    check(cast[uint32](vfs_open("/dev/nothing", OREAD) == -2 and vfs_mkdir("/dev/x") == -30 and vfs_unlink("/") == -16), "fs: /dev is fixed, the root cannot be removed")
    check(cast[uint32](vfs_open_count() == open0), "fs: no descriptor leaked")
    printk2("   kernel heap after the file tests: %d bytes in %d live blocks\n", cast[uint64](kheap.used_bytes), cast[uint64](kheap.n_live))


# ============================================================ 9. console input
def line_is(buf: Ptr[uint8], n: int64, want: Ptr[uint8]) -> uint32:
    i: int64 = 0
    while want[i] != 0:
        if i >= n or buf[i] != want[i]:
            return 0
        i = i + 1
    if i == n:
        return 1
    return 0


def test_console():
    printk0("-- 9. console: lines typed into QEMU's serial port (injected by the harness)\n")
    buf: Array[128, uint8]
    console_rx_enable()
    n: int64 = vfs_read(0, &buf[0], 127, 0)
    check(line_is(&buf[0], n, "status report\n"), "console: a line arrives through the UART receive interrupt")
    n = vfs_read(0, &buf[0], 127, 0)
    check(line_is(&buf[0], n, "backspace works\n"), "console: backspace and DEL erase characters")
    n = vfs_read(0, &buf[0], 127, 0)
    check(line_is(&buf[0], n, "second try\n"), "console: Ctrl-U erases the line")
    n = vfs_read(0, &buf[0], 4, 0)
    n2: int64 = vfs_read(0, &buf[4], 100, 0)
    check(cast[uint32](n == 4 and n2 == 6 and line_is(&buf[0], 10, "long line\n") == 1), "console: a short read takes part of a line, the next read the rest")
    n = vfs_read(0, &buf[0], 127, 0)
    check(cast[uint32](n == 0), "console: Ctrl-D on an empty line reads as end of file")
    n = console_read(&buf[0], 16, 1)
    check(cast[uint32](n == 0 and con_rx_irqs > 0 and con_rx_dropped == 0), "console: non-blocking read returns 0 when nothing is waiting")
    printk2("   %d bytes received in %d receive interrupts\n", con_rx_bytes, con_rx_irqs)
    # raw mode: bytes fed by the test itself, not by the UART
    console_set_mode(CON_RAW)
    irq: uint32 = cpu_irq_save()
    console_input(27)
    console_input(91)
    console_input(65)
    console_input(13)
    cpu_irq_restore(irq)
    n = console_read(&buf[0], 16, 1)
    console_set_mode(CON_COOKED)
    check(cast[uint32](n == 4 and buf[0] == 27 and buf[2] == 65 and buf[3] == 13), "console: raw mode passes bytes through unedited (fed by the test, not the UART)")


# ============================================================ 10. C code
def test_c():
    printk0("-- 10. C code linked into the image: direct calls both ways, a vendor driver\n")
    check(ci_scalars(), "C: integers of every width, float and double arguments, signed results")
    check(ci_callback(), "C: a C function calls an Adder function through a pointer, 10 times")
    check(ci_structs(), "C: structures by pointer in both directions; C library shim (memset, strlen, ...)")
    check(ci_sht_serial(), "SHT4x driver (Sensirion, C): serial number read from the emulated sensor")
    check(ci_sht_measure(), "SHT4x driver: 25.0 C / 56.5 %RH measured; its 10 ms wait slept in the scheduler")
    printk3("   driver reported %d milli-C, %d milli-%%RH; the measurement took %d ticks\n", cast[uint64](ci_t[0]), cast[uint64](ci_rh[0]), ci_dt)
    check(ci_sht_negative(), "SHT4x driver: negative temperature and raw ticks through pointers")
    check(ci_sht_errors(), "SHT4x driver: CRC error detected, soft reset, missing device reported as -1")
    printk3("   the C driver made %d calls into Adder (bus and sleep); the emulated sensor saw %d writes and %d reads\n", hal_calls, cast[uint64](fk_writes), cast[uint64](fk_reads))


# ============================================================ benchmark
bn_n: volatile uint64 = 0


def w_ping(arg: uint64) -> int64:
    i: uint64 = 0
    while i < arg:
        thread_yield()
        i = i + 1
    return 0


def cycles_now() -> uint64:
    irq: uint32 = cpu_irq_save()
    t: uint64 = sched_now()
    cv: uint32 = mmio_read32(0xE000E018)
    t2: uint64 = sched_now()
    cpu_irq_restore(irq)
    return t * 25000 + cast[uint64](24999 - cv)


def bench_switch():
    # Two threads that only yield to each other: 2 x N switches.  The figure is
    # cycles of the emulated 25 MHz timer (40 ns).  The harness runs QEMU with
    # -icount shift=5, which advances the clock 32 ns per instruction, so
    # instructions = cycles * 40 / 32.  Without -icount it is only wall time.
    c0: uint64 = cycles_now()
    sw0: uint64 = sched_switches
    a: uint32 = spawn("ping", cast[uint64](&w_ping), 2000, 4, 0)
    b: uint32 = spawn("pong", cast[uint64](&w_ping), 2000, 4, 0)
    join(a)
    join(b)
    c1: uint64 = cycles_now()
    printk3("BENCH yield ping-pong: %d context switches in %d timer cycles\n", sched_switches - sw0, c1 - c0, 0)
    # 4000 system calls from an unprivileged thread, against the same thread
    # start/exit overhead without them.
    c0 = cycles_now()
    join(spawn("sysbench", cast[uint64](&u_bench_sys), 4000, 3, TF_USER))
    c1 = cycles_now()
    join(spawn("sysbase", cast[uint64](&u_bench_sys), 0, 3, TF_USER))
    c2: uint64 = cycles_now()
    printk3("BENCH system call: %d calls in %d timer cycles (thread start and exit alone: %d)\n", 4000, c1 - c0, c2 - c1)
    printk2("BENCH sizes: Thread %d bytes, %d thread slots\n", sizeof(Thread), cast[uint64](THREAD_MAX))


# ============================================================ 11. processes
pargv: Array[8, uint64]


def run_prog(path: Ptr[uint8], a1: Ptr[uint8], a2: Ptr[uint8], a3: Ptr[uint8]) -> int64:
    n: uint32 = 1
    pargv[0] = cast[uint64](path)
    if a1 != cast[Ptr[uint8]](0):
        pargv[1] = cast[uint64](a1)
        n = 2
    if a2 != cast[Ptr[uint8]](0):
        pargv[2] = cast[uint64](a2)
        n = 3
    if a3 != cast[Ptr[uint8]](0):
        pargv[3] = cast[uint64](a3)
        n = 4
    pid: int32 = proc_spawn(path, n, &pargv[0], 3)
    if pid < 0:
        return cast[int64](pid)
    return proc_waitpid(pid, 0)


def hexstr(v: uint32, out: Ptr[uint8]) -> Ptr[uint8]:
    i: uint32 = 0
    while i < 8:
        n: uint32 = (v >> (28 - i * 4)) & 15
        if n < 10:
            out[i] = cast[uint8](48 + n)
        else:
            out[i] = cast[uint8](87 + n)
        i = i + 1
    out[8] = 0
    return out


def threads_in_use() -> uint32:
    n: uint32 = 0
    i: uint32 = 0
    while i < THREAD_MAX:
        if threads[i].state != T_UNUSED:
            n = n + 1
        i = i + 1
    return n


def w_lockfault(arg: uint64) -> int64:
    mutex_lock(&fs_lock)
    p: Ptr[volatile uint32] = cast[Ptr[volatile uint32]](arg)
    return cast[int64](p[0])            # arg is 0: faults with the lock held


def test_proc():
    printk0("-- 11. processes: programs loaded from /bin into their own memory\n")
    hx: Array[12, uint8]
    nul: Ptr[uint8] = cast[Ptr[uint8]](0)
    plive0: uint32 = parena_live()
    klive0: uint32 = kheap.n_live
    thr0: uint32 = threads_in_use()
    open0: uint32 = vfs_open_count()
    code: int64 = run_prog("/bin/hello", "one", "two", nul)
    check(cast[uint32](code == 3), "proc: /bin/hello loaded, ran unprivileged, exit code = argc")
    check(cast[uint32](parena_live() == plive0 and kheap.n_live == klive0 and threads_in_use() == thr0), "proc: block, kernel stack and table slot were returned")
    printk3("   /bin/hello: block %d bytes (stack %d, image %d)", cast[uint64](proc_last_block), cast[uint64](proc_last_stack), cast[uint64](proc_last_image))
    printk1(", %d relocations\n", cast[uint64](proc_last_relocs))
    code = run_prog("/bin/ptest", "image", nul, nul)
    printk1("   ptest image -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 127), "proc: data, zeroed bss, constants, function pointers, 64-bit divide, FP in a loaded program")
    code = run_prog("/bin/crel", nul, nul, nul)
    check(cast[uint32](code == 7 and proc_last_relocs == 7), "proc: a C program; 7 R_ARM_RELATIVE relocations applied by the loader")
    code = run_prog("/bin/ptest", "heap", nul, nul)
    printk1("   ptest heap -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 31), "proc: a heap inside the program's own block (mmap, munmap, reuse, exhaustion)")
    # a new program must find nothing in its registers (user/progs/regprobe.S
    # exits with 1 = core register, 2 = FP register, 4 = FPSCR not zero)
    code = run_prog("/bin/regprobe", nul, nul, nul)
    printk1("   regprobe -> %d", cast[uint64](code))
    rc2: int64 = run_prog("/bin/ptest", "regspawn", nul, nul)
    printk1(", after a spawn by a process that uses the FPU -> %d", cast[uint64](rc2 - 16))
    rc3: int64 = run_prog("/bin/ptest", "regexec", nul, nul)
    printk1(", after an exec with every register dirty -> %d\n", cast[uint64](rc3))
    check(cast[uint32](code == 0 and rc2 == 16), "proc: a spawned program starts with zeroed core and FP registers and FPSCR, whatever its creator left in them")
    check(cast[uint32](rc3 == 0), "proc: so does a program started by exec (callee-saved and FP registers of the old image are gone)")
    pargv[0] = cast[uint64]("/bin/ptest")
    pargv[1] = cast[uint64]("fpspin")
    fpid: int32 = proc_spawn("/bin/ptest", 2, &pargv[0], 3)
    dirty: int64 = 0
    ri: uint32 = 0
    while ri < 20:
        dirty = dirty | run_prog("/bin/regprobe", nul, nul, nul)
        ri = ri + 1
    proc_waitpid(fpid, 0)
    check(cast[uint32](fpid > 0 and dirty == 0), "proc: 20 programs started while another process keeps the FP registers busy all see zeros")
    check(cast[uint32](run_prog("/bin/nothing", nul, nul, nul) == -2), "proc: a missing program is ENOENT")
    fd: int32 = vfs_open("/tmp/junk", OWRITE | OTRUNC | OCREATE)
    vfs_write(fd, "this is not an ELF file, not even close ........................", 64)
    vfs_close(fd)
    check(cast[uint32](run_prog("/tmp/junk", nul, nul, nul) == -8 and parena_live() == plive0), "proc: a file that is not a program is ENOEXEC, nothing left allocated")
    vfs_unlink("/tmp/junk")

    # two instances of one program at once: different blocks, own data
    pargv[0] = cast[uint64]("/bin/ptest")
    pargv[1] = cast[uint64]("where")
    pargv[2] = cast[uint64]("00001111")
    pa: int32 = proc_spawn("/bin/ptest", 3, &pargv[0], 3)
    pargv[2] = cast[uint64]("00002222")
    pb: int32 = proc_spawn("/bin/ptest", 3, &pargv[0], 3)
    ta: Ptr[Thread] = thread_by_tid(cast[uint32](pa))
    tb: Ptr[Thread] = thread_by_tid(cast[uint32](pb))
    alo: uint32 = ta[0].mem_lo
    ahi: uint32 = ta[0].mem_hi
    blo: uint32 = tb[0].mem_lo
    printk3("   two instances of ptest: blocks at 0x%x and 0x%x, %d bytes each\n", cast[uint64](alo), cast[uint64](blo), cast[uint64](ahi - alo))
    check(cast[uint32](pa > 0 and pb > 0 and alo != blo and (ahi <= blo or tb[0].mem_hi <= alo) and alo >= 0x60400000 and ahi <= 0x60F00000), "proc: two instances of one program get separate blocks in the program arena")
    thread_sleep(20)
    # while both are alive: a third process tries to reach into the first
    tc0: uint32 = trap_count
    code = run_prog("/bin/ptest", "poke", hexstr(alo + 0x2100, &hx[0]), nul)
    check(cast[uint32](code == 139 and trap_count == tc0 + 1 and trap_last_addr == alo + 0x2100 and trap_last_kind == FAULT_ACCESS), "isolation: a process writing into ANOTHER process's block faults; only it is ended")
    code = run_prog("/bin/ptest", "peek", hexstr(alo + 0x2100, &hx[0]), nul)
    check(cast[uint32](code == 139 and trap_last_addr == alo + 0x2100), "isolation: reading another process's block faults too")
    check(cast[uint32](proc_waitpid(pa, 0) == 77 and proc_waitpid(pb, 0) == 77), "isolation: both instances kept their own data and ended normally")
    code = run_prog("/bin/ptest", "peek", hexstr(cast[uint32](cast[uint64](&failures)), &hx[0]), nul)
    check(cast[uint32](code == 139 and trap_last_addr == cast[uint32](cast[uint64](&failures))), "isolation: a process reading kernel data faults")
    code = run_prog("/bin/ptest", "peek", hexstr(cast[uint32](cast[uint64](&test_proc)) & 0xFFFFFFFC, &hx[0]), nul)
    check(cast[uint32](code == 139), "isolation: the kernel image's code is not readable by a process either")
    code = run_prog("/bin/ptest", "peek", "60f00000", nul)
    check(cast[uint32](code == 139), "isolation: nor is the arena of the in-image unprivileged threads")
    code = run_prog("/bin/ptest", "poke", "40004000", nul)
    check(cast[uint32](code == 139 and trap_last_addr == 0x40004000), "isolation: a process writing to a peripheral register faults")
    tc0 = trap_count
    code = run_prog("/bin/ptest", "bkpt", nul, nul)
    check(cast[uint32](code == 132 and trap_count == tc0 + 1), "isolation: a breakpoint instruction in a process ends the process, not the system")
    tc0 = trap_count
    code = run_prog("/bin/ptest", "badsp", nul, nul)
    check(cast[uint32](code == 139 and trap_count == tc0 + 1), "isolation: a system call made with the stack pointer aimed at kernel memory ends the process, not the system")
    sb0: uint64 = sys_bad_ptr
    code = run_prog("/bin/ptest", "sysptr", hexstr(cast[uint32](cast[uint64](&failures)), &hx[0]), nul)
    check(cast[uint32](code == 14 and sys_bad_ptr == sb0 + 1), "isolation: the kernel refuses a system-call buffer outside the caller's block (EFAULT)")
    code = run_prog("/bin/ptest", "sysptr", "60f00000", nul)
    check(cast[uint32](code == 14), "isolation: ... including memory another kind of thread may use")

    # stack overflow: the stack is the bottom of the block
    tc0 = trap_count
    code = run_prog("/bin/ptest", "deep", nul, nul)
    check(cast[uint32](code == 139 and trap_count == tc0 + 1 and trap_last_kind == FAULT_STACK_OVERFLOW), "proc: stack overflow by deep recursion is caught and reported as such")
    code = run_prog("/bin/ptest", "huge", nul, nul)
    check(cast[uint32](code == 139 and trap_last_kind == FAULT_STACK_OVERFLOW), "proc: a 6 KB frame cannot step over anything: still a stack overflow")
    thread_sleep(5)
    check(cast[uint32](parena_live() == plive0 and kheap.n_live == klive0 and threads_in_use() == thr0 and vfs_open_count() == open0), "proc: after 10 faulted processes: no block, stack, slot or open file left behind")

    # spawn, rfork + exec, wait -- from inside a process
    code = run_prog("/bin/ptest", "spawn", "/bin/hello", nul)
    printk1("   ptest spawn -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 15), "proc: spawn from a process; waitpid_jc polls, reports (3 << 8 | 1), then ECHILD; missing program ENOENT")
    ex0: uint64 = proc_execs
    code = run_prog("/bin/ptest", "fork", "/bin/hello", nul)
    printk1("   ptest fork -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 127 and proc_execs == ex0 + 1), "proc: rfork as vfork + exec + waitpid; parent's stack and FP state restored, descriptors private")
    code = run_prog("/bin/ptest", "forkfail", nul, nul)
    printk1("   ptest forkfail -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 7), "proc: exec failures in the child (ENOENT, ENOEXEC) and a child that only exits")
    code = run_prog("/bin/ptest", "cwd", nul, nul)
    c2: int64 = run_prog("/bin/ptest", "thread", nul, nul)
    printk2("   ptest cwd -> %d, thread -> %d\n", cast[uint64](code), cast[uint64](c2))
    check(cast[uint32](code == 5 and c2 == 38), "proc: working directory is per process; a process cannot start threads (ENOSYS)")
    code = run_prog("/bin/ptest", "orphan", nul, nul)
    live_mid: uint32 = threads_in_use()
    thread_sleep(120)
    check(cast[uint32](code == 60 and live_mid == thr0 + 1 and threads_in_use() == thr0 and parena_live() == plive0), "proc: a child that outlives its parent is collected by the reaper")
    check(cast[uint32](proc_waitpid(9999, 0) == -10 and proc_waitpid_jc(9999, cast[Ptr[int64]](0)) == -10), "proc: waiting for a process that does not exist is ECHILD")

    # ending a process group from outside (what Ctrl-C at the console does)
    pargv[0] = cast[uint64]("/bin/ptest")
    pargv[1] = cast[uint64]("loop")
    pk1: int32 = proc_spawn("/bin/ptest", 2, &pargv[0], 4)
    pargv[1] = cast[uint64]("block")
    pk2: int32 = proc_spawn("/bin/ptest", 2, &pargv[0], 4)
    thread_by_tid(cast[uint32](pk1))[0].pgid = 4242
    thread_by_tid(cast[uint32](pk2))[0].pgid = 4242
    thread_sleep(30)
    alive: uint32 = cast[uint32](thread_by_tid(cast[uint32](pk1))[0].state != T_ZOMBIE and thread_by_tid(cast[uint32](pk2))[0].state != T_ZOMBIE)
    nk: uint32 = sched_kill_group(4242)
    ck1: int64 = proc_waitpid(pk1, 0)
    ck2: int64 = proc_waitpid(pk2, 0)
    check(cast[uint32](alive != 0 and nk == 2 and ck1 == 130 and ck2 == 130 and sched_kill_group(4242) == 0), "proc: ending a process group stops a process that loops in its own code and one that waits in the kernel (130)")

    # a thread that faults while it holds a kernel lock
    md0: uint32 = mutex_dead_released
    t: uint32 = spawn("lockfault", cast[uint64](&w_lockfault), 0, 3, 0)
    code = join(t)
    fd = vfs_open("/tmp/afterlock", OWRITE | OTRUNC | OCREATE)
    vfs_close(fd)
    check(cast[uint32](code == 139 and mutex_dead_released == md0 + 1 and fd >= 0 and vfs_unlink("/tmp/afterlock") == 0), "fault: a thread that dies holding the file-system lock does not block the file system")
    vfs_unlink("/tmp/notelf")           # left by `ptest forkfail`
    check(cast[uint32](parena_live() == plive0 and kheap.n_live == klive0 and threads_in_use() == thr0 and vfs_open_count() == open0 and parena_check() == 0 and heap_check(&kheap) == 0), "proc: everything released at the end of the group, heaps consistent")
    printk2("   %d processes created so far, %d of them through exec\n", proc_spawned, proc_execs)
    printk4("   program arena blocks %d (was %d), kernel heap blocks %d (was %d)", cast[uint64](parena_live()), cast[uint64](plive0), cast[uint64](kheap.n_live), cast[uint64](klive0))
    printk4(", threads %d (was %d), open files %d (was %d)\n", cast[uint64](threads_in_use()), cast[uint64](thr0), cast[uint64](vfs_open_count()), cast[uint64](open0))


# ============================================================ 12. pipes, /fd names
def test_pipes():
    printk0("-- 12. pipes and /fd names\n")
    nul: Ptr[uint8] = cast[Ptr[uint8]](0)
    klive0: uint32 = kheap.n_live
    open0: uint32 = vfs_open_count()
    # the pipe object itself, from kernel threads
    s: int32 = pipe_alloc_chan(1)
    pipe_inc_reader(s)
    pipe_inc_writer(s)
    buf: Array[32, uint8]
    w: int64 = pipe_write(s, "0123456789", 10, 0)
    r1: int64 = pipe_read(s, &buf[0], 4, 0)
    r2: int64 = pipe_read(s, &buf[4], 28, 0)
    check(cast[uint32](s >= 0 and w == 10 and r1 == 4 and r2 == 6 and buf[0] == 48 and buf[9] == 57 and pipe_read(s, &buf[0], 8, 1) == 0), "pipe: bytes in order, short reads, non-blocking read of an empty pipe is 0")
    pipe_close_writer(s)
    check(cast[uint32](pipe_read(s, &buf[0], 8, 0) == 0 and pipe_read(s, &buf[0], 8, 1) == -1 and pipe_live == 1), "pipe: end of file once the last writer is gone")
    pipe_close_reader(s)
    check(cast[uint32](pipe_live == 0 and kheap.n_live == klive0), "pipe: freed when the last reference goes")
    code: int64 = run_prog("/bin/ptest", "pipe", nul, nul)
    printk1("   ptest pipe -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 255 and pipe_live == 0), "/fd: a process binds both ends of a pipe at /fd names: data, kinds, end of file, EPIPE, rebinding")
    code = run_prog("/bin/ptest", "pipexfer", "00040000", nul)
    check(cast[uint32](code == 3 and pipe_live == 0), "pipe: 256 KiB from one process to another through a 4 KiB pipe, every byte checked")
    code = run_prog("/bin/ptest", "vfpipe", nul, nul)
    check(cast[uint32](code == 40 and pipe_live == 0), "pipe: a child of rfork that has not exec'ed is not put to sleep on a full pipe (EAGAIN)")
    code = run_prog("/bin/ptest", "redir", "/bin/hello", nul)
    printk1("   ptest redir -> %d\n", cast[uint64](code))
    check(cast[uint32](code == 15), "/fd: the parent binds its child's /fd/1 to a file after the spawn; the child was held until then")
    vfs_unlink("/tmp/redir.out")
    check(cast[uint32](kheap.n_live == klive0 and vfs_open_count() == open0 and pipe_live == 0 and heap_check(&kheap) == 0), "pipe: nothing left allocated or open")


# ============================================================ 13. FAT
fat_io: Array[4096, uint8]


def pat(i: uint64) -> uint8:
    return cast[uint8]((i * 7 + 3) & 255)


def test_fat():
    printk0("-- 13. FAT32 on the RAM disk (Hamnix fs/fat.ad through the file layer), mounted at /sd\n")
    nul: Ptr[uint8] = cast[Ptr[uint8]](0)
    klive0: uint32 = kheap.n_live
    open0: uint32 = vfs_open_count()
    check(fat_mounted, "fat: the volume QEMU loaded into the RAM disk was recognised and mounted")
    fd: int32 = vfs_open("/sd/README.TXT", OREAD)
    n: int64 = vfs_read(fd, &fat_io[0], 4096, 0)
    vfs_close(fd)
    check(cast[uint32](fd >= 0 and n == 101 and fat_io[0] == 84 and fat_io[100] == 10), "fat: read a file that the host put there")
    fd = vfs_open("/sd/A long file name.text", OREAD)
    n = vfs_read(fd, &fat_io[0], 4096, 0)
    vfs_close(fd)
    check(cast[uint32](fd >= 0 and n == 101), "fat: open by long file name")
    # 40000 bytes over 79 clusters of 512 bytes, read in odd-sized pieces
    fd = vfs_open("/sd/PATTERN.BIN", OREAD)
    total: uint64 = 0
    bad: uint64 = 0
    while 1 == 1:
        n = vfs_read(fd, &fat_io[0], 1000, 0)
        if n <= 0:
            break
        i: uint64 = 0
        while i < cast[uint64](n):
            if fat_io[i] != pat(total + i):
                bad = bad + 1
            i = i + 1
        total = total + cast[uint64](n)
    sk: int64 = vfs_lseek(fd, 33333, 0)
    vfs_read(fd, &fat_io[0], 4, 0)
    end: int64 = vfs_lseek(fd, 0, 2)
    vfs_close(fd)
    check(cast[uint32](total == 40000 and bad == 0), "fat: a 40000-byte file across 79 clusters reads back byte for byte")
    check(cast[uint32](sk == 33333 and fat_io[0] == pat(33333) and fat_io[3] == pat(33336) and end == 40000), "fat: seek inside a file, and to its end")
    fd = vfs_open("/sd/DOCS", OREAD)
    n = vfs_read(fd, &fat_io[0], 4096, 0)
    vfs_close(fd)
    fat_io[cast[uint64](n)] = 0
    check(cast[uint32](n == 11 and fat_io[5] == 72 and fat_io[9] == 79), "fat: a sub-directory lists its entries (. .. HELLO)")
    check(cast[uint32](vfs_open("/sd/NOPE.TXT", OREAD) == -2 and vfs_open("/sd/DOCS", OWRITE | OTRUNC | OCREATE) == -21), "fat: a missing file is ENOENT, writing to a directory EISDIR")
    check(cast[uint32](run_prog("/sd/DOCS/HELLO", "card", nul, nul) == 2), "fat: a program loaded from the card runs")
    # write: create, 20000 bytes in pieces, read back, append, overwrite, remove
    fd = vfs_open("/sd/NEW.BIN", OWRITE | OTRUNC | OCREATE)
    w: uint64 = 0
    while w < 20000:
        k: uint64 = 0
        while k < 2500:
            fat_io[k] = pat(w + k + 11)
            k = k + 1
        if vfs_write(fd, &fat_io[0], 2500) != 2500:
            break
        w = w + 2500
    vfs_close(fd)
    fd = vfs_open("/sd/NEW.BIN", OREAD)
    total = 0
    bad = 0
    while 1 == 1:
        n = vfs_read(fd, &fat_io[0], 4096, 0)
        if n <= 0:
            break
        j: uint64 = 0
        while j < cast[uint64](n):
            if fat_io[j] != pat(total + j + 11):
                bad = bad + 1
            j = j + 1
        total = total + cast[uint64](n)
    vfs_close(fd)
    check(cast[uint32](w == 20000 and total == 20000 and bad == 0), "fat: a new 20000-byte file, written in pieces, reads back byte for byte")
    fd = vfs_open("/sd/NEW.BIN", OWRITE | OAPPEND)
    vfs_write(fd, "tail", 4)
    vfs_close(fd)
    fd = vfs_open("/sd/NEW.BIN", OREAD)
    vfs_lseek(fd, 19998, 0)
    n = vfs_read(fd, &fat_io[0], 100, 0)
    vfs_close(fd)
    check(cast[uint32](n == 6 and fat_io[1] == pat(19999 + 11) and fat_io[2] == 116 and fat_io[5] == 108), "fat: append adds at the end")
    fd = vfs_open("/sd/NEW.BIN", OWRITE | OTRUNC | OCREATE)
    vfs_write(fd, "short", 5)
    vfs_close(fd)
    fd = vfs_open("/sd/NEW.BIN", OREAD)
    n = vfs_read(fd, &fat_io[0], 100, 0)
    vfs_close(fd)
    check(cast[uint32](n == 5 and fat_io[0] == 115), "fat: opening for write truncates an existing file")
    r1: int32 = vfs_unlink("/sd/NEW.BIN")
    check(cast[uint32](r1 == 0 and vfs_open("/sd/NEW.BIN", OREAD) == -2 and vfs_unlink("/sd/NEW.BIN") == -2), "fat: remove; the name is gone")
    # the volume is still intact after the writes
    fd = vfs_open("/sd/PATTERN.BIN", OREAD)
    vfs_lseek(fd, 39990, 0)
    n = vfs_read(fd, &fat_io[0], 100, 0)
    vfs_close(fd)
    check(cast[uint32](n == 10 and fat_io[9] == pat(39999) and kheap.n_live == klive0 and vfs_open_count() == open0), "fat: the other files are untouched; nothing left open or allocated")
    printk2("   block device ram0: %d sectors read, %d written\n", blkdevs[0].rd_sectors, blkdevs[0].wr_sectors)


# ============================================================ process benchmarks
def bench_proc():
    nul: Ptr[uint8] = cast[Ptr[uint8]](0)
    # spawn + exit + wait of a small program (8 KB file, 16 KB block)
    c0: uint64 = cycles_now()
    i: uint32 = 0
    while i < 20:
        run_prog("/bin/ptest", "nop", nul, nul)
        i = i + 1
    c1: uint64 = cycles_now()
    printk2("BENCH spawn: %d x (spawn + exit + wait) of /bin/ptest in %d timer cycles\n", 20, c1 - c0)
    # the same through rfork + exec, from a process (0x14 = 20 times)
    c0 = cycles_now()
    run_prog("/bin/ptest", "forkbench", "14", nul)
    c1 = cycles_now()
    printk2("BENCH rfork: %d x (rfork + exec + exit + wait) of /bin/ptest in %d timer cycles (one spawn of the driver included)\n", 20, c1 - c0)
    # a large program: the shell running an empty script
    fd: int32 = vfs_open("/tmp/empty.hsh", OWRITE | OTRUNC | OCREATE)
    vfs_write(fd, "exit 0\n", 7)
    vfs_close(fd)
    c0 = cycles_now()
    code: int64 = run_prog("/bin/hamsh", "/tmp/empty.hsh", nul, nul)
    c1 = cycles_now()
    vfs_unlink("/tmp/empty.hsh")
    printk3("BENCH hamsh: start, run `exit 0` and collect: %d timer cycles (status %d); block %d bytes", c1 - c0, cast[uint64](code), cast[uint64](proc_last_block))
    printk2(" (stack %d, image %d)\n", cast[uint64](proc_last_stack), cast[uint64](proc_last_image))
    # pipe throughput: 1 MiB between two processes
    c0 = cycles_now()
    run_prog("/bin/ptest", "pipebench", "00100000", nul)
    c1 = cycles_now()
    printk2("BENCH pipe: %d bytes from process to process in %d timer cycles (two spawns included)\n", 1048576, c1 - c0)
    # tmpfs: what one small file costs
    k0: uint32 = kheap.used_bytes
    fd = vfs_open("/tmp/one", OWRITE | OTRUNC | OCREATE)
    k1: uint32 = kheap.used_bytes
    vfs_write(fd, "x", 1)
    k2: uint32 = kheap.used_bytes
    vfs_close(fd)
    vfs_unlink("/tmp/one")
    printk3("BENCH tmpfs: an empty file takes %d bytes of kernel heap, its first byte %d more; table entry %d bytes\n", cast[uint64](k1 - k0), cast[uint64](k2 - k1), sizeof(TmpfsEntry))


def runner(arg: uint64) -> int64:
    vfs_open_stdio()
    test_boot()
    test_heap()
    test_threads()
    test_fp_switch()
    test_sync()
    test_syscalls()
    test_mpu()
    test_fs()
    test_c()
    test_proc()
    test_pipes()
    test_fat()
    bench_switch()
    bench_proc()
    test_console()
    if failures == 0:
        printk0("RESULT: PASS (all checks passed)\n")
    else:
        printk1("RESULT: FAIL (%d checks failed)\n", cast[uint64](failures))
    hackos_exit(failures)
    return 0


def main() -> int32:
    kputs("\nHackOS 0.2 kernel test (milestone 2) -- QEMU mps2-an500\n")
    kernel_init()
    thread_create("runner", cast[uint64](&runner), 0, 2, 16384, 0)
    sched_start()
    return 0
