# Hamnix Micro -- stand-in for Hamnix's lib/hamsdl.ad (the hamSDL game core).
#
# Hamnix's shell imports the hamSDL game core for its `hamui` and `pygame` built-ins.
# Hamnix Micro has no window system and no frame buffer, and the real libraries
# would add 10.8 MB of static tables to the shell.  This module supplies the
# names the shell imports, with Hamnix's signatures, so that user/hamnix/
# hamsh.ad needs no change for it: every call fails or does nothing, and the
# first one says why on the standard error stream.  Nothing here is copied
# from Hamnix except the names, the parameter lists and the constants' values.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64

hamsdl_said: uint32 = 0


def hamsdl_none():
    if hamsdl_said == 0:
        hamsdl_said = 1
        sys_write(2, "hamsh: no display on this system: the hamui and pygame built-ins do nothing\n", 76)


SDL_QUIT: int32 = 0
SDL_KEYDOWN: int32 = 1
SDL_KEYUP: int32 = 2
SDL_MOUSEMOTION: int32 = 3
SDL_MOUSEBUTTONDOWN: int32 = 4
SDL_MOUSEBUTTONUP: int32 = 5
SDLK_UP: int32 = 256
SDLK_DOWN: int32 = 257
SDLK_LEFT: int32 = 258
SDLK_RIGHT: int32 = 259


def sdl_rgb(r: int32, g: int32, b: int32) -> uint32:
    hamsdl_none()
    return 0


def sdl_begin_frame():
    hamsdl_none()


def sdl_clear(w: int32, h: int32, color: uint32):
    hamsdl_none()


def sdl_fill_rect(x: int32, y: int32, w: int32, h: int32, color: uint32):
    hamsdl_none()


def sdl_draw_rect(x: int32, y: int32, w: int32, h: int32, color: uint32):
    hamsdl_none()


def sdl_draw_line(x1: int32, y1: int32, x2: int32, y2: int32, color: uint32):
    hamsdl_none()


def sdl_draw_text(x: int32, y: int32, s: Ptr[uint8], color: uint32):
    hamsdl_none()


def sdl_poll_event(kind: Ptr[int32], key: Ptr[int32], x: Ptr[int32], y: Ptr[int32], button: Ptr[int32]) -> int32:
    hamsdl_none()
    return -1


def sdl_push_event(kind: int32, key: int32, x: int32, y: int32, button: int32):
    hamsdl_none()


def sdl_push_quit():
    hamsdl_none()


def sdl_set_fps(fps: int32):
    hamsdl_none()


def sdl_frame_ms() -> int32:
    hamsdl_none()
    return -1
