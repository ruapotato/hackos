# HackOS -- stand-in for Hamnix's lib/hamui.ad (the hamui GUI toolkit).
#
# Hamnix's shell imports the hamui GUI toolkit for its `hamui` and `pygame` built-ins.
# HackOS has no window system and no frame buffer, and the real libraries
# would add 10.8 MB of static tables to the shell.  This module supplies the
# names the shell imports, with Hamnix's signatures, so that user/hamnix/
# hamsh.ad needs no change for it: every call fails or does nothing, and the
# first one says why on the standard error stream.  Nothing here is copied
# from Hamnix except the names, the parameter lists and the constants' values.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64

hamui_said: uint32 = 0


def hamui_none():
    if hamui_said == 0:
        hamui_said = 1
        sys_write(2, "hamsh: no display on this system: the hamui and pygame built-ins do nothing\n", 76)


HAMUI_DLG_OK: int32 = 0


def hamui_init():
    hamui_none()


