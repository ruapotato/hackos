# HackOS -- from key positions to console input: the HackerSlide keyboard.
#
# The scanner (drivers/input/tca8418.ad) reports a chip row and column and
# pressed or released.  This turns that into the bytes a serial terminal
# would have sent and feeds them to the console (console_input), so the
# shell and the editor do not know which of the two is in use.
#
# PROVISIONAL LAYOUT.  The table is the keyboard as it is drawn in the
# hardware repository today (rev 0.1: 48 keys in 4 x 12 plus a five-key
# D-pad; hardware/scripts/kbd_layout.py there has the legends, the Fn
# legends and matrix_pos(), the folding of 12 physical columns into the
# chip's 10).  A new layout has been decided and is not on the boards yet;
# when it is, only keymap_init() below changes.
#
#     Esc   1  2  3  4  5  6  7  8  9  0  Bksp
#     Tab   Q  W  E  R  T  Y  U  I  O  P  -
#     Ctrl  A  S  D  F  G  H  J  K  L  ;  Enter
#     Shift Fn Z  X  C  V  [ Space ] B  N  M  .
#
# Chip rows 0-3 carry physical columns 0-9 of the four rows; chip row 4
# carries physical column 10 on COL0-3 and column 11 on COL4-7; chip row 5
# is the D-pad (up, down, left, right, centre).
#
# Modifiers are held keys: Shift, Ctrl, Fn.  Fn + Shift (the plate's "Caps")
# toggles caps lock.  What a key sends:
#     plain            the legend, letters in lower case
#     Shift            upper case; for the others the US keyboard's shifted
#                      sign (1 -> !, ; -> :, . -> >, - -> _)
#     Fn               the legend printed above the key on the top plate
#                      (` and F1-F10 on the digit row, ! @ # ... on the
#                      Q row, [ ] { } \ | < > ' " on the A row, ~ + _ ? / ,
#                      on the bottom row); F-keys send nothing yet
#     Ctrl             letters send their control code (Ctrl-C = 3)
#     D-pad            the VT100 arrow sequences ESC [ A B D C; centre = Enter
#     Bksp             DEL (0x7F); Fn + Bksp the VT100 delete sequence ESC [ 3 ~
# No key repeat yet.

from drivers.tty.console import console_input
from kernel.cpu import cpu_irq_save, cpu_irq_restore

K_NONE: uint32 = 0
K_SHIFT: uint32 = 0x100
K_CTRL: uint32 = 0x101
K_FN: uint32 = 0x102
K_UP: uint32 = 0x110
K_DOWN: uint32 = 0x111
K_LEFT: uint32 = 0x112
K_RIGHT: uint32 = 0x113
K_DEL: uint32 = 0x114

KM_ROWS: uint32 = 6
KM_COLS: uint32 = 10

kmap_base: Array[60, uint16]
kmap_shift: Array[60, uint16]
kmap_fn: Array[60, uint16]
kmap_mods: uint32 = 0                 # bit 0 Shift, bit 1 Ctrl, bit 2 Fn (held)
kmap_caps: uint32 = 0
kmap_ready: uint32 = 0
kmap_sent: uint64 = 0                 # bytes given to the console
kmap_unmapped: uint64 = 0             # presses of positions with no key


def _k(row: uint32, col: uint32, base: uint32, shift: uint32, fn: uint32):
    i: uint32 = row * KM_COLS + col
    kmap_base[i] = cast[uint16](base)
    kmap_shift[i] = cast[uint16](shift)
    kmap_fn[i] = cast[uint16](fn)


# A letter key: lower case, upper case with Shift, `fn` with Fn.
def _l(row: uint32, col: uint32, lower: uint32, fn: uint32):
    _k(row, col, lower, lower - 32, fn)


def keymap_init():
    i: uint32 = 0
    while i < 60:
        kmap_base[i] = 0
        kmap_shift[i] = 0
        kmap_fn[i] = 0
        i = i + 1
    # physical row 0: Esc 1 2 3 4 5 6 7 8 9 | 0 Bksp      Fn: ` F1 .. F10 Del
    _k(0, 0, 27, 27, 96)
    _k(0, 1, 49, 33, 0)
    _k(0, 2, 50, 64, 0)
    _k(0, 3, 51, 35, 0)
    _k(0, 4, 52, 36, 0)
    _k(0, 5, 53, 37, 0)
    _k(0, 6, 54, 94, 0)
    _k(0, 7, 55, 38, 0)
    _k(0, 8, 56, 42, 0)
    _k(0, 9, 57, 40, 0)
    _k(4, 0, 48, 41, 0)
    _k(4, 4, 127, 127, K_DEL)
    # physical row 1: Tab Q W E R T Y U I O | P -          Fn: ! @ # $ % ^ & * ( ) =
    _k(1, 0, 9, 9, 0)
    _l(1, 1, 113, 33)
    _l(1, 2, 119, 64)
    _l(1, 3, 101, 35)
    _l(1, 4, 114, 36)
    _l(1, 5, 116, 37)
    _l(1, 6, 121, 94)
    _l(1, 7, 117, 38)
    _l(1, 8, 105, 42)
    _l(1, 9, 111, 40)
    _l(4, 1, 112, 41)
    _k(4, 5, 45, 95, 61)
    # physical row 2: Ctrl A S D F G H J K L | ; Enter     Fn: [ ] { } \ | < > ' "
    _k(2, 0, K_CTRL, K_CTRL, K_CTRL)
    _l(2, 1, 97, 91)
    _l(2, 2, 115, 93)
    _l(2, 3, 100, 123)
    _l(2, 4, 102, 125)
    _l(2, 5, 103, 92)
    _l(2, 6, 104, 124)
    _l(2, 7, 106, 60)
    _l(2, 8, 107, 62)
    _l(2, 9, 108, 39)
    _k(4, 2, 59, 58, 34)
    _k(4, 6, 13, 13, 13)
    # physical row 3: Shift Fn Z X C V Space Space B N | M .   Fn: Caps _ ~ + _ ? _ _ / , Alt Super
    _k(3, 0, K_SHIFT, K_SHIFT, K_SHIFT)
    _k(3, 1, K_FN, K_FN, K_FN)
    _l(3, 2, 122, 126)
    _l(3, 3, 120, 43)
    _l(3, 4, 99, 95)
    _l(3, 5, 118, 63)
    _k(3, 6, 32, 32, 32)
    _l(3, 8, 98, 47)
    _l(3, 9, 110, 44)
    _l(4, 3, 109, 0)
    _k(4, 7, 46, 62, 0)
    # the D-pad
    _k(5, 0, K_UP, K_UP, K_UP)
    _k(5, 1, K_DOWN, K_DOWN, K_DOWN)
    _k(5, 2, K_LEFT, K_LEFT, K_LEFT)
    _k(5, 3, K_RIGHT, K_RIGHT, K_RIGHT)
    _k(5, 4, 13, 13, 13)
    kmap_mods = 0
    kmap_caps = 0
    kmap_ready = 1


def _send(c: uint32):
    irq: uint32 = cpu_irq_save()        # console_input is written for interrupt context
    console_input(c)
    cpu_irq_restore(irq)
    kmap_sent = kmap_sent + 1


def _send_csi(final: uint32):
    _send(27)
    _send(91)
    _send(final)


# One key event from the scanner.  Thread context.
def keymap_key(row: uint32, col: uint32, down: uint32):
    if kmap_ready == 0:
        keymap_init()
    if row >= KM_ROWS or col >= KM_COLS:
        return
    i: uint32 = row * KM_COLS + col
    base: uint32 = cast[uint32](kmap_base[i])
    if base == K_SHIFT or base == K_CTRL or base == K_FN:
        bit: uint32 = 1
        if base == K_CTRL:
            bit = 2
        elif base == K_FN:
            bit = 4
        if down != 0:
            if base == K_SHIFT and (kmap_mods & 4) != 0:
                kmap_caps = kmap_caps ^ 1   # Fn + Shift: caps lock
            kmap_mods = kmap_mods | bit
        else:
            kmap_mods = kmap_mods & (0xFFFFFFFF ^ bit)
        return
    if down == 0:
        return
    if base == K_NONE:
        kmap_unmapped = kmap_unmapped + 1
        return
    code: uint32 = base
    if (kmap_mods & 4) != 0:
        code = cast[uint32](kmap_fn[i])
    elif (kmap_mods & 1) != 0:
        code = cast[uint32](kmap_shift[i])
    if code == K_NONE:
        return
    if kmap_caps != 0 and (kmap_mods & 4) == 0 and base >= 97 and base <= 122:
        if (kmap_mods & 1) != 0:
            code = base                 # Shift undoes caps lock
        else:
            code = base - 32
    if code == K_UP:
        _send_csi(65)
    elif code == K_DOWN:
        _send_csi(66)
    elif code == K_RIGHT:
        _send_csi(67)
    elif code == K_LEFT:
        _send_csi(68)
    elif code == K_DEL:
        _send(27)
        _send(91)
        _send(51)
        _send(126)
    elif code < 0x100:
        if (kmap_mods & 2) != 0 and ((code >= 97 and code <= 122) or (code >= 64 and code <= 95)):
            code = code & 0x1F          # Ctrl + letter
        _send(code)


# Where a character is on this keyboard: for tests and for /proc/keys, which
# type text through the matrix.  Returns row | col << 8 | modifiers << 16
# (1 = Shift, 4 = Fn), or 0xFFFFFFFF when no key combination gives `c`.
def keymap_find(c: uint32) -> uint32:
    if kmap_ready == 0:
        keymap_init()
    if c == 10:
        c = 13
    i: uint32 = 0
    while i < 60:
        if cast[uint32](kmap_base[i]) == c:
            return (i / KM_COLS) | ((i % KM_COLS) << 8)
        i = i + 1
    i = 0
    while i < 60:
        if cast[uint32](kmap_shift[i]) == c:
            return (i / KM_COLS) | ((i % KM_COLS) << 8) | 0x10000
        i = i + 1
    i = 0
    while i < 60:
        if cast[uint32](kmap_fn[i]) == c:
            return (i / KM_COLS) | ((i % KM_COLS) << 8) | 0x40000
        i = i + 1
    return 0xFFFFFFFF
