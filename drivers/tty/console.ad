# HackOS -- the console: UART output, interrupt-driven input, line discipline.
#
# Output is polled (board_console_putc).  A write from a thread holds the
# console mutex for its whole buffer, so messages do not interleave; writes
# from interrupt handlers and before the scheduler runs go straight out.
#
# Input arrives in the UART receive interrupt.  In cooked mode (the default)
# the line discipline echoes, edits and hands over whole lines:
#     Backspace / DEL   erase one character
#     Ctrl-U            erase the line
#     Ctrl-C            drop the line (an empty line is delivered)
#     Ctrl-D            end of file when the line is empty, else flush it
#     CR or LF          deliver the line, terminated by "\n"
# In raw mode every byte is delivered at once, unechoed (what Hamnix's shell
# expects from its console).

from kernel.cpu import cpu_irq_save, cpu_irq_restore, mmio_read32, mmio_write32, mmio_write8
from kernel.sched.core import WaitQueue, wq_init, wq_wait, wq_wake_all, sched_running, sched_in_handler, WAIT_FOREVER
from kernel.sync import Mutex, mutex_init, mutex_register, mutex_lock, mutex_unlock
from boards.mps2_an500.board import board_console_putc, board_console_rx_ready, board_console_getc, board_console_rx_irq_enable, board_console_rx_irq_ack

CON_RING: uint32 = 1024
CON_LINE: uint32 = 256
CON_COOKED: uint32 = 1
CON_RAW: uint32 = 0

con_lock: Mutex
con_wq: WaitQueue
con_ring: Array[1024, uint8]
con_head: uint32 = 0               # oldest byte
con_count: uint32 = 0
con_line: Array[256, uint8]
con_line_len: uint32 = 0
con_eof: uint32 = 0                # pending end-of-file marks
con_mode: uint32 = 1
con_rx_bytes: uint64 = 0           # statistics
con_rx_dropped: uint64 = 0
con_rx_irqs: uint64 = 0            # receive interrupts taken
con_ready: uint32 = 0


def console_init():
    mutex_init(&con_lock)
    mutex_register(&con_lock)
    wq_init(&con_wq)
    con_head = 0
    con_count = 0
    con_line_len = 0
    con_eof = 0
    con_mode = CON_COOKED
    con_ready = 1


# Start receiving.  Separate from console_init so a test can decide when input
# (and its echo) may begin.
def console_rx_enable():
    board_console_rx_irq_enable()


def console_set_mode(mode: uint32):
    con_mode = mode


def _con_out(c: uint32):
    if c == 10:
        board_console_putc(13)
    board_console_putc(c)


# Write from any context.
def console_write(buf: Ptr[uint8], n: uint64):
    locked: uint32 = 0
    if con_ready != 0 and sched_running != 0 and sched_in_handler() == 0:
        mutex_lock(&con_lock)
        locked = 1
    i: uint64 = 0
    while i < n:
        _con_out(cast[uint32](buf[i]))
        i = i + 1
    if locked != 0:
        mutex_unlock(&con_lock)


def _ring_put(c: uint32):
    if con_count == CON_RING:
        con_rx_dropped = con_rx_dropped + 1
        return
    con_ring[(con_head + con_count) % CON_RING] = cast[uint8](c)
    con_count = con_count + 1


def _commit_line():
    i: uint32 = 0
    while i < con_line_len:
        _ring_put(cast[uint32](con_line[i]))
        i = i + 1
    con_line_len = 0
    wq_wake_all(&con_wq)


# One received byte through the line discipline.  Interrupt context.
def console_input(ch: uint32):
    c: uint32 = ch & 255
    con_rx_bytes = con_rx_bytes + 1
    if con_mode == CON_RAW:
        _ring_put(c)
        wq_wake_all(&con_wq)
        return
    if c == 13:
        c = 10
    if c == 8 or c == 127:
        if con_line_len > 0:
            con_line_len = con_line_len - 1
            _con_out(8)
            _con_out(32)
            _con_out(8)
        return
    if c == 21:                                     # Ctrl-U
        while con_line_len > 0:
            con_line_len = con_line_len - 1
            _con_out(8)
            _con_out(32)
            _con_out(8)
        return
    if c == 3:                                      # Ctrl-C
        con_line_len = 0
        _con_out(94)
        _con_out(67)
        _con_out(10)
        _ring_put(10)
        wq_wake_all(&con_wq)
        return
    if c == 4:                                      # Ctrl-D
        if con_line_len == 0:
            con_eof = con_eof + 1
            wq_wake_all(&con_wq)
        else:
            _commit_line()
        return
    if c == 10:
        _con_out(10)
        if con_line_len < CON_LINE:
            con_line[con_line_len] = 10
            con_line_len = con_line_len + 1
        _commit_line()
        return
    if c >= 32 and c < 127 and con_line_len + 1 < CON_LINE:
        con_line[con_line_len] = cast[uint8](c)
        con_line_len = con_line_len + 1
        _con_out(c)


# IRQ 0: UART0 receive.
def uart0_rx_handler():
    irq: uint32 = cpu_irq_save()
    con_rx_irqs = con_rx_irqs + 1
    # Acknowledge first, then drain: a byte that arrives after the drain
    # raises the interrupt again instead of being acknowledged unseen.
    board_console_rx_irq_ack()
    while board_console_rx_ready() != 0:
        console_input(board_console_getc())
    cpu_irq_restore(irq)


# Read up to n bytes.  Cooked mode returns at most one line.  Blocking form:
# waits for data, returns 0 at end of file.  Non-blocking form (Hamnix's
# read_nb contract): > 0 bytes, 0 = nothing yet, -1 = end of file.
def console_read(buf: Ptr[uint8], n: uint64, nonblock: uint32) -> int64:
    if n == 0:
        return 0
    irq: uint32 = cpu_irq_save()
    while con_count == 0:
        if con_eof > 0:
            con_eof = con_eof - 1
            cpu_irq_restore(irq)
            if nonblock != 0:
                return -1
            return 0
        if nonblock != 0:
            cpu_irq_restore(irq)
            return 0
        wq_wait(&con_wq, WAIT_FOREVER)
    got: uint64 = 0
    while got < n and con_count > 0:
        c: uint8 = con_ring[con_head]
        con_head = (con_head + 1) % CON_RING
        con_count = con_count - 1
        buf[got] = c
        got = got + 1
        if c == 10 and con_mode == CON_COOKED:
            break
    cpu_irq_restore(irq)
    return cast[int64](got)
