# HackOS -- thread entry points that fault on purpose (tests and the monitor's
# `fault` command).  They use no globals, so they can run unprivileged.


# Unbounded recursion; each level keeps 128 bytes of its frame alive across
# the call so the compiler cannot turn it into a loop.
def _fault_recurse(depth: uint64) -> uint64:
    buf: Array[128, uint8]
    i: uint64 = 0
    while i < 128:
        buf[i] = cast[uint8](depth + i)
        i = i + 1
    r: uint64 = _fault_recurse(depth + 1)
    return r + cast[uint64](buf[r & 127])


def fault_stack_overflow(arg: uint64) -> int64:
    return cast[int64](_fault_recurse(arg))


# Read a 32-bit word at `addr` (a kernel address, or 0 for a null pointer).
def fault_read(addr: uint64) -> int64:
    v: uint32 = cast[Ptr[volatile uint32]](addr)[0]
    return cast[int64](v) + 1000


def fault_write(addr: uint64) -> int64:
    cast[Ptr[volatile uint32]](addr)[0] = 0xDEADBEEF
    return 1001


# Call address `addr` as a function (0: jump through a null pointer).
def fault_jump(addr: uint64) -> int64:
    f: Fn[int64, uint64] = cast[Fn[int64, uint64]](addr)
    return f(0)


def fault_udf(arg: uint64) -> int64:
    asm_volatile("udf #0")
    return 1002
