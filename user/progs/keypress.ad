# Hamnix Micro -- keypress [-n] TEXT...: type TEXT on the emulated keyboard.
#
# The words are joined with spaces (-n adds Enter) and written to
# /proc/keys: on a board whose keyboard chip is the register model, every
# character is then pressed and released on the key matrix, with Shift or
# Fn held where the layout needs them, and comes back through the scanner
# driver and the key map as console input.  A way to see that whole path
# work from the shell, and to try a layout before the keyboard exists.

extern def sys_open_write(path: Ptr[uint8]) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32

text: Array[256, uint8]


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    n: uint64 = 0
    enter: uint32 = 0
    a: int32 = 1
    first: uint32 = 1
    while a < argc:
        s: Ptr[uint8] = cast[Ptr[uint8]](argv[a])
        if a == 1 and s[0] == 45 and s[1] == 110 and s[2] == 0:
            enter = 1
        else:
            if first == 0 and n < 254:
                text[n] = 32
                n = n + 1
            first = 0
            i: uint64 = 0
            while s[i] != 0 and n < 254:
                text[n] = s[i]
                n = n + 1
                i = i + 1
        a = a + 1
    if enter != 0:
        text[n] = 10
        n = n + 1
    fd: int32 = sys_open_write("/proc/keys")
    if fd < 0:
        sys_write(2, "keypress: cannot open /proc/keys\n", 33)
        return 1
    r: int64 = sys_write(fd, &text[0], n)
    sys_close(fd)
    if r < 0:
        sys_write(2, "keypress: no emulated keyboard on this board\n", 45)
        return 1
    return 0
