# Hamnix Micro -- sleep SECONDS[.FRACTION]: wait, with the processor asleep.
# (Hamnix's own sleep polls the clock and yields in a loop, which would keep
# a microcontroller awake for the whole time; this one blocks in the kernel.)

extern def sys_sleep_ms(ms: uint64) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        sys_write(2, "usage: sleep SECONDS[.FRACTION]\n", 32)
        return 1
    s: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
    ms: uint64 = 0
    i: uint64 = 0
    while s[i] >= 48 and s[i] <= 57:
        ms = ms * 10 + cast[uint64](s[i] - 48)
        i = i + 1
    ms = ms * 1000
    if s[i] == 46:
        i = i + 1
        scale: uint64 = 100
        while s[i] >= 48 and s[i] <= 57:
            ms = ms + cast[uint64](s[i] - 48) * scale
            scale = scale / 10
            i = i + 1
    if s[i] != 0:
        sys_write(2, "sleep: not a number\n", 20)
        return 1
    sys_sleep_ms(ms)
    return 0
