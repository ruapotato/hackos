# Hamnix Micro -- the smallest program: prints a line and its arguments.

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64


def puts(s: Ptr[uint8]):
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    sys_write(1, s, n)


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    puts("hello from a loaded program\n")
    i: int32 = 1
    while i < argc:
        puts("  arg: ")
        puts(cast[Ptr[uint8]](argv[i]))
        puts("\n")
        i = i + 1
    return argc
