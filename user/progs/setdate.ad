# Hamnix Micro -- setdate SECONDS: set the clock to that many seconds since
# 1970-01-01 00:00:00 UTC (`date +%s` on another machine prints the number).
# No board has a clock that Hamnix Micro reads yet, so until this is run `date`
# says the time is unavailable.  The number is written to /proc/realtime.

extern def sys_open_write(path: Ptr[uint8]) -> int32
extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_close(fd: int32) -> int32


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        sys_write(2, "usage: setdate SECONDS-SINCE-1970\n", 34)
        return 1
    s: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    fd: int32 = sys_open_write("/proc/realtime")
    if fd < 0:
        sys_write(2, "setdate: cannot open /proc/realtime\n", 36)
        return 1
    r: int64 = sys_write(fd, s, n)
    sys_close(fd)
    if r < 0:
        sys_write(2, "setdate: not a number of seconds\n", 33)
        return 1
    return 0
