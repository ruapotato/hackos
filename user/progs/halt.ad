# Hamnix Micro -- halt [STATUS]: stop the system.  The kernel prints its exit
# status line and resets the machine (an emulator started with -no-reboot
# ends there).

extern def hmicro_syscall(nr: uint64, a0: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64) -> int64


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    code: uint64 = 0
    if argc > 1:
        s: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
        i: uint64 = 0
        while s[i] >= 48 and s[i] <= 57:
            code = code * 10 + cast[uint64](s[i]) - 48
            i = i + 1
        # `halt uf2`: on a board with a UF2 bootloader, restart into its
        # drive so that a new image can be copied without pressing a button
        # (status 87 = 0x57, the magic Adafruit's bootloader looks for).
        if s[0] == 117 and s[1] == 102 and s[2] == 50 and s[3] == 0:
            code = 87
    hmicro_syscall(518, code, 0, 0, 0, 0, 0)
    return 1
