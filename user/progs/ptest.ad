# HackOS -- the process test program.  The kernel test image runs it from
# /bin with a sub-command in argv[1]; the exit code carries the result (a
# bit per sub-check where there are several).

extern def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_open(path: Ptr[uint8]) -> int32
extern def sys_open_write(path: Ptr[uint8]) -> int32
extern def sys_close(fd: int32) -> int32
extern def sys_exit(code: uint64)
extern def sys_getpid() -> int32
extern def sys_sleep_ms(ms: uint64) -> int32
extern def sys_yield() -> int32
extern def sys_spawn(path: Ptr[uint8], argv: Ptr[uint64]) -> int32
extern def sys_rfork(flags: int32) -> int32
extern def sys_execve_env(path: Ptr[uint8], argv: Ptr[uint64], envp: Ptr[uint64]) -> int32
extern def sys_waitpid(pid: int32) -> int64
extern def sys_waitpid_jc(pid: int32, status: Ptr[int64]) -> int64
extern def sys_mmap(addr: uint64, length: uint64, prot: int32, flags: int32, fd: int32, off: int64) -> int64
extern def sys_munmap(addr: uint64, length: uint64) -> int64
extern def sys_errstr(buf: Ptr[uint8], nbuf: uint64) -> int32
extern def sys_chdir(path: Ptr[uint8]) -> int32
extern def sys_getcwd(buf: Ptr[uint8], count: uint64) -> int64
extern def sys_fdbind(pid: int32, fdnum: int32, kind: int32, arg: int32) -> int32
extern def sys_pipechan() -> int32
extern def sys_get_jiffies() -> uint64
extern def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64
extern def sys_fdslot_kind(pid: int32, fdnum: int32) -> int32
extern def sys_fdslot_arg(pid: int32, fdnum: int32) -> int32
extern def sys_openchan(path: Ptr[uint8], mode: int32) -> int32
extern def sys_dup2(oldfd: int32, newfd: int32) -> int32
extern def hackos_test_dirty_fp()
extern def hackos_test_exec_dirty(path: Ptr[uint8], argv: Ptr[uint64]) -> int64
extern def hackos_syscall(nr: uint64, a0: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64) -> int64

counter: uint64 = 1000              # initialised data
zeroed: Array[64, uint32]           # bss
big: Array[6000, uint8]
names: Array[4, Ptr[uint8]]
child_argv: Array[4, uint64]


def slen(s: Ptr[uint8]) -> uint64:
    n: uint64 = 0
    while s[n] != 0:
        n = n + 1
    return n


def puts(s: Ptr[uint8]):
    sys_write(1, s, slen(s))


def seq(a: Ptr[uint8], b: Ptr[uint8]) -> uint32:
    i: uint64 = 0
    while a[i] != 0 and a[i] == b[i]:
        i = i + 1
    if a[i] == b[i]:
        return 1
    return 0


def put_hex(v: uint64):
    d: Array[18, uint8]
    i: uint32 = 0
    while i < 8:
        n: uint64 = (v >> cast[uint64](28 - i * 4)) & 15
        if n < 10:
            d[i] = cast[uint8](48 + n)
        else:
            d[i] = cast[uint8](87 + n)
        i = i + 1
    sys_write(1, &d[0], 8)


def parse_hex(s: Ptr[uint8]) -> uint64:
    v: uint64 = 0
    i: uint64 = 0
    while s[i] != 0:
        c: uint64 = cast[uint64](s[i])
        if c >= 48 and c <= 57:
            v = v * 16 + c - 48
        elif c >= 97 and c <= 102:
            v = v * 16 + c - 87
        i = i + 1
    return v


def twice(x: uint64) -> uint64:
    return x * 2


def thrice(x: uint64) -> uint64:
    return x * 3


op: Fn[uint64, uint64]


# Each level reads its caller's frame and hands its own on, so the frames
# cannot be optimised away.
def deep(n: uint64, prev: Ptr[uint8]) -> uint64:
    pad: Array[64, uint8]
    pad[n & 63] = cast[uint8](cast[uint64](prev[(n + 1) & 63]) + n)
    if n == 0:
        return cast[uint64](pad[0])
    return deep(n - 1, &pad[0]) + cast[uint64](pad[n & 63])


# One frame much larger than any guard region would be.
def huge_frame(n: uint64, prev: Ptr[uint8]) -> uint64:
    pad: Array[6000, uint8]
    pad[n % 6000] = cast[uint8](cast[uint64](prev[(n + 1) % 6000]) + n)
    if n == 0:
        return cast[uint64](pad[0])
    return huge_frame(n - 1, &pad[0]) + cast[uint64](pad[n % 6000])


# What the program sees of its own image after loading.
def t_image() -> int32:
    r: int32 = 0
    if counter == 1000:
        r = r | 1                       # .data arrived
    z: uint32 = 0
    i: uint32 = 0
    while i < 64:
        z = z | zeroed[i]
        i = i + 1
    if z == 0:
        r = r | 2                       # .bss is zero
    names[0] = "alpha"
    names[3] = "delta"
    if seq(names[0], "alpha") != 0 and seq(names[3], "delta") != 0 and cast[uint64](names[0]) > cast[uint64](&t_image):
        r = r | 4                       # addresses of constants, formed PC-relative
    op = twice
    a: uint64 = op(21)
    op = thrice
    if a == 42 and op(14) == 42:
        r = r | 8                       # calls through function pointers
    x: uint64 = 1000000007
    if (x * x) / 1000000007 == 1000000007 and (x * x + 5) % 1000000007 == 5:
        r = r | 16                      # 64-bit divide helper, this program's own copy
    f: float64 = 1.5
    g: float64 = f * 4.0 + cast[float64](x)
    if cast[uint64](g) == 1000000013:
        r = r | 32                      # floating point and its conversions
    counter = counter + 1
    if counter == 1001:
        r = r | 64                      # .data is writable
    return r


def t_heap() -> int32:
    r: int32 = 0
    a: int64 = sys_mmap(0, 1000, 3, 0x22, -1, 0)
    b: int64 = sys_mmap(0, 2000, 3, 0x22, -1, 0)
    if a > 0 and b > 0 and a != b:
        r = r | 1
        pa: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](a))
        pb: Ptr[uint8] = cast[Ptr[uint8]](cast[uint64](b))
        pa[999] = 7
        pb[1999] = 9
        if pa[0] == 0 and pb[0] == 0 and pa[999] == 7:
            r = r | 2
        if sys_munmap(cast[uint64](a), 1000) == 0 and sys_munmap(cast[uint64](a), 1000) != 0:
            r = r | 4
        c: int64 = sys_mmap(0, 500, 3, 0x22, -1, 0)
        if c == a:
            r = r | 8                   # the freed block is used again
    # more than the heap holds
    if sys_mmap(0, 1000000, 3, 0x22, -1, 0) == -12:
        r = r | 16
    return r


# rfork + exec + wait, the way Hamnix's spawn() does it.
def t_fork(path: Ptr[uint8]) -> int32:
    r: int32 = 0
    local: Array[4, uint64]
    local[0] = 0x1111222233334444
    local[1] = 0x5555666677778888
    keep: float64 = 2.25
    before: uint64 = counter
    child_argv[0] = cast[uint64](path)
    child_argv[1] = cast[uint64]("from-rfork")
    child_argv[2] = 0
    pid: int32 = sys_rfork(0x00D)               # RFPROC | RFFDG | RFNAMEG
    if pid == 0:
        # the child, on the parent's memory: scribble on the stack frame and
        # on a global, close a descriptor, then become another program
        local[0] = 0
        local[1] = 0
        counter = counter + 100
        sys_close(1)
        sys_open("/dev/console")                # becomes its descriptor 1 again
        sys_execve_env(path, &child_argv[0], cast[Ptr[uint64]](0))
        sys_exit(127)
    if pid > 0:
        r = r | 1
    if local[0] == 0x1111222233334444 and local[1] == 0x5555666677778888:
        r = r | 2                       # the stack is as it was
    if keep * 2.0 == 4.5:
        r = r | 4                       # so is the floating-point state
    if counter == before + 100:
        r = r | 8                       # globals are shared until exec (vfork)
    if sys_write(1, "", 0) == 0:
        r = r | 16                      # the child's close(1) was its own
    code: int64 = sys_waitpid(pid)
    if code == 2:
        r = r | 32                      # /bin/hello with one argument returns 2
    if sys_waitpid(pid) == -10:
        r = r | 64                      # it is gone
    return r


def t_forkfail() -> int32:
    r: int32 = 0
    child_argv[0] = cast[uint64]("/bin/no-such-program")
    child_argv[1] = 0
    pid: int32 = sys_rfork(0x00D)
    if pid == 0:
        rc: int32 = sys_execve_env("/bin/no-such-program", &child_argv[0], cast[Ptr[uint64]](0))
        if rc == -2:
            sys_exit(127)
        sys_exit(1)
    if pid > 0 and sys_waitpid(pid) == 127:
        r = r | 1
    # not a program at all
    fd: int32 = sys_open_write("/tmp/notelf")
    sys_write(fd, "#!/bin/hamsh\necho no\n", 21)
    sys_close(fd)
    child_argv[0] = cast[uint64]("/tmp/notelf")
    pid = sys_rfork(0x00D)
    if pid == 0:
        rc2: int32 = sys_execve_env("/tmp/notelf", &child_argv[0], cast[Ptr[uint64]](0))
        if rc2 == -8:
            sys_exit(126)
        sys_exit(1)
    if pid > 0 and sys_waitpid(pid) == 126:
        r = r | 2
    # a child that neither execs nor fails: it just exits
    pid = sys_rfork(0x00D)
    if pid == 0:
        sys_exit(55)
    if pid > 0 and sys_waitpid(pid) == 55:
        r = r | 4
    return r


def t_spawn(path: Ptr[uint8]) -> int32:
    r: int32 = 0
    child_argv[0] = cast[uint64](path)
    child_argv[1] = cast[uint64]("a")
    child_argv[2] = cast[uint64]("b")
    child_argv[3] = 0
    pid: int32 = sys_spawn(path, &child_argv[0])
    if pid > 0:
        r = r | 1
    st: Array[1, int64]
    st[0] = -1
    polls: uint32 = 0
    got: int64 = 0
    while got == 0 and polls < 1000:
        got = sys_waitpid_jc(pid, &st[0])
        if got == 0:
            sys_sleep_ms(1)
        polls = polls + 1
    if got == cast[int64](pid) and st[0] == ((3 << 8) | 1):
        r = r | 2
    if sys_waitpid_jc(pid, &st[0]) == -10:
        r = r | 4
    if sys_spawn("/bin/no-such-program", &child_argv[0]) == -2:
        r = r | 8
    return r


# ---- pipes and /fd names -----------------------------------------------------
iobuf: Array[4096, uint8]


def fdname_open(n: int32) -> int32:
    path: Array[8, uint8]
    path[0] = 47
    path[1] = 102
    path[2] = 100
    path[3] = 47
    path[4] = cast[uint8](48 + n)
    path[5] = 0
    return sys_open(&path[0])


# A pipe inside one process, through two /fd names.
def t_pipe() -> int32:
    r: int32 = 0
    slot: int32 = sys_pipechan()
    if slot >= 0 and sys_fdbind(0, 5, 3, slot) == 0 and sys_fdbind(0, 6, 2, slot) == 0:
        r = r | 1                       # 3 = write end, 2 = read end
    wfd: int32 = fdname_open(5)
    rfd: int32 = fdname_open(6)
    if sys_read_nb(rfd, &iobuf[0], 16) == 0:
        r = r | 2                       # empty, a writer exists: "nothing yet"
    if sys_write(wfd, "pipe data", 9) == 9 and sys_read(rfd, &iobuf[0], 4) == 4 and iobuf[0] == 112 and sys_read(rfd, &iobuf[0], 64) == 5 and iobuf[4] == 97:
        r = r | 4                       # bytes arrive in order, short reads work
    if sys_fdslot_kind(0, 5) == 3 and sys_fdslot_arg(0, 6) == slot and sys_fdslot_kind(0, 9) == 0:
        r = r | 8
    sys_write(wfd, "tail", 4)
    sys_fdbind(0, 5, 1, 0)              # rebind to the console: the last writer is gone
    if sys_read(rfd, &iobuf[0], 64) == 4 and sys_read(rfd, &iobuf[0], 64) == 0 and sys_read_nb(rfd, &iobuf[0], 64) == -1:
        r = r | 16                      # what was written still arrives, then end of file
    if sys_write(wfd, "x", 1) == 1:
        r = r | 32                      # the same descriptor now reaches the console
    sys_fdbind(0, 6, 0, 0)
    # a pipe nobody reads: EPIPE
    s2: int32 = sys_pipechan()
    sys_fdbind(0, 5, 3, s2)
    if sys_write(wfd, "lost", 4) == -32:
        r = r | 64
    sys_fdbind(0, 5, 0, 0)
    if sys_write(wfd, "x", 1) == -9 and sys_fdbind(0, 16, 1, 0) < 0 and sys_fdbind(0, 5, 3, 99) < 0:
        r = r | 128                     # unbound name, bad name, bad pipe
    sys_close(wfd)
    sys_close(rfd)
    return r


# Writer side of the two-process pipe tests: /fd/7 is the write end.
def t_pipewriter(total: uint64) -> int32:
    wfd: int32 = fdname_open(7)
    i: uint64 = 0
    while i < 4096:
        iobuf[i] = cast[uint8]((i * 7 + 3) & 255)
        i = i + 1
    done: uint64 = 0
    while done < total:
        n: uint64 = total - done
        if n > 4096:
            n = 4096
        w: int64 = sys_write(wfd, &iobuf[0], n)
        if w <= 0:
            return 1
        done = done + cast[uint64](w)
    return 0


# Reader side: starts the writer as a child, reads until end of file.
def t_pipexfer(total: uint64, quiet: uint32) -> int32:
    r: int32 = 0
    slot: int32 = sys_pipechan()
    sys_fdbind(0, 7, 3, slot)
    sys_fdbind(0, 8, 2, slot)
    num: Array[20, uint8]
    k: uint32 = 0
    v: uint64 = total
    while k < 8:
        d: uint64 = (v >> cast[uint64](28 - k * 4)) & 15
        if d < 10:
            num[k] = cast[uint8](48 + d)
        else:
            num[k] = cast[uint8](87 + d)
        k = k + 1
    num[8] = 0
    child_argv[0] = cast[uint64]("/bin/ptest")
    child_argv[1] = cast[uint64]("pipewriter")
    child_argv[2] = cast[uint64](&num[0])
    child_argv[3] = 0
    t0: uint64 = sys_get_jiffies()
    pid: int32 = sys_spawn("/bin/ptest", &child_argv[0])   # inherits both ends
    sys_fdbind(0, 7, 0, 0)              # ours is dropped: the child holds the only writer
    rfd: int32 = fdname_open(8)
    got: uint64 = 0
    bad: uint64 = 0
    while 1 == 1:
        n: int64 = sys_read(rfd, &iobuf[0], 4096)
        if n <= 0:
            break
        if quiet == 0:
            j: uint64 = 0
            while j < cast[uint64](n):
                if iobuf[j] != cast[uint8](((((got + j) & 4095) * 7) + 3) & 255):
                    bad = bad + 1
                j = j + 1
        got = got + cast[uint64](n)
    t1: uint64 = sys_get_jiffies()
    if got == total and bad == 0:
        r = r | 1
    if sys_waitpid(pid) == 0:
        r = r | 2
    sys_close(rfd)
    sys_fdbind(0, 8, 0, 0)
    if quiet == 0:
        puts("ptest: pipe moved 0x")
        put_hex(got)
        puts(" bytes in 0x")
        put_hex((t1 - t0) * 10)
        puts(" ms\n")
    return r


# A child of rfork that has not exec'ed must not sleep on a full pipe.
def t_vfpipe() -> int32:
    slot: int32 = sys_pipechan()
    sys_fdbind(0, 8, 2, slot)           # the parent keeps a reader, as the shell does
    sys_fdbind(0, 7, 3, slot)
    pid: int32 = sys_rfork(0x00D)
    if pid == 0:
        wfd: int32 = fdname_open(7)
        a: int64 = sys_write(wfd, &iobuf[0], 4096)      # fills the pipe
        b: int64 = sys_write(wfd, &iobuf[0], 100)       # would block for ever
        if a == 4096 and b == -11:
            sys_exit(40)
        sys_exit(41)
    code: int64 = sys_waitpid(pid)
    sys_fdbind(0, 7, 0, 0)
    sys_fdbind(0, 8, 0, 0)
    return cast[int32](code)


# What the shell does for `prog > file`: rfork, the child routes its
# descriptor 1 through /fd/1 and execs; the parent binds the CHILD's /fd/1 to
# the file afterwards.  The child must not get to write before that.
def t_redir(path: Ptr[uint8]) -> int32:
    r: int32 = 0
    child_argv[0] = cast[uint64](path)
    child_argv[1] = cast[uint64]("redirected")
    child_argv[2] = 0
    pid: int32 = sys_rfork(0x00D)
    if pid == 0:
        fd: int32 = sys_open("/fd/1")
        if fd != 1:
            sys_dup2(fd, 1)
            sys_close(fd)
        sys_execve_env(path, &child_argv[0], cast[Ptr[uint64]](0))
        sys_exit(127)
    chan: int32 = sys_openchan("/tmp/redir.out", 1)
    if chan >= 0 and sys_fdbind(pid, 1, 4, chan) == 0:
        r = r | 1                       # 4 = a file
    if sys_waitpid(pid) == 2:
        r = r | 2
    fd2: int32 = sys_open("/tmp/redir.out")
    n: int64 = sys_read(fd2, &iobuf[0], 200)
    sys_close(fd2)
    if n == 46 and iobuf[0] == 104 and iobuf[45] == 10:
        r = r | 4                       # both lines of /bin/hello are in the file
    if sys_fdbind(1, 1, 1, 0) < 0 and sys_fdbind(0, 9, 7, 0x40020400) < 0 and sys_fdbind(0, 9, 7, 0x40010009) < 0 and sys_waitpid(1) == -10:
        r = r | 8                       # not our child; made-up channels; a kernel thread: refused
    return r


# Holds a pipe (both ends at /fd/5 and /fd/6) and a file (/fd/7) for a while.
def t_hold() -> int32:
    slot: int32 = sys_pipechan()
    sys_fdbind(0, 5, 3, slot)
    sys_fdbind(0, 6, 2, slot)
    chan: int32 = sys_openchan("/tmp/held.txt", 1)
    sys_fdbind(0, 7, 4, chan)
    wfd: int32 = fdname_open(7)
    sys_write(wfd, "secret", 6)
    sys_sleep_ms(300)
    return 0


# Tries to bind what it was never given: every pipe slot and every file
# slot, by number.  Then what it IS entitled to.
#   1  no pipe of another process could be bound (either end)
#   2  no file could be bound without having opened it
#   4  its own new pipe: yes
#   8  a file it opened itself: yes, and a second name by dup
#   16 a child of rfork may bind its parent's pipe (it runs the parent's code)
#   32 after a process has bound a pipe at a name, it may bind it at another
def t_steal() -> int32:
    r: int32 = 0
    got: int32 = 0
    i: int32 = 0
    while i < 16:
        if sys_fdbind(0, 9, 2, i) == 0:
            got = got + 1
        if sys_fdbind(0, 9, 3, i) == 0:
            got = got + 1
        i = i + 1
    sys_fdbind(0, 9, 0, 0)
    if got == 0:
        r = r | 1
    got = 0
    i = 0
    while i < 1024:
        if sys_fdbind(0, 9, 4, i) == 0:
            got = got + 1
        if sys_fdbind(0, 9, 6, i) == 0:
            got = got + 1
        i = i + 1
    sys_fdbind(0, 9, 0, 0)
    if got == 0:
        r = r | 2
    slot: int32 = sys_pipechan()
    if slot >= 0 and sys_fdbind(0, 10, 3, slot) == 0:
        r = r | 4
    chan: int32 = sys_openchan("/tmp/mine.txt", 1)
    if chan >= 0 and sys_fdbind(0, 11, 4, chan) == 0 and sys_fdbind(0, 12, 5, 11) == 0 and sys_fdslot_arg(0, 12) == chan:
        r = r | 8
    s2: int32 = sys_pipechan()
    pid: int32 = sys_rfork(0x00D)
    if pid == 0:
        if sys_fdbind(0, 13, 3, s2) == 0:
            sys_exit(42)
        sys_exit(1)
    if sys_waitpid(pid) == 42:
        r = r | 16
    if sys_fdbind(0, 14, 2, slot) == 0:
        r = r | 32
    return r


def main(argc: int32, argv: Ptr[uint64]) -> int32:
    if argc < 2:
        return 200
    cmd: Ptr[uint8] = cast[Ptr[uint8]](argv[1])
    arg: Ptr[uint8] = cast[Ptr[uint8]]("")
    if argc > 2:
        arg = cast[Ptr[uint8]](argv[2])
    if seq(cmd, "image") != 0:
        return t_image()
    if seq(cmd, "heap") != 0:
        return t_heap()
    if seq(cmd, "fork") != 0:
        return t_fork(arg)
    if seq(cmd, "forkfail") != 0:
        return t_forkfail()
    if seq(cmd, "spawn") != 0:
        return t_spawn(arg)
    if seq(cmd, "nop") != 0:
        return 0
    if seq(cmd, "outerr") != 0:
        # standard output, standard error, standard output again
        sys_write(1, "out one\n", 8)
        sys_write(2, "err two\n", 8)
        sys_write(1, "out three\n", 10)
        return 0
    if seq(cmd, "regexec") != 0:
        # exec a program with every register this one can reach left dirty
        child_argv[0] = cast[uint64]("/bin/regprobe")
        child_argv[1] = 0
        hackos_test_exec_dirty("/bin/regprobe", &child_argv[0])
        return 99
    if seq(cmd, "regspawn") != 0:
        # start a program right after using the FPU: the registers still
        # hold this process's values when the new one first runs
        child_argv[0] = cast[uint64]("/bin/regprobe")
        child_argv[1] = 0
        hackos_test_dirty_fp()
        rp: int32 = sys_spawn("/bin/regprobe", &child_argv[0])
        hackos_test_dirty_fp()
        if rp <= 0:
            return 98
        return cast[int32](sys_waitpid(rp)) + 16
    if seq(cmd, "fpspin") != 0:
        # keep the FP registers dirty across many context switches
        fs: uint64 = 0
        while fs < 300:
            hackos_test_dirty_fp()
            sys_yield()
            fs = fs + 1
        return 0
    if seq(cmd, "badsp") != 0:
        # a system call with the stack pointer aimed at kernel memory
        asm_volatile("movw r0, #0x1000\n movt r0, #0x2000\n mov sp, r0\n movs r0, #4\n svc #0")
        return 9
    if seq(cmd, "lowsp") != 0:
        # run with the stack pointer 40 bytes above the bottom of this
        # process's memory (its 8 KB stack is the bottom of its block, and
        # the block is aligned to more than that) and never enter the
        # kernel: the next context switch has no room below it for the
        # registers, and must not write them into what lies below
        asm_volatile("mov r0, sp\n bic r0, r0, #0x1F00\n bic r0, r0, #0xFF\n adds r0, #40\n mov sp, r0\n1: b 1b")
        return 9
    if seq(cmd, "bkpt") != 0:
        # the instruction a debugger would use; nobody is listening
        asm_volatile("bkpt 0xAB")
        return 9
    if seq(cmd, "loop") != 0:
        # never ends by itself and never enters the kernel
        spin: uint64 = 0
        while 1 == 1:
            spin = spin + 1
            counter = spin
    if seq(cmd, "block") != 0:
        # waits for ever in the kernel: a pipe with a writer that never writes
        bs: int32 = sys_pipechan()
        sys_fdbind(0, 5, 3, bs)
        sys_fdbind(0, 6, 2, bs)
        brfd: int32 = fdname_open(6)
        return cast[int32](sys_read(brfd, &iobuf[0], 16))
    if seq(cmd, "hold") != 0:
        return t_hold()
    if seq(cmd, "steal") != 0:
        return t_steal()
    if seq(cmd, "pipe") != 0:
        return t_pipe()
    if seq(cmd, "pipewriter") != 0:
        return t_pipewriter(parse_hex(arg))
    if seq(cmd, "pipexfer") != 0:
        return t_pipexfer(parse_hex(arg), 0)
    if seq(cmd, "pipebench") != 0:
        return t_pipexfer(parse_hex(arg), 1)        # no per-byte check, no message
    if seq(cmd, "vfpipe") != 0:
        return t_vfpipe()
    if seq(cmd, "redir") != 0:
        return t_redir(arg)
    if seq(cmd, "forkbench") != 0:
        # rfork + exec + wait, `arg` times
        nb: uint64 = parse_hex(arg)
        child_argv[0] = cast[uint64]("/bin/ptest")
        child_argv[1] = cast[uint64]("nop")
        child_argv[2] = 0
        while nb > 0:
            fp: int32 = sys_rfork(0x00D)
            if fp == 0:
                sys_execve_env("/bin/ptest", &child_argv[0], cast[Ptr[uint64]](0))
                sys_exit(127)
            if sys_waitpid(fp) != 0:
                return 1
            nb = nb - 1
        return 0
    if seq(cmd, "where") != 0:
        # print where this instance's data is, then stay alive for a while
        puts("ptest: data at 0x")
        put_hex(cast[uint64](&counter))
        puts("\n")
        counter = parse_hex(arg)
        sys_sleep_ms(200)
        if counter == parse_hex(arg):
            return 77
        return 78
    if seq(cmd, "peek") != 0:
        # read memory this process may or may not own
        p: Ptr[volatile uint32] = cast[Ptr[volatile uint32]](parse_hex(arg))
        v: uint32 = p[0]
        return cast[int32](v & 0x7F)
    if seq(cmd, "poke") != 0:
        q: Ptr[volatile uint32] = cast[Ptr[volatile uint32]](parse_hex(arg))
        q[0] = 0xDEADBEEF
        return 0
    if seq(cmd, "sysptr") != 0:
        # hand the kernel an address that is not ours: it must refuse
        r: int64 = sys_write(1, cast[Ptr[uint8]](parse_hex(arg)), 4)
        if r == -14:
            return 14
        return 1
    if seq(cmd, "deep") != 0:
        return cast[int32](deep(1000000, &big[0]) & 0x7F)
    if seq(cmd, "huge") != 0:
        return cast[int32](huge_frame(100000, &big[0]) & 0x7F)
    if seq(cmd, "orphan") != 0:
        # start a child that outlives us
        child_argv[0] = cast[uint64]("/bin/ptest")
        child_argv[1] = cast[uint64]("sleep")
        child_argv[2] = 0
        if sys_spawn("/bin/ptest", &child_argv[0]) > 0:
            return 60
        return 1
    if seq(cmd, "sleep") != 0:
        sys_sleep_ms(50)
        return 61
    if seq(cmd, "cwd") != 0:
        buf: Array[64, uint8]
        sys_chdir("/tmp")
        sys_getcwd(&buf[0], 64)
        if seq(&buf[0], "/tmp") != 0:
            return 5
        return 1
    if seq(cmd, "thread") != 0:
        if hackos_syscall(512, 0, 0, 0, 4096, 0, 0) == -38:
            return 38
        return 1
    if seq(cmd, "spin") != 0:
        n: uint64 = 0
        while n < 4000:
            sys_yield()
            n = n + 1
        return 0
    return 201
