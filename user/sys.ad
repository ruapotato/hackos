# HackOS -- the user side of the system-call interface.
#
# Same names and signatures as the stubs in Hamnix's user/runtime.S for the
# calls both systems have, so Hamnix user code can be built against this
# module.  Everything here may run unprivileged: it touches no kernel data and
# only traps into the kernel.

extern def hackos_syscall(nr: uint64, a0: uint64, a1: uint64, a2: uint64, a3: uint64, a4: uint64, a5: uint64) -> int64


def sys_putc(c: uint32) -> int32:
    return cast[int32](hackos_syscall(0, cast[uint64](c), 0, 0, 0, 0, 0))


def sys_exit(code: uint64):
    hackos_syscall(1, code, 0, 0, 0, 0, 0)


def sys_get_jiffies() -> uint64:
    return cast[uint64](hackos_syscall(2, 0, 0, 0, 0, 0, 0))


def sys_getpid() -> int32:
    return cast[int32](hackos_syscall(4, 0, 0, 0, 0, 0, 0))


def sys_open(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(5, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_read(fd: int32, buf: Ptr[uint8], count: uint64) -> int64:
    return hackos_syscall(6, cast[uint64](fd), cast[uint64](buf), count, 0, 0, 0)


def sys_close(fd: int32) -> int32:
    return cast[int32](hackos_syscall(7, cast[uint64](fd), 0, 0, 0, 0, 0))


def sys_write(fd: int32, buf: Ptr[uint8], count: uint64) -> int64:
    return hackos_syscall(8, cast[uint64](fd), cast[uint64](buf), count, 0, 0, 0)


def sys_lseek(fd: int32, off: int64, whence: int32) -> int64:
    return hackos_syscall(9, cast[uint64](fd), cast[uint64](off), cast[uint64](whence), 0, 0, 0)


def sys_open_write(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(13, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_dup(fd: int32) -> int32:
    return cast[int32](hackos_syscall(16, cast[uint64](fd), 0, 0, 0, 0, 0))


def sys_dup2(oldfd: int32, newfd: int32) -> int32:
    return cast[int32](hackos_syscall(17, cast[uint64](oldfd), cast[uint64](newfd), 0, 0, 0, 0))


def sys_chdir(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(19, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_getcwd(buf: Ptr[uint8], count: uint64) -> int64:
    return hackos_syscall(20, cast[uint64](buf), count, 0, 0, 0, 0)


def sys_unlink(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(21, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_mkdir(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(22, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_read_nb(fd: int32, buf: Ptr[uint8], count: uint64) -> int64:
    return hackos_syscall(23, cast[uint64](fd), cast[uint64](buf), count, 0, 0, 0)


def sys_yield() -> int32:
    return cast[int32](hackos_syscall(24, 0, 0, 0, 0, 0, 0))


def sys_create(path: Ptr[uint8], flags: uint32, mode: uint32) -> int32:
    return cast[int32](hackos_syscall(260, cast[uint64](path), cast[uint64](flags), cast[uint64](mode), 0, 0, 0))


def sys_stat_p9(path: Ptr[uint8], buf: Ptr[uint8], nbuf: uint64) -> int64:
    return hackos_syscall(261, cast[uint64](path), cast[uint64](buf), nbuf, 0, 0, 0)


def sys_fstat_p9(fd: int32, buf: Ptr[uint8], nbuf: uint64) -> int64:
    return hackos_syscall(262, cast[uint64](fd), cast[uint64](buf), nbuf, 0, 0, 0)


def sys_remove(path: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(263, cast[uint64](path), 0, 0, 0, 0, 0))


def sys_errstr(buf: Ptr[uint8], nbuf: uint64) -> int32:
    return cast[int32](hackos_syscall(265, cast[uint64](buf), nbuf, 0, 0, 0, 0))


def sys_mmap(addr: uint64, length: uint64, prot: int32, flags: int32, fd: int32, off: int64) -> int64:
    return hackos_syscall(302, addr, length, cast[uint64](prot), cast[uint64](flags), cast[uint64](fd), cast[uint64](off))


def sys_munmap(addr: uint64, length: uint64) -> int64:
    return hackos_syscall(304, addr, length, 0, 0, 0, 0, 0)


# ---- HackOS only -------------------------------------------------------------
# Start `entry(arg)` as a new unprivileged thread; returns its id.
def sys_thread_spawn(entry: uint64, arg: uint64, prio: uint32, stack_size: uint64) -> int64:
    return hackos_syscall(512, entry, arg, cast[uint64](prio), stack_size, 0, 0)


def sys_thread_join(tid: uint32, code_out: Ptr[int64]) -> int32:
    return cast[int32](hackos_syscall(513, cast[uint64](tid), cast[uint64](code_out), 0, 0, 0, 0))


def sys_rename(oldpath: Ptr[uint8], newpath: Ptr[uint8]) -> int32:
    return cast[int32](hackos_syscall(514, cast[uint64](oldpath), cast[uint64](newpath), 0, 0, 0, 0))


def sys_gettid() -> int32:
    return cast[int32](hackos_syscall(515, 0, 0, 0, 0, 0, 0))


def sys_sleep_ms(ms: uint64) -> int32:
    return cast[int32](hackos_syscall(516, ms, 0, 0, 0, 0, 0))
