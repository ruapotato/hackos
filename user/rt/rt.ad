def sys_waitfds(fds: Ptr[int32], n: int32, timeout: int64) -> int32:
    return cast[int32](hmicro_syscall(313, 0, 0, 0, 0, 0, 0))


def sys_chan_dir_mode(fd: int32, mode: int32, path: Ptr[uint8]) -> int32:
    return cast[int32](hmicro_syscall(319, 0, 0, 0, 0, 0, 0))


def sys_listdir_records(path: Ptr[uint8], buf: Ptr[uint8], count: uint64) -> int64:
    return hmicro_syscall(318, 0, 0, 0, 0, 0, 0)


# ---- the heap ----------------------------------------------------------------
# A process cannot be given more memory after it has started (its block is
# what the MPU region covers), so its heap is a part of its own image:
# __heap_size bytes after .bss, chosen at link time (user/rt/prog.ld).
# sys_mmap(anonymous) and sys_munmap hand it out: first fit over a list of
# blocks, each with a 16-byte header {size, in use}, neighbours merged on
# free.  A program that never calls sys_mmap does not carry this code.
heap_ready: uint32 = 0


def _hsize(b: uint64) -> uint64:
    return cast[Ptr[uint64]](b)[0]


def _hused(b: uint64) -> uint64:
    return cast[Ptr[uint64]](b)[1]


def _hset(b: uint64, size: uint64, used: uint64):
    cast[Ptr[uint64]](b)[0] = size
    cast[Ptr[uint64]](b)[1] = used


# Anonymous memory only: fd must be -1.  Returns the address or -12.
def sys_mmap(addr: uint64, length: uint64, prot: int32, flags: int32, fd: int32, off: int64) -> int64:
    lo: uint64 = hmicro_heap_lo()
    hi: uint64 = hmicro_heap_hi()
    if fd != -1 or length == 0 or hi - lo < 32:
        return -12
    if heap_ready == 0:
        _hset(lo, hi - lo, 0)
        heap_ready = 1
    need: uint64 = ((length + 15) & 0xFFFFFFFFFFFFFFF0) + 16
    b: uint64 = lo
    while b < hi:
        size: uint64 = _hsize(b)
        if size < 16 or b + size > hi:
            return -12                                  # the list is damaged
        if _hused(b) == 0:
            # merge the free blocks that follow
            while b + size < hi and _hused(b + size) == 0:
                size = size + _hsize(b + size)
            _hset(b, size, 0)
            if size >= need:
                if size - need >= 32:
                    _hset(b + need, size - need, 0)
                    size = need
                _hset(b, size, 1)
                rt_memset(b + 16, 0, size - 16)
                return cast[int64](b + 16)
        b = b + size
    return -12


def sys_munmap(addr: uint64, length: uint64) -> int64:
    lo: uint64 = hmicro_heap_lo()
    hi: uint64 = hmicro_heap_hi()
    if addr < lo + 16 or addr >= hi or (addr & 15) != 0 or _hused(addr - 16) != 1:
        return -22
    _hset(addr - 16, _hsize(addr - 16), 0)
    return 0


# suspend(ms, sources): stop the system until a wake source fires (1 = a byte
# at the console, 2 = after `ms` milliseconds); returns the source that did,
# or -22.  Hamnix Micro only (docs/syscalls.md, 520).
def sys_suspend(ms: uint64, sources: uint32) -> int32:
    return cast[int32](hmicro_syscall(520, ms, cast[uint64](sources), 0, 0, 0, 0))
