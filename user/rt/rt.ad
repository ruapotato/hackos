def sys_nslabel(op: int32, label: Ptr[uint8], to_path: Ptr[uint8], from_path: Ptr[uint8]) -> int32:
    return cast[int32](hmicro_syscall(285, 0, 0, 0, 0, 0, 0))


def sys_srv_open(name: Ptr[uint8]) -> int32:
    return cast[int32](hmicro_syscall(276, 0, 0, 0, 0, 0, 0))


def sys_setuid_auth(authfd: int32) -> int32:
    return cast[int32](hmicro_syscall(300, 0, 0, 0, 0, 0, 0))


def sys_pgrp_kill(pgid: uint32, sig: int32) -> int32:
