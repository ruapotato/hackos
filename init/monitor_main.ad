# Hamnix Micro -- the kernel monitor image: kernel plus the monitor on the console
# (build/monitor.elf).  The system image with the shell is init/main.ad.

from kernel.init import kernel_init
from kernel.sched.core import thread_create, sched_start
from kernel.print import kputs
from drivers.tty.console import console_rx_enable
from init.monitor import monitor_main


def main() -> int32:
    kputs("\nHamnix Micro 0.2 (milestone 2) -- kernel core on ARM Cortex-M7, QEMU mps2-an500\n")
    kernel_init()
    console_rx_enable()
    thread_create("monitor", cast[uint64](&monitor_main), 0, 2, 16384, 0)
    sched_start()
    return 0
