HackOS feather-nrf52840 size patch to lib/regex.ad (the committed file plus the teensy41 patch's changes, which it repeats).
Applied by scripts/mkroot.sh in build/feather-nrf52840/root only; the
committed file is unchanged.

Reason: the nRF52840 has 256 KiB of RAM for everything: kernel data, kernel
stacks and heap, the files in / and every running program's stack and data
(boards/feather_nrf52840/link.ld; programs' code stays in flash).

    compiled nodes            2048 -> 64 (seven parallel arrays; a longer
                              pattern is refused with grep's error)
    bracket classes           128 -> 4 (rows of 256 bytes)
    continuation stack        4096 -> 256 entries (4 per node)
    greedy-repeat ends        2048 -> 64 per depth (a repeat that would
                              match more than 63 times stops there)
grep's tables: 150 -> 5 KiB, so grep with its 8 KiB stack (the matcher
recurses) is a 16 KiB block.

Only constants, array lengths, and messages that quote them change.
Generated by editing a copy and
    diff -u --label a/lib/regex.ad --label b/lib/regex.ad lib/regex.ad <copy>

--- a/lib/regex.ad
+++ b/lib/regex.ad
@@ -52,22 +52,22 @@
 NT_REPEAT: int32 = 7
 NT_EMPTY:  int32 = 8
 
-RX_MAX_NODES:      int32 = 2048
-RX_MAX_CLASS_ROWS: int32 = 128
+RX_MAX_NODES:      int32 = 64
+RX_MAX_CLASS_ROWS: int32 = 4
 
 # ---- compiled program (node arena) -------------------------------
-rx_ntype:   Array[2048, int32]
-rx_nch:     Array[2048, uint8]
-rx_ncls_of: Array[2048, int32]
-rx_nmin:    Array[2048, int32]
-rx_nmax:    Array[2048, int32]
-rx_na:      Array[2048, int32]
-rx_nb:      Array[2048, int32]
+rx_ntype:   Array[64, int32]
+rx_nch:     Array[64, uint8]
+rx_ncls_of: Array[64, int32]
+rx_nmin:    Array[64, int32]
+rx_nmax:    Array[64, int32]
+rx_na:      Array[64, int32]
+rx_nb:      Array[64, int32]
 rx_nn:      int32 = 0
 rx_root:    int32 = 0
 
 # bracket-class rows: RX_MAX_CLASS_ROWS * 256 booleans (0/1)
-rx_cls:      Array[32768, uint8]
+rx_cls:      Array[1024, uint8]
 rx_nclsrows: int32 = 0
 
 # ---- parser state ------------------------------------------------
@@ -84,14 +84,14 @@
 rx_tlen: uint64 = 0
 
 # continuation stack: node indices still to match after the current one
-rx_contstk: Array[4096, int32]
+rx_contstk: Array[256, int32]
 contdepth:  int32 = 0
 cont_base:  int32 = 0
 
 # per-repeat-depth end-position stacks for greedy backtracking
 RX_MAXREPDEPTH: int32 = 4
-RX_REP_ENDS:    int32 = 32768
-rx_ends:    Array[131072, int32]   # RX_MAXREPDEPTH * RX_REP_ENDS
+RX_REP_ENDS:    int32 = 64
+rx_ends:    Array[256, int32]   # RX_MAXREPDEPTH * RX_REP_ENDS
 rx_repdepth: int32 = 0
 
 # ---- results (leftmost match span, byte offsets into rx_text) ----
